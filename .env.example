# ==========================================
# MED.UZ.UA — ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# 1. SERPAPI (Пошук та завантаження фото товарів)
SERPAPI_API_KEY=<secret_serpapi_key>

# 2. LIQPAY INTEGRATION (Оплата через банк)
LIQPAY_PUBLIC_KEY=<secret_liqpay_public_key>
LIQPAY_PRIVATE_KEY=<secret_liqpay_private_key>
LIQPAY_SANDBOX=1 # Вкажіть "0" для живих платежів, "1" для тестового режиму

# 3. NOVA POSHTA INTEGRATION (Вибір міст та відділень)
NOVA_POSHTA_API_KEY=<secret_nova_poshta_api_key>

# 4. LEAD & APPOINTMENT API (Запис на прийом та повідомлення)
LEAD_API_URL=<your_lead_crm_or_webhook_url>
LEAD_API_TOKEN=<secret_lead_api_token>

# 5. TELEGRAM NOTIFICATIONS (Сповіщення про нові замовлення/записи)
TELEGRAM_BOT_TOKEN=<secret_telegram_bot_token>
TELEGRAM_CHAT_ID=<secret_telegram_chat_id>

# 6. GOOGLE ANALYTICS & ADS (Аналітика та конверсії)
PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXX

# 7. TRUSTINDEX / GOOGLE REVIEWS (Віджет відгуків)
PUBLIC_TRUSTINDEX_WIDGET_ID=<secret_trustindex_widget_id>
PUBLIC_GOOGLE_PLACE_ID=<secret_google_maps_place_id>

# 8. SITE ORIGIN & ENVIRONMENT
PUBLIC_SITE_URL=https://med.uz.ua
ENVIRONMENT=development # "development" або "production"