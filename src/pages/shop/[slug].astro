---
import type { GetStaticPaths } from "astro";
import ProductDetailPage from "../../components/pages/ProductDetailPage.astro";
import { getAllActiveProducts, type ProductSummary } from "../../lib/cms";
import { defaultLocale } from "../../lib/i18n";

export const prerender = true;

export const getStaticPaths = (async () => {
  const products = await getAllActiveProducts();

  return products.map((product) => {
    const related = products.filter(
      (p) => p.category === product.category && p.id !== product.id
    );
    return {
      params: { slug: product.id },
      props: { product, relatedProducts: related },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  product: ProductSummary;
  relatedProducts: readonly ProductSummary[];
}

const { product, relatedProducts } = Astro.props;
---

<ProductDetailPage
  locale={defaultLocale}
  product={product}
  relatedProducts={relatedProducts}
/>
