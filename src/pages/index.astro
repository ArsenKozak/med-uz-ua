---
import AppointmentForm from "../components/clinic/AppointmentForm.astro";
import GoogleMap from "../components/clinic/GoogleMap.astro";
import Container from "../components/ui/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
  title="Med.uz.ua — офтальмологічна клініка в Ужгороді"
  description="Запишіться на консультацію до офтальмологічної клініки Med.uz.ua."
>
  <main>
    <section class="bg-surface-muted py-16 sm:py-24">
      <Container class="grid items-start gap-10 lg:grid-cols-2">
        <div class="pt-4">
          <p class="font-semibold uppercase tracking-wide text-primary">
            Med.uz.ua 2.0
          </p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
            Турбота про ваш зір починається тут
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-8 text-text-muted">
            Залиште контактні дані, і команда клініки звʼяжеться з вами для
            узгодження часу прийому.
          </p>
        </div>

        <AppointmentForm />
      </Container>
    </section>

    <section class="py-16 sm:py-24" aria-labelledby="location-heading">
      <Container>
        <h2 id="location-heading" class="text-3xl font-bold tracking-tight">
          Як нас знайти
        </h2>
        <p class="mb-8 mt-3 text-text-muted">
          Карта завантажується лише тоді, коли наближається до області перегляду.
        </p>
        <GoogleMap />
      </Container>
    </section>
  </main>
</BaseLayout>
