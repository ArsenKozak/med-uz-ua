---
import type { GetStaticPaths } from "astro";
import ProductDetailPage from "../../../components/pages/ProductDetailPage.astro";
import { getAllActiveProducts, type ProductSummary } from "../../../lib/cms";
import { localizedLocales, type Locale } from "../../../lib/i18n";

export const prerender = true;

export const getStaticPaths = (async () => {
  const products = await getAllActiveProducts();

  return localizedLocales.flatMap((locale) =>
    products.map((product) => {
      const related = products.filter(
        (p) => p.category === product.category && p.id !== product.id
      );
      return {
        params: { locale, slug: product.id },
        props: { locale, product, relatedProducts: related },
      };
    })
  );
}) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
  product: ProductSummary;
  relatedProducts: readonly ProductSummary[];
}

const { locale, product, relatedProducts } = Astro.props;
---

<ProductDetailPage
  locale={locale}
  product={product}
  relatedProducts={relatedProducts}
/>
