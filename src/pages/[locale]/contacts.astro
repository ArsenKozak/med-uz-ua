---
import type { GetStaticPaths } from "astro";
import ContactsPage from "../../components/pages/ContactsPage.astro";
import {
  localizedLocales,
  type Locale,
} from "../../lib/i18n";

export const prerender = true;

export const getStaticPaths = (() =>
  localizedLocales.map((locale) => ({
    params: { locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ContactsPage locale={locale} />
