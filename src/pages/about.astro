---
import Container from "../components/ui/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  BOOKING_HREF,
  PENDING_CLINIC_CONFIRMATION,
  chiefPhysician,
} from "../lib/clinic";

export const prerender = true;

const documentSlots = [
  {
    label: "Medical certificates",
    description:
      "A dedicated space for clinic-approved certificate records and supporting assets.",
  },
  {
    label: "Professional documents",
    description:
      "A structured record for professional documents after verification by the clinic.",
  },
  {
    label: "MOH license information",
    description:
      "License information will be published here only after the clinic supplies confirmed details.",
  },
];
---

<BaseLayout
  title="About Med.uz.ua | Clinic & Chief Physician"
  description="Learn about the clinical philosophy of Med.uz.ua and the supplied profile of Chief Physician Dr. Myroslava Yunivna Leno."
>
  <article>
    <header class="border-b border-primary-foreground/15 bg-primary text-primary-foreground">
      <Container class="grid gap-12 py-16 sm:py-20 lg:grid-cols-12 lg:gap-16 lg:py-28">
        <div class="lg:col-span-8">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">
            About the clinic
          </p>
          <h1 class="mt-6 max-w-[12ch] text-balance text-[clamp(3rem,7vw,6.5rem)] font-medium leading-[0.94] tracking-[-0.04em]">
            A considered approach to vision care.
          </h1>
        </div>

        <div class="border-t border-primary-foreground/20 pt-7 lg:col-span-4 lg:mt-auto">
          <p class="max-w-lg font-serif text-2xl leading-snug text-primary-foreground/90 sm:text-3xl">
            Clinical work guided by clarity, precision, and a respectful patient experience.
          </p>
          <p class="mt-6 max-w-lg text-sm font-light leading-7 text-primary-foreground/70 sm:text-base">
            Med.uz.ua frames its clinical philosophy around European standards,
            modern equipment, precise diagnostics, and an efficient patient
            experience.
          </p>
        </div>
      </Container>
    </header>

    <section
      class="border-b border-border bg-background py-20 sm:py-24 lg:py-32"
      aria-labelledby="chief-physician-heading"
    >
      <Container class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
            Chief physician
          </p>
          <p class="mt-5 max-w-sm text-sm leading-7 text-muted-foreground sm:text-base">
            A concise profile containing only the information supplied and
            confirmed for this stage.
          </p>
        </div>

        <div class="lg:col-span-8">
          <div class="border-y border-border py-8 sm:py-10">
            <h2
              id="chief-physician-heading"
              class="max-w-3xl text-balance text-4xl font-medium leading-tight tracking-tight sm:text-5xl lg:text-6xl"
            >
              {chiefPhysician.name}
            </h2>

            <dl class="mt-10 grid gap-px border border-border bg-border sm:grid-cols-2">
              <div class="bg-card p-6 sm:p-8">
                <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
                  Role
                </dt>
                <dd class="mt-4 font-serif text-2xl text-card-foreground">
                  {chiefPhysician.role}
                </dd>
              </div>
              <div class="bg-card p-6 sm:p-8">
                <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
                  Experience
                </dt>
                <dd class="mt-4 font-serif text-2xl text-card-foreground">
                  {chiefPhysician.experience}
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </Container>
    </section>

    <section
      class="bg-muted py-20 sm:py-24 lg:py-32"
      aria-labelledby="philosophy-heading"
    >
      <Container>
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
              Clinical philosophy
            </p>
            <h2
              id="philosophy-heading"
              class="mt-5 max-w-md text-balance text-4xl font-medium leading-tight tracking-tight sm:text-5xl"
            >
              Four themes, expressed with restraint.
            </h2>
          </div>

          <ol class="border-t border-border lg:col-span-8">
            <li class="grid gap-5 border-b border-border py-7 sm:grid-cols-[3rem_1fr] sm:py-9">
              <span class="text-xs font-semibold tabular-nums tracking-[0.18em] text-primary/60">01</span>
              <div>
                <h3 class="text-2xl font-medium">European standards</h3>
                <p class="mt-3 max-w-2xl text-sm leading-7 text-muted-foreground sm:text-base">
                  A stated reference point for the clinic’s approach, without
                  implying unconfirmed accreditations or credentials.
                </p>
              </div>
            </li>
            <li class="grid gap-5 border-b border-border py-7 sm:grid-cols-[3rem_1fr] sm:py-9">
              <span class="text-xs font-semibold tabular-nums tracking-[0.18em] text-primary/60">02</span>
              <div>
                <h3 class="text-2xl font-medium">Modern equipment</h3>
                <p class="mt-3 max-w-2xl text-sm leading-7 text-muted-foreground sm:text-base">
                  Part of the supplied clinical philosophy. Specific equipment
                  models and technical details remain unlisted until confirmed.
                </p>
              </div>
            </li>
            <li class="grid gap-5 border-b border-border py-7 sm:grid-cols-[3rem_1fr] sm:py-9">
              <span class="text-xs font-semibold tabular-nums tracking-[0.18em] text-primary/60">03</span>
              <div>
                <h3 class="text-2xl font-medium">Precise diagnostics</h3>
                <p class="mt-3 max-w-2xl text-sm leading-7 text-muted-foreground sm:text-base">
                  A clear clinical focus, presented without unsupported claims
                  about methods, accuracy, or outcomes.
                </p>
              </div>
            </li>
            <li class="grid gap-5 border-b border-border py-7 sm:grid-cols-[3rem_1fr] sm:py-9">
              <span class="text-xs font-semibold tabular-nums tracking-[0.18em] text-primary/60">04</span>
              <div>
                <h3 class="text-2xl font-medium">Efficient patient experience</h3>
                <p class="mt-3 max-w-2xl text-sm leading-7 text-muted-foreground sm:text-base">
                  An emphasis on a considered experience, without promises about
                  timing, availability, or waiting periods.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </Container>
    </section>

    <section
      class="bg-background py-20 sm:py-24 lg:py-32"
      aria-labelledby="credentials-heading"
    >
      <Container>
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
            Documents & credentials
          </p>
          <h2
            id="credentials-heading"
            class="mt-5 text-balance text-4xl font-medium leading-tight tracking-tight sm:text-5xl"
          >
            A verified record, ready for clinic-approved materials.
          </h2>
          <p class="mt-6 max-w-2xl text-base leading-7 text-muted-foreground">
            No document imagery, certificate identifiers, or license numbers
            are displayed until the clinic supplies confirmed source material.
          </p>
        </div>

        <ul class="mt-12 grid gap-px border border-border bg-border lg:mt-16 lg:grid-cols-3">
          {
            documentSlots.map((slot, index) => (
              <li class="flex min-h-72 flex-col bg-card p-7 sm:p-9">
                <span class="text-xs font-semibold tabular-nums tracking-[0.18em] text-primary/60">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3 class="mt-10 text-2xl font-medium text-card-foreground">
                  {slot.label}
                </h3>
                <p class="mt-4 text-sm leading-7 text-muted-foreground">
                  {slot.description}
                </p>
                <p class="mt-auto border-t border-border pt-6 text-xs font-semibold uppercase tracking-[0.14em] text-primary">
                  {PENDING_CLINIC_CONFIRMATION}
                </p>
              </li>
            ))
          }
        </ul>
      </Container>
    </section>

    <aside class="border-t border-primary-foreground/15 bg-primary text-primary-foreground" aria-label="Clinic contact actions">
      <Container class="grid gap-8 py-14 sm:py-16 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">
            Begin your visit
          </p>
          <h2 class="mt-4 text-3xl font-medium sm:text-4xl">
            Request a private consultation.
          </h2>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
          <a
            class="inline-flex min-h-13 items-center justify-center rounded-lg bg-accent px-6 text-sm font-semibold text-primary transition-colors hover:bg-accent/90"
            href={BOOKING_HREF}
          >
            Book a consultation
          </a>
          <a
            class="inline-flex min-h-13 items-center justify-center rounded-lg border border-primary-foreground/35 px-6 text-sm font-semibold text-primary-foreground transition-colors hover:border-primary-foreground"
            href="/contacts"
          >
            Contact the clinic
          </a>
        </div>
      </Container>
    </aside>
  </article>
</BaseLayout>
