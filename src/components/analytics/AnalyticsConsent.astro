---
import type { Locale } from "../../lib/i18n";

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const rawContainerId = import.meta.env.PUBLIC_GTM_CONTAINER_ID;
const containerId = /^GTM-[A-Z0-9]+$/.test(rawContainerId ?? "")
  ? rawContainerId
  : "";

const copy = {
  uk: {
    title: "Конфіденційність та файли cookie",
    body: "Ми використовуємо файли cookie та аналітичні сервіси для покращення роботи сайту. Ми суворо поважаємо вашу приватність і ніколи не передаємо медичні відомості або персональні дані в аналітику.",
    choices: "Оберіть категорії збору даних:",
    analytics: "Аналітика та якість сервісу",
    analyticsDescription:
      "Допомагає нам анонімно оцінювати взаємодію з сайтом для покращення його зручності.",
    advertising: "Маркетинг та реклама",
    advertisingDescription:
      "Дозволяє вимірювати ефективність інформаційних повідомлень за стандартами Google.",
    acceptAll: "Прийняти всі",
    save: "Зберегти вибір",
    reject: "Тільки обов’язкові",
    saved: "Налаштування збережено.",
  },
  en: {
    title: "Privacy & Cookie Preferences",
    body: "We use cookies and analytics tools to enhance your browsing experience. We strictly respect your privacy and never transmit medical details or personal identifiers to analytics services.",
    choices: "Select your data preferences:",
    analytics: "Analytics & Performance",
    analyticsDescription:
      "Helps us anonymously understand site usage to continually improve our digital services.",
    advertising: "Marketing & Measurement",
    advertisingDescription:
      "Enables measured insights and relevant information delivery via Google services.",
    acceptAll: "Accept all",
    save: "Save selection",
    reject: "Necessary only",
    saved: "Privacy settings saved.",
  },
  sk: {
    title: "Ochrana súkromia a cookies",
    body: "Používame cookies a analytické nástroje pre lepšie fungovanie webu. Rešpektujeme vaše súkromie a do analytiky nikdy neposielame žiadne zdravotné ani osobné údaje.",
    choices: "Vyberte voliteľné kategórie:",
    analytics: "Analytika a výkon",
    analyticsDescription:
      "Pomáha nám anonymne porozumieť interakciám na webe a zlepšovať naše služby.",
    advertising: "Marketing a reklama",
    advertisingDescription:
      "Umožňuje meranie efektivity oznámení podľa nastavení Google.",
    acceptAll: "Povoliť všetko",
    save: "Uložiť výber",
    reject: "Len nevyhnutné",
    saved: "Nastavenia boli uložené.",
  },
  hu: {
    title: "Adatvédelem és sütik",
    body: "Sütiket és analitikai eszközöket használunk a webhely működésének fejlesztésére. Szigorúan tiszteletben tartjuk az Ön magánéletét, és nem továbbítunk egészségügyi adatokat az analitikának.",
    choices: "Válassza ki az opcionális kategóriákat:",
    analytics: "Analitika és teljesítmény",
    analyticsDescription:
      "Segít megérteni a webhely név nélküli használatát a felhasználói élmény javítása érdekében.",
    advertising: "Marketing és hirdetés",
    advertisingDescription:
      "Lehetővé teszi a mérést és a releváns tájékoztatást a Google beállításai szerint.",
    acceptAll: "Összes engedélyezése",
    save: "Kiválasztás mentése",
    reject: "Csak szükséges",
    saved: "A beállítások mentve.",
  },
} as const;

const localized = copy[locale];
---

<analytics-consent
  data-container-id={containerId}
  data-loader-enabled={containerId.length > 0 ? "true" : "false"}
>
  <aside
    class="fixed inset-x-3 bottom-[calc(5.5rem+env(safe-area-inset-bottom))] z-40 mx-auto max-w-2xl rounded-2xl md:rounded-3xl border border-border/80 bg-card/95 p-6 text-card-foreground shadow-2xl shadow-black/15 backdrop-blur-md md:bottom-6 md:p-8 transition-all duration-300"
    aria-labelledby="analytics-consent-title"
    aria-describedby="analytics-consent-description"
    data-consent-dialog
    data-consent-panel
    hidden
  >
    <div class="flex items-start gap-3.5">
      <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
      </div>
      <div>
        <h2 id="analytics-consent-title" class="font-serif text-xl font-medium tracking-tight text-foreground sm:text-2xl">
          {localized.title}
        </h2>
        <p
          id="analytics-consent-description"
          class="mt-2 text-sm leading-relaxed text-muted-foreground"
        >
          {localized.body}
        </p>
      </div>
    </div>

    <fieldset class="mt-6 space-y-3">
      <legend class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
        {localized.choices}
      </legend>

      <label
        class="group flex min-h-12 cursor-pointer items-start gap-3.5 rounded-xl border border-border/70 bg-background/50 p-4 transition-all duration-200 hover:border-primary/40 hover:bg-background"
      >
        <input
          class="mt-0.5 size-4.5 shrink-0 rounded border-border text-primary accent-primary transition-all focus:ring-2 focus:ring-primary/20"
          type="checkbox"
          data-consent-analytics
        />
        <span class="min-w-0">
          <span class="block text-sm font-semibold text-foreground group-hover:text-primary transition-colors">
            {localized.analytics}
          </span>
          <span class="mt-0.5 block text-xs leading-relaxed text-muted-foreground">
            {localized.analyticsDescription}
          </span>
        </span>
      </label>

      <label
        class="group flex min-h-12 cursor-pointer items-start gap-3.5 rounded-xl border border-border/70 bg-background/50 p-4 transition-all duration-200 hover:border-primary/40 hover:bg-background"
      >
        <input
          class="mt-0.5 size-4.5 shrink-0 rounded border-border text-primary accent-primary transition-all focus:ring-2 focus:ring-primary/20"
          type="checkbox"
          data-consent-advertising
        />
        <span class="min-w-0">
          <span class="block text-sm font-semibold text-foreground group-hover:text-primary transition-colors">
            {localized.advertising}
          </span>
          <span class="mt-0.5 block text-xs leading-relaxed text-muted-foreground">
            {localized.advertisingDescription}
          </span>
        </span>
      </label>
    </fieldset>

    <div class="mt-6 grid grid-cols-1 gap-2.5 sm:grid-cols-3">
      <button
        class="inline-flex min-h-12 items-center justify-center rounded-xl border border-border bg-background/80 px-4 text-xs sm:text-sm font-semibold text-muted-foreground transition-all duration-200 hover:bg-muted hover:text-foreground active:scale-98"
        type="button"
        data-consent-decline
        data-consent-reject
      >
        {localized.reject}
      </button>

      <button
        class="inline-flex min-h-12 items-center justify-center rounded-xl border border-primary/30 bg-background px-4 text-xs sm:text-sm font-semibold text-primary transition-all duration-200 hover:bg-primary/5 hover:border-primary active:scale-98"
        type="button"
        data-consent-save
      >
        {localized.save}
      </button>

      <button
        class="inline-flex min-h-12 items-center justify-center rounded-xl bg-primary px-5 text-xs sm:text-sm font-semibold text-primary-foreground shadow-md shadow-primary/15 transition-all duration-200 hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/25 active:scale-98"
        type="button"
        data-consent-accept
        data-consent-accept-all
      >
        {localized.acceptAll}
      </button>
    </div>
  </aside>

  <p
    class="sr-only"
    aria-live="polite"
    data-consent-status
    data-saved-message={localized.saved}
  ></p>
</analytics-consent>

<script>
  import {
    ANALYTICS_CONSENT_STORAGE_KEY,
    clearSiteOwnedGoogleStorage,
    getConsentState,
    initializeGoogleConsentDefaults,
    setConsentPreferences,
    shouldLoadGoogleScripts,
    synchronizeConsentStateFromStorage,
    trackPhoneClick,
    updateGoogleConsent,
    type ConsentPreferences,
    type ConsentState,
    type PhonePlacement,
  } from "../../lib/analytics";

  function phonePlacement(link: HTMLAnchorElement): PhonePlacement {
    if (link.closest("[data-site-header]")) return "header";
    if (link.closest("[data-mobile-action-bar]")) return "mobile_action_bar";
    if (link.closest("footer")) return "footer";
    return "content";
  }

  class AnalyticsConsentElement extends HTMLElement {
    #panel: HTMLElement | null = null;
    #analyticsInput: HTMLInputElement | null = null;
    #advertisingInput: HTMLInputElement | null = null;
    #status: HTMLElement | null = null;
    #opener: HTMLButtonElement | null = null;
    #state: ConsentState | null = null;
    #containerId = "";
    #loaderEnabled = false;

    connectedCallback(): void {
      const panel = this.querySelector("[data-consent-panel]");
      const analyticsInput = this.querySelector("[data-consent-analytics]");
      const advertisingInput = this.querySelector(
        "[data-consent-advertising]",
      );
      const status = this.querySelector("[data-consent-status]");
      if (
        !(panel instanceof HTMLElement) ||
        !(analyticsInput instanceof HTMLInputElement) ||
        !(advertisingInput instanceof HTMLInputElement) ||
        !(status instanceof HTMLElement) ||
        this.dataset.bound === "true"
      ) {
        return;
      }

      this.dataset.bound = "true";
      this.#panel = panel;
      this.#analyticsInput = analyticsInput;
      this.#advertisingInput = advertisingInput;
      this.#status = status;
      this.#containerId = this.dataset.containerId ?? "";
      this.#loaderEnabled = this.dataset.loaderEnabled === "true";

      this.addEventListener("click", this.#handleClick);
      this.addEventListener("keydown", this.#handleKeydown);
      document.addEventListener("click", this.#handleDocumentClick);
      window.addEventListener("storage", this.#handleStorage);

      initializeGoogleConsentDefaults();
      this.#state = getConsentState();
      this.#syncControls();

      if (this.#state !== null) {
        updateGoogleConsent(this.#state);
        this.#loadGtmIfAllowed();
      }

      panel.hidden = this.#state !== null || !this.#loaderEnabled;
    }

    disconnectedCallback(): void {
      this.removeEventListener("click", this.#handleClick);
      this.removeEventListener("keydown", this.#handleKeydown);
      document.removeEventListener("click", this.#handleDocumentClick);
      window.removeEventListener("storage", this.#handleStorage);
      this.dataset.bound = "false";
    }

    #handleClick = (event: Event): void => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target.closest("[data-consent-accept-all]")) {
        this.#applyPreferences({ analytics: true, advertising: true });
        return;
      }

      if (target.closest("[data-consent-reject]")) {
        this.#applyPreferences({ analytics: false, advertising: false });
        return;
      }

      if (target.closest("[data-consent-save]")) {
        this.#applyPreferences({
          analytics: this.#analyticsInput?.checked === true,
          advertising: this.#advertisingInput?.checked === true,
        });
      }
    };

    #handleKeydown = (event: KeyboardEvent): void => {
      if (
        event.key === "Escape" &&
        this.#state !== null &&
        this.#panel?.hidden === false
      ) {
        event.preventDefault();
        this.#hidePanel();
      }
    };

    #handleDocumentClick = (event: MouseEvent): void => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const settingsButton = target.closest("[data-analytics-settings]");
      if (settingsButton instanceof HTMLButtonElement) {
        this.#opener = settingsButton;
        this.#openPanel();
        return;
      }

      const phoneLink = target.closest('a[href^="tel:"]');
      if (phoneLink instanceof HTMLAnchorElement) {
        trackPhoneClick(phonePlacement(phoneLink));
      }
    };

    #handleStorage = (event: StorageEvent): void => {
      if (
        event.key !== ANALYTICS_CONSENT_STORAGE_KEY &&
        event.key !== null
      ) {
        return;
      }

      const previous = this.#state;
      this.#state = synchronizeConsentStateFromStorage();
      updateGoogleConsent(this.#state);
      this.#clearRevokedStorage(previous, this.#state);
      this.#syncControls();
      this.#loadGtmIfAllowed();
      if (this.#panel) {
        this.#panel.hidden = this.#state !== null || !this.#loaderEnabled;
      }
    };

    #applyPreferences(preferences: ConsentPreferences): void {
      const previous = this.#state;
      const state = setConsentPreferences(preferences);
      this.#state = state;

      updateGoogleConsent(state);
      this.#clearRevokedStorage(previous, state);
      this.#syncControls();
      this.#loadGtmIfAllowed();
      if (this.#status) {
        this.#status.textContent = "";
        requestAnimationFrame(() => {
          if (this.#status) {
            this.#status.textContent = this.#status.dataset.savedMessage ?? "";
          }
        });
      }
      this.#hidePanel();
    }

    #clearRevokedStorage(
      previous: ConsentState | null,
      next: ConsentState | null,
    ): void {
      const analyticsRevoked =
        next?.analytics !== true && previous?.analytics !== false;
      const advertisingRevoked =
        next?.advertising !== true && previous?.advertising !== false;
      clearSiteOwnedGoogleStorage({
        analytics: analyticsRevoked,
        advertising: advertisingRevoked,
      });
    }

    #syncControls(): void {
      if (this.#analyticsInput) {
        this.#analyticsInput.checked = this.#state?.analytics === true;
      }
      if (this.#advertisingInput) {
        this.#advertisingInput.checked = this.#state?.advertising === true;
      }
    }

    #openPanel(): void {
      if (!this.#panel) return;
      this.#syncControls();
      this.#panel.hidden = false;
      this.#panel
        .querySelector<HTMLInputElement>("[data-consent-analytics]")
        ?.focus();
    }

    #hidePanel(): void {
      if (this.#panel) this.#panel.hidden = true;
      this.#opener?.focus();
      this.#opener = null;
    }

    #loadGtmIfAllowed(): void {
      if (
        !this.#loaderEnabled ||
        this.#containerId.length === 0 ||
        !shouldLoadGoogleScripts(this.#state) ||
        document.querySelector(
          'script[data-google-tag-manager-loader], script[src^="https://www.googletagmanager.com/gtm.js"]',
        ) !== null
      ) {
        return;
      }

      window.dataLayer ??= [];
      window.dataLayer.push({
        "gtm.start": Date.now(),
        event: "gtm.js",
      });
      const script = document.createElement("script");
      script.async = true;
      script.dataset.googleTagManagerLoader = "true";
      script.src = `https://www.googletagmanager.com/gtm.js?id=${encodeURIComponent(this.#containerId)}`;
      document.head.append(script);
    }
  }

  if (!customElements.get("analytics-consent")) {
    customElements.define("analytics-consent", AnalyticsConsentElement);
  }
</script>
