---
import GoogleMap from "../clinic/GoogleMap.astro";
import Wayfinding from "../clinic/Wayfinding.astro";
import ReviewsPanel from "../clinic/ReviewsPanel.astro";
import SocialLinks from "../clinic/SocialLinks.astro";
import Container from "../ui/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { clinicContact } from "../../lib/clinic";
import { t, type Locale } from "../../lib/i18n";
import { getAppointmentHref } from "../../lib/navigation";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const appointmentHref = getAppointmentHref(Astro.url.pathname, locale);
const mapOpenLabels = {
  uk: "Відкрити маршрут у Google Maps",
  en: "Open route in Google Maps",
  sk: "Otvoriť trasu v Mapách Google",
  hu: "Útvonal megnyitása a Google Térképen",
} as const;
const mapFrameTitles = {
  uk: "Мапа адреси European Ophthalmological Clinic в Ужгороді",
  en: "Map of the European Ophthalmological Clinic address in Uzhhorod",
  sk: "Mapa adresy European Ophthalmological Clinic v Užhorode",
  hu: "A European Ophthalmological Clinic ungvári címének térképe",
} as const;
---

<BaseLayout
  title={t(locale, "seo.contacts.title")}
  description={t(locale, "seo.contacts.description")}
  locale={locale}
>
  <!-- Темний фірмовий Hero-хедер із айворі акцентом -->
  <header class="border-b border-primary-foreground/15 bg-primary text-primary-foreground">
    <Container class="grid gap-10 py-16 sm:py-20 lg:grid-cols-12 lg:items-end lg:gap-16 lg:py-24">
      <div class="lg:col-span-7">
        <span class="inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/10 px-3.5 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-accent">
          <span class="size-1.5 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
          {t(locale, "contacts.heroEyebrow")}
        </span>
        <h1 class="mt-6 text-balance font-serif text-4xl font-medium leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
          {t(locale, "contacts.heroTitle")}
        </h1>
      </div>

      <div class="flex flex-col justify-end border-t border-primary-foreground/20 pt-7 lg:col-span-5 lg:border-t-0 lg:border-l lg:border-primary-foreground/15 lg:pl-10 lg:pt-0">
        <p class="font-serif text-xl leading-relaxed text-primary-foreground/90 sm:text-2xl">
          "{t(locale, "contacts.heroQuote")}"
        </p>
      </div>
    </Container>
  </header>

  <!-- Секція контактних даних -->
  <section
    class="bg-muted/40 py-16 sm:py-20 lg:py-28 border-b border-border"
    aria-labelledby="contact-details-heading"
  >
    <Container>
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <span class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
            {t(locale, "contacts.detailsEyebrow")}
          </span>
          <h2
            id="contact-details-heading"
            class="mt-4 max-w-md text-balance font-serif text-3xl font-medium tracking-tight sm:text-4xl"
          >
            {t(locale, "contacts.detailsTitle")}
          </h2>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:col-span-8">
          <!-- Картка адреси -->
          <div class="rounded-2xl border border-border/80 bg-card p-6 sm:p-7 shadow-xs">
            <span class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
              {t(locale, "contacts.addressLabel")}
            </span>
            <address class="mt-3 font-serif text-xl not-italic leading-snug text-foreground sm:text-2xl">
              <span class="block font-medium">{t(locale, "clinic.city")}</span>
              <span class="block text-primary">{t(locale, "clinic.street")}</span>
              <span class="block text-sm text-muted-foreground mt-1 font-sans">{t(locale, "clinic.floor")}</span>
            </address>
          </div>

          <!-- Картка телефону -->
          <div class="rounded-2xl border border-border/80 bg-card p-6 sm:p-7 shadow-xs">
            <span class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
              {t(locale, "contacts.telephoneLabel")}
            </span>
            <div class="mt-3">
              <a
                class="font-serif text-xl font-medium text-primary hover:underline sm:text-2xl block"
                href={clinicContact.phoneHref}
              >
                {clinicContact.phoneDisplay}
              </a>
              <span class="block text-xs font-medium text-emerald-600 mt-2">● Прямий зв’язок із клінікою</span>
            </div>
          </div>

          <!-- Картка графіка роботи -->
          <div class="rounded-2xl border border-border/80 bg-card p-6 sm:p-7 shadow-xs sm:col-span-2">
            <span class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
              {t(locale, "contacts.hoursLabel")}
            </span>
            <p class="mt-2 text-base font-semibold text-foreground sm:text-lg">
              Понеділок – Субота: <span class="font-normal text-muted-foreground">за попереднім записом пацієнтів</span>
            </p>
          </div>
        </div>
      </div>

      <!-- Кнопки швидких дій -->
      <div class="mt-10 flex flex-col gap-3.5 sm:flex-row lg:ml-[calc(33.333%+1.333rem)]">
        <a
          class="focus-ring-primary inline-flex min-h-13 items-center justify-center gap-2.5 rounded-xl bg-primary px-8 text-center text-sm font-semibold text-primary-foreground shadow-md shadow-primary/15 transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary/95 hover:shadow-lg active:translate-y-0"
          href={clinicContact.phoneHref}
        >
          <svg class="size-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.3 3.5 10.1 8 7.8 9.7a15 15 0 0 0 6.5 6.5l1.7-2.3 4.5 1.8v3.4a1.4 1.4 0 0 1-1.4 1.4A15.6 15.6 0 0 1 3.5 4.9a1.4 1.4 0 0 1 1.4-1.4h3.4Z"></path>
          </svg>
          <span>{t(locale, "contacts.call")}</span>
        </a>

        <a
          class="focus-ring-primary inline-flex min-h-13 items-center justify-center gap-2 rounded-xl bg-accent px-8 text-center text-sm font-semibold text-primary shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent/90 hover:shadow-lg active:translate-y-0"
          href={appointmentHref}
        >
          <span>{t(locale, "contacts.book")}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Соціальні мережі -->
      <div class="mt-12 border-t border-border pt-10 lg:ml-[calc(33.333%+1.333rem)]">
        <span class="block text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground mb-4">
          Офіційні сторінки в соціальних мережах:
        </span>
        <SocialLinks locale={locale} />
      </div>
    </Container>
  </section>

  <!-- Секція навігації від АТБ -->
  <section class="bg-background py-16 sm:py-20 lg:py-28" aria-labelledby="wayfinding-heading">
    <Container>
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <span class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
            {t(locale, "contacts.wayfindingEyebrow")}
          </span>
          <h2 id="wayfinding-heading" class="mt-4 max-w-3xl text-balance font-serif text-3xl font-medium tracking-tight sm:text-4xl lg:text-5xl">
            {t(locale, "contacts.wayfindingTitle")}
          </h2>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-muted-foreground lg:col-span-4 lg:justify-self-end">
          {t(locale, "contacts.wayfindingIntro")}
        </p>
      </div>

      <div class="mt-10 lg:mt-14">
        <Wayfinding locale={locale} />
      </div>
    </Container>
  </section>

  <!-- Карта Google Maps із преміальним фреймом -->
  <section class="border-t border-border bg-muted/30 py-16 sm:py-20 lg:py-28" aria-labelledby="map-heading">
    <Container class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
      <div class="lg:col-span-4">
        <span class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
          {t(locale, "contacts.mapEyebrow")}
        </span>
        <h2
          id="map-heading"
          class="mt-4 text-balance font-serif text-3xl font-medium tracking-tight sm:text-4xl"
        >
          {t(locale, "contacts.mapTitle")}
        </h2>
        <p class="mt-3.5 max-w-md text-sm leading-relaxed text-muted-foreground sm:text-base">
          {t(locale, "contacts.mapBody")}
        </p>
        
        <div class="mt-6 rounded-2xl border border-border/80 bg-card p-5 shadow-xs">
          <span class="text-xs font-semibold uppercase tracking-[0.14em] text-primary">Точна адреса:</span>
          <address class="mt-2 not-italic text-sm leading-relaxed text-foreground">
            <strong class="font-semibold block">{t(locale, "clinic.city")}</strong>
            <span class="block">{t(locale, "clinic.street")}</span>
            <span class="block text-muted-foreground">{t(locale, "clinic.floor")}</span>
          </address>
        </div>
      </div>

      <div class="lg:col-span-8">
        <GoogleMap
          title={mapFrameTitles[locale]}
          openLabel={mapOpenLabels[locale]}
        />
      </div>
    </Container>
  </section>

  <!-- Відгуки Trustindex -->
  <section class="border-t border-border bg-background py-16 sm:py-20 lg:py-24">
    <Container>
      <ReviewsPanel locale={locale} />
    </Container>
  </section>
</BaseLayout>
