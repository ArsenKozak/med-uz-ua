---
import GoogleMap from "../clinic/GoogleMap.astro";
import Wayfinding from "../clinic/Wayfinding.astro";
import Container from "../ui/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { clinicContact } from "../../lib/clinic";
import { localizePath, t, type Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout
  title={t(locale, "seo.contacts.title")}
  description={t(locale, "seo.contacts.description")}
  locale={locale}
>
  <header class="border-b border-border bg-background">
    <Container class="grid gap-10 py-16 sm:py-20 lg:grid-cols-12 lg:items-end lg:gap-16 lg:py-28">
      <div class="lg:col-span-8">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-primary">
          {t(locale, "contacts.heroEyebrow")}
        </p>
        <h1 class="mt-6 max-w-[11ch] text-balance text-[clamp(3rem,7vw,6.5rem)] font-medium leading-[0.94] tracking-[-0.04em]">
          {t(locale, "contacts.heroTitle")}
        </h1>
      </div>
      <div class="border-t border-border pt-7 lg:col-span-4">
        <p class="max-w-lg font-serif text-2xl leading-snug text-foreground sm:text-3xl">
          {t(locale, "contacts.heroQuote")}
        </p>
      </div>
    </Container>
  </header>

  <section
    class="bg-muted py-20 sm:py-24 lg:py-32"
    aria-labelledby="contact-details-heading"
  >
    <Container>
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
            {t(locale, "contacts.detailsEyebrow")}
          </p>
          <h2
            id="contact-details-heading"
            class="mt-5 max-w-md text-balance text-4xl font-medium leading-tight tracking-tight sm:text-5xl"
          >
            {t(locale, "contacts.detailsTitle")}
          </h2>
        </div>

        <dl class="border-t border-border lg:col-span-8">
          <div class="grid gap-4 border-b border-border py-7 sm:grid-cols-[10rem_1fr] sm:items-start sm:py-9">
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
              {t(locale, "contacts.addressLabel")}
            </dt>
            <dd>
              <address class="font-serif text-2xl not-italic leading-snug text-foreground sm:text-3xl">
                <span class="block">{t(locale, "clinic.city")}</span>
                <span class="block">{t(locale, "clinic.street")}</span>
                <span class="block">{t(locale, "clinic.floor")}</span>
              </address>
            </dd>
          </div>

          <div class="grid gap-4 border-b border-border py-7 sm:grid-cols-[10rem_1fr] sm:items-center sm:py-9">
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
              {t(locale, "contacts.telephoneLabel")}
            </dt>
            <dd>
              <a
                class="focus-ring-primary inline-flex min-h-14 max-w-full items-center border-b border-primary font-serif text-[clamp(1.55rem,5vw,2.25rem)] leading-tight text-primary transition-colors hover:border-accent hover:text-primary/80"
                href={clinicContact.phoneHref}
              >
                {clinicContact.phoneDisplay}
              </a>
            </dd>
          </div>

          <div class="grid gap-4 border-b border-border py-7 sm:grid-cols-[10rem_1fr] sm:items-start sm:py-9">
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
              {t(locale, "contacts.hoursLabel")}
            </dt>
            <dd class="text-base font-medium leading-7 text-foreground">
              {t(locale, "services.pending")}
            </dd>
          </div>
        </dl>
      </div>

      <div class="mt-12 flex flex-col gap-3 sm:flex-row lg:ml-[calc(33.333%+1.333rem)] lg:mt-14">
        <a
          class="focus-ring-primary inline-flex min-h-14 items-center justify-center rounded-lg bg-primary px-7 text-center text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
          href={clinicContact.phoneHref}
        >
          {t(locale, "contacts.call")}
        </a>
        <a
          class="focus-ring-primary inline-flex min-h-14 items-center justify-center rounded-lg border border-primary px-7 text-center text-sm font-semibold text-primary transition-colors hover:bg-primary hover:text-primary-foreground"
          href={localizePath("/#appointment-form", locale)}
        >
          {t(locale, "contacts.book")}
        </a>
      </div>
    </Container>
  </section>

  <section class="bg-background py-20 sm:py-24 lg:py-32" aria-labelledby="wayfinding-heading">
    <Container>
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
            {t(locale, "contacts.wayfindingEyebrow")}
          </p>
          <h2 id="wayfinding-heading" class="mt-5 max-w-3xl text-balance text-4xl font-medium leading-tight tracking-tight sm:text-5xl lg:text-6xl">
            {t(locale, "contacts.wayfindingTitle")}
          </h2>
        </div>
        <p class="max-w-md text-sm leading-7 text-muted-foreground lg:col-span-4 lg:justify-self-end">
          {t(locale, "contacts.wayfindingIntro")}
        </p>
      </div>

      <div class="mt-12 lg:mt-16">
        <Wayfinding locale={locale} />
      </div>
    </Container>
  </section>

  <section class="border-t border-border bg-muted py-20 sm:py-24 lg:py-32" aria-labelledby="map-heading">
    <Container class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
      <div class="lg:col-span-4">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
          {t(locale, "contacts.mapEyebrow")}
        </p>
        <h2
          id="map-heading"
          class="mt-5 text-balance text-4xl font-medium leading-tight tracking-tight sm:text-5xl"
        >
          {t(locale, "contacts.mapTitle")}
        </h2>
        <p class="mt-6 max-w-md text-sm leading-7 text-muted-foreground">
          {t(locale, "contacts.mapBody")}
        </p>
        <address class="mt-7 border-l-2 border-accent pl-5 text-sm not-italic leading-7 text-foreground">
          <span class="block">{t(locale, "clinic.city")}</span>
          <span class="block">{t(locale, "clinic.street")}</span>
          <span class="block">{t(locale, "clinic.floor")}</span>
        </address>
      </div>
      <div class="lg:col-span-8">
        <GoogleMap title={t(locale, "contacts.mapFrameTitle")} />
      </div>
    </Container>
  </section>
</BaseLayout>
