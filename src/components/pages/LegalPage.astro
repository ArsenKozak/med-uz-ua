---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { legalConfig } from "../../config/legal";
import {
  getLegalDocument,
  type LegalDocumentKind,
} from "../../data/legal";
import type { Locale } from "../../lib/i18n";
import Container from "../ui/Container.astro";

interface Props {
  readonly locale: Locale;
  readonly kind: LegalDocumentKind;
}

const { locale, kind } = Astro.props;
const document = getLegalDocument(locale, kind);
const localeTags: Readonly<Record<Locale, string>> = {
  uk: "uk-UA",
  en: "en-GB",
  sk: "sk-SK",
  hu: "hu-HU",
};
const formattedUpdatedAt = new Intl.DateTimeFormat(localeTags[locale], {
  dateStyle: "long",
  timeZone: "UTC",
}).format(new Date(`${document.lastUpdated}T00:00:00.000Z`));
const contactLabels = {
  uk: {
    seller: "Продавець",
    address: "Юридична та фактична адреса",
    contacts: "Контакти",
    sources: "Офіційні джерела",
  },
  en: {
    seller: "Seller",
    address: "Legal and operating address",
    contacts: "Contacts",
    sources: "Official sources",
  },
  sk: {
    seller: "Predávajúci",
    address: "Právna a prevádzková adresa",
    contacts: "Kontakty",
    sources: "Oficiálne zdroje",
  },
  hu: {
    seller: "Eladó",
    address: "Jogi és működési cím",
    contacts: "Kapcsolat",
    sources: "Hivatalos források",
  },
} as const;
const labels = contactLabels[locale];
---

<BaseLayout
  title={document.title}
  description={document.description}
  locale={locale}
  robots="noindex, nofollow"
>
  <article class="min-w-0 bg-background">
    <header class="border-b border-border bg-primary text-primary-foreground">
      <Container class="py-16 sm:py-20 lg:py-24">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">
          {document.eyebrow}
        </p>
        <h1 class="mt-5 max-w-4xl text-balance text-4xl font-medium leading-tight tracking-[-0.03em] sm:text-5xl lg:text-6xl">
          {document.title}
        </h1>
        <p class="mt-6 max-w-3xl text-base leading-8 text-primary-foreground/75">
          {document.description}
        </p>
        <p class="mt-4 text-sm text-primary-foreground/70">
          {document.lastUpdatedLabel}:{" "}
          <time datetime={document.lastUpdated}>{formattedUpdatedAt}</time>
        </p>
      </Container>
    </header>

    <Container class="py-14 sm:py-18 lg:py-24">

      <section
              class="grid min-w-0 gap-px border border-border bg-border sm:grid-cols-2 lg:grid-cols-3"
              aria-label={labels.seller}
      >
        <div class="min-w-0 bg-card p-5 sm:p-6">
          <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">
            {labels.seller}
          </h2>
          <p class="mt-3 break-words text-sm font-semibold leading-6 text-foreground">
            {legalConfig.legalName}
          </p>
          <p class="mt-1 text-sm leading-6 text-muted-foreground">
            {legalConfig.taxIdLabel}: {legalConfig.taxId}
          </p>
        </div>
        <div class="min-w-0 bg-card p-5 sm:p-6">
          <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">
            {labels.address}
          </h2>
          <p class="mt-3 break-words text-sm leading-6 text-foreground">
            {legalConfig.legalAddress}
          </p>
        </div>
        <div class="min-w-0 bg-card p-5 sm:col-span-2 sm:p-6 lg:col-span-1">
          <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">
            {labels.contacts}
          </h2>
          <p class="mt-3 flex flex-col items-start gap-2 text-sm leading-6">
            <a
              class="focus-ring-primary break-all font-semibold text-primary underline decoration-accent decoration-2 underline-offset-4"
              href={legalConfig.phoneHref}
            >
              {legalConfig.phoneDisplay}
            </a>
            <a
              class="focus-ring-primary break-all font-semibold text-primary underline decoration-accent decoration-2 underline-offset-4"
              href={`mailto:${legalConfig.email}`}
            >
              {legalConfig.email}
            </a>
          </p>
        </div>
      </section>

      <div class="mt-12 grid gap-0 border-t border-border lg:mt-16">
        {
          document.sections.map((section) => (
            <section class="grid min-w-0 gap-5 border-b border-border py-9 sm:py-11 lg:grid-cols-12 lg:gap-12">
              <h2 class="min-w-0 break-words text-2xl font-medium leading-snug text-primary lg:col-span-4">
                {section.title}
              </h2>
              <div class="min-w-0 space-y-4 text-sm leading-7 text-foreground/75 sm:text-base lg:col-span-8">
                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                {section.items ? (
                  <ul class="list-disc space-y-2 pl-5 marker:text-accent">
                    {section.items.map((item) => <li>{item}</li>)}
                  </ul>
                ) : null}
              </div>
            </section>
          ))
        }
      </div>

      <section class="mt-12 border border-border bg-card p-6 sm:p-8" aria-labelledby="legal-sources-heading">
        <h2 id="legal-sources-heading" class="text-xl font-medium text-primary">
          {labels.sources}
        </h2>
        <ul class="mt-4 space-y-3">
          {
            document.sources.map((source) => (
              <li>
                <a
                  class="focus-ring-primary inline-flex min-h-11 items-center break-words text-sm font-semibold leading-6 text-primary underline decoration-accent decoration-2 underline-offset-4"
                  href={source.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {source.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </Container>
  </article>
</BaseLayout>
