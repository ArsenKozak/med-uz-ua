---
import Container from "../ui/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  MEDICAL_PRICE_ITEMS,
  MEDICAL_PRICE_LIST_META,
} from "../../data/medical-prices";
import { getSpecializations } from "../../data/specializations";
import { clinicImageAssets } from "../../lib/assets";
import { chiefPhysician, clinicContact } from "../../lib/clinic";
import { localizePath, t, type Locale } from "../../lib/i18n";
import { getAppointmentHref } from "../../lib/navigation";
import {
  createMedicalPriceGroups,
  formatMedicalPrice,
  formatMedicalPriceApprovalDate,
  getMedicalServiceDisplayName,
  getMedicalServiceDisplayNote,
  usesOfficialUkrainianNameFallback,
} from "../../lib/medical-prices";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const SHOW_SPECIAL_PROGRAMS = false;

const callAriaLabel = t(locale, "services.callAria").replace(
  "{phone}",
  clinicContact.phoneDisplay,
);
const medicalPriceGroups = createMedicalPriceGroups(MEDICAL_PRICE_ITEMS);
const approvedOnDisplay = formatMedicalPriceApprovalDate(locale);
const showTranslationFallback = usesOfficialUkrainianNameFallback(locale);
const appointmentHref = getAppointmentHref(Astro.url.pathname, locale);
const specializations = getSpecializations(locale);

const specializationCopy = {
  uk: {
    eyebrow: "Напрямки допомоги",
    title: "Клінічна увага та турбота про зір",
    intro:
      "Від первинного огляду немовлят і школярів до високої апаратної діагностики та підбору медичної оптики для всієї родини.",
  },
  en: {
    eyebrow: "Clinical Care",
    title: "Dedicated Attention at Every Stage",
    intro:
      "From pediatric vision screening to advanced hardware diagnostics and customized medical optical correction.",
  },
  sk: {
    eyebrow: "Oblasti starostlivosti",
    title: "Klinická pozornosť v každej fáze",
    intro:
      "Od preventívnych vyšetrení detí po pokročilú prístrojovú diagnostiku a výber zdravotníckej optiky.",
  },
  hu: {
    eyebrow: "Szakterületek",
    title: "Szakértő gondoskodás minden szakaszban",
    intro:
      "A gyermekek látásvizsgálatától a korszerű műszeres szemészeti diagnosztikáig és optikai korrekcióig.",
  },
} as const;
const specializationHeading = specializationCopy[locale];

const physicianCollageCopy = {
  uk: {
    eyebrow: "Головний лікар",
    title: chiefPhysician.name,
    badge: "Понад 20 років досвіду",
    role: "Засновниця та провідний лікар-офтальмолог",
    body: "Понад 20 років щоденної лікарської практики в офтальмології (з 2004 року). Поєднання академічного клінічного досвіду, сучасних європейських протоколів діагностики та щирої персональної турботи про зір кожного пацієнта.",
    feature1: "Експертна дитяча та доросла діагностика",
    feature2: "Складна оптична корекція та контроль міопії",
    feature3: "Індивідуальний супровід та консультації",
    portraitAlt: `${chiefPhysician.name}, головний лікар клініки`,
    contextAlt: "Мирослава Леньо під час консультативного прийому в кабінеті",
  },
  en: {
    eyebrow: "Chief Physician",
    title: chiefPhysician.name,
    badge: "Over 20 years of practice",
    role: "Founder & Lead Ophthalmologist",
    body: "More than 20 years of continuous clinical ophthalmology practice since 2004. Combining deep medical expertise, advanced European diagnostic standards, and attentive patient care.",
    feature1: "Expert pediatric and adult eye diagnostics",
    feature2: "Precision optical correction & myopia management",
    feature3: "Tailored treatment plan for every patient",
    portraitAlt: `${chiefPhysician.name}, Chief Physician`,
    contextAlt: "Dr. Miroslava Leno in the clinical office",
  },
  sk: {
    eyebrow: "Hlavná lekárka",
    title: chiefPhysician.name,
    badge: "Viac ako 20 rokov praxe",
    role: "Zakladateľka a vedúca oftalmologička",
    body: "Viac ako 20 rokov lekárskej praxe v oftalmológii (od roku 2004). Spojenie odbornej expertízy, moderných európskych diagnostických štandardov a osobného prístupu.",
    feature1: "Odborná detská a dospelá diagnostika",
    feature2: "Zložitá optická korekcia a kontrola krátkozrakosti",
    feature3: "Individuálny prístup ku každému pacientovi",
    portraitAlt: `${chiefPhysician.name}, hlavná lekárka`,
    contextAlt: "Dr. Miroslava Leno v ambulancii",
  },
  hu: {
    eyebrow: "Főorvos",
    title: chiefPhysician.name,
    badge: "Több mint 20 év tapasztalat",
    role: "Alapító és vezető szemészorvos",
    body: "Több mint 20 év folyamatos szemészeti gyakorlat (2004 óta). A szakmai tapasztalat, a modern európai diagnosztika és a páciensközpontú gondoskodás ötvözete.",
    feature1: "Szakértő gyermek- és felnőtt szemészeti vizsgálat",
    feature2: "Precíziós optikai korrekció és kezelés",
    feature3: "Személyre szabott terápiás terv",
    portraitAlt: `${chiefPhysician.name}, főorvos`,
    contextAlt: "Dr. Miroszlava Lényó a rendelőben",
  },
} as const;
const physicianCopy = physicianCollageCopy[locale];
---

<BaseLayout
  title={t(locale, "seo.services.title")}
  description={t(locale, "seo.services.description")}
  locale={locale}
>
  <!-- Hero Section -->
  <header class="border-b border-primary-foreground/15 bg-primary py-16 text-primary-foreground sm:py-20 lg:py-28">
    <Container
      class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-16"
      data-reveal
    >
      <div class="min-w-0 lg:col-span-8">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">
          {t(locale, "services.heroEyebrow")}
        </p>
        <h1 class="mt-6 max-w-[14ch] min-w-0 break-words text-balance text-[clamp(2.5rem,12vw,4.5rem)] font-medium leading-[0.98] tracking-[-0.035em] text-primary-foreground">
          {t(locale, "services.heroTitle")}
        </h1>
      </div>

      <div class="lg:col-span-4">
        <p class="max-w-xl text-base leading-7 text-primary-foreground/80">
          {t(locale, "services.heroIntro")}
        </p>
        {SHOW_SPECIAL_PROGRAMS && (
          <a
            class="focus-ring-primary mt-6 inline-flex min-h-11 items-center border-b border-primary-foreground/40 text-sm font-semibold text-primary-foreground transition-colors hover:border-accent hover:text-accent"
            href={localizePath("/services/programs", locale)}
          >
            {t(locale, "services.programsLink")}
          </a>
        )}
      </div>
    </Container>
  </header>

  <!-- Три напрямки допомоги -->
  <section
    class="border-b border-border bg-background py-16 sm:py-20 lg:py-28"
    aria-labelledby="specializations-heading"
  >
    <Container>
      <div class="grid min-w-0 gap-8 lg:grid-cols-12 lg:items-end lg:gap-14" data-reveal>
        <div class="min-w-0 lg:col-span-8">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary/80">
            {specializationHeading.eyebrow}
          </p>
          <h2
            id="specializations-heading"
            class="mt-4 max-w-3xl font-serif text-3xl font-medium leading-tight tracking-[-0.025em] text-foreground sm:text-4xl lg:text-5xl"
          >
            {specializationHeading.title}
          </h2>
        </div>
        <p class="min-w-0 max-w-xl text-sm leading-7 text-foreground/70 sm:text-base lg:col-span-4">
          {specializationHeading.intro}
        </p>
      </div>

      <div class="mt-12 grid min-w-0 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
        {
          specializations.map((specialization, index) => (
            <article class="group flex flex-col justify-between overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 hover:shadow-md">
              <figure class="relative aspect-[16/11] overflow-hidden bg-muted">
                <img
                  class="size-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  src={typeof specialization.image === "string" ? specialization.image : specialization.image.src}
                  width={specialization.image.width}
                  height={specialization.image.height}
                  alt={specialization.imageAlt}
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
                <span class="absolute left-4 top-4 inline-flex items-center rounded bg-primary/90 px-2.5 py-1 text-xs font-semibold tabular-nums tracking-wider text-accent backdrop-blur-sm">
                  0{index + 1}
                </span>
              </figure>

              <div class="flex flex-1 flex-col p-6 sm:p-7">
                <h3 class="font-serif text-xl font-medium leading-snug text-foreground sm:text-2xl">
                  {specialization.title}
                </h3>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-foreground/70">
                  {specialization.description}
                </p>

                <div class="mt-6 border-t border-[#e8e2d5] pt-4">
                  <a
                    href={appointmentHref}
                    class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-primary transition-colors hover:text-accent"
                  >
                    <span>{t(locale, "actions.bookShort")}</span>
                    <svg class="size-3.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Секція головного лікаря -->
  <section class="border-b border-border bg-card py-16 sm:py-20 lg:py-28" aria-labelledby="services-physician-heading">
    <Container class="grid min-w-0 gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
      <!-- Фотокомпозиція з бейджем -->
      <div class="relative min-w-0 max-w-md mx-auto lg:max-w-none lg:col-span-5" data-reveal>
        <figure class="overflow-hidden rounded-xl border border-border/80 bg-white shadow-lg">
          <img
            class="aspect-[4/5] size-full object-cover object-top"
            src={clinicImageAssets.doctorPortrait.src}
            width={clinicImageAssets.doctorPortrait.width}
            height={clinicImageAssets.doctorPortrait.height}
            alt={physicianCopy.portraitAlt}
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="absolute -bottom-4 left-6 inline-flex items-center gap-2.5 rounded-full border border-primary/20 bg-primary px-5 py-2 text-xs font-semibold text-primary-foreground shadow-xl">
          <span class="size-2 rounded-full bg-accent animate-pulse" />
          <span>{physicianCopy.badge}</span>
        </div>
      </div>

      <!-- Інформаційний блок -->
      <div class="min-w-0 lg:col-span-7 lg:pl-6" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">
          {physicianCopy.eyebrow}
        </p>
        <h2 id="services-physician-heading" class="mt-3 font-serif text-3xl font-medium tracking-tight text-primary sm:text-4xl lg:text-5xl">
          {physicianCopy.title}
        </h2>
        <p class="mt-1 text-sm font-semibold text-foreground/70">
          {physicianCopy.role}
        </p>

        <p class="mt-6 text-sm leading-7 text-foreground/80 sm:text-base sm:leading-8">
          {physicianCopy.body}
        </p>

        <!-- Переваги / Напрямки лікаря -->
        <ul class="mt-6 space-y-2.5 border-t border-[#e8e2d5] pt-6">
          <li class="flex items-center gap-3 text-sm text-foreground/85">
            <svg class="size-4.5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>{physicianCopy.feature1}</span>
          </li>
          <li class="flex items-center gap-3 text-sm text-foreground/85">
            <svg class="size-4.5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>{physicianCopy.feature2}</span>
          </li>
          <li class="flex items-center gap-3 text-sm text-foreground/85">
            <svg class="size-4.5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>{physicianCopy.feature3}</span>
          </li>
        </ul>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            class="focus-ring-primary inline-flex min-h-12 items-center justify-center rounded-sm bg-primary px-6 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
            href={appointmentHref}
          >
            {t(locale, "actions.bookConsultation")}
          </a>
          <a
            class="focus-ring-primary inline-flex min-h-12 items-center justify-center rounded-sm border border-border px-6 text-sm font-semibold text-primary transition-colors hover:border-primary hover:bg-muted"
            href={clinicContact.phoneHref}
            aria-label={callAriaLabel}
          >
            {clinicContact.phoneDisplay}
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- Прайс-лист: Повнорозмірний смарагдовий банер -->
  <section class="border-y border-primary-foreground/15 bg-primary py-12 sm:py-16 text-primary-foreground" aria-labelledby="price-list-heading">
    <Container data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">
        {t(locale, "services.listEyebrow")}
      </p>
      <h2
        id="price-list-heading"
        class="mt-2 font-serif text-3xl font-medium tracking-tight text-primary-foreground sm:text-4xl lg:text-5xl"
      >
        {t(locale, "services.listTitle")}
      </h2>
    </Container>
  </section>

  <!-- Прайс-лист: Каталог послуг на теплому фоні Ivory -->
  <section class="border-b border-[#e8e2d5] bg-[#faf8f5] py-16 sm:py-20 lg:py-28" aria-label={t(locale, "services.listTitle")}>
    <Container>
      {
        showTranslationFallback && (
          <p class="mb-10 max-w-3xl border-l-2 border-accent pl-4 text-sm leading-6 text-foreground/70">
            {t(locale, "services.translationFallbackNote")}
          </p>
        )
      }

      <div class="min-w-0 divide-y divide-[#e8e2d5]">
        {
          medicalPriceGroups.map((group, groupIndex) => (
            <section
              class="grid gap-7 py-10 sm:py-12 lg:grid-cols-12 lg:gap-12"
              aria-labelledby={`service-group-${groupIndex}`}
              data-reveal
            >
              <div class="lg:col-span-4">
                <p class="text-xs font-semibold tabular-nums tracking-[0.18em] text-primary/70">
                  {String(groupIndex + 1).padStart(2, "0")}
                </p>
                <h3
                  id={`service-group-${groupIndex}`}
                  class="mt-3 max-w-sm font-serif text-2xl font-medium leading-tight text-primary sm:text-3xl"
                >
                  {t(locale, group.titleKey)}
                </h3>
              </div>

              <dl class="divide-y divide-[#e8e2d5] border-t border-[#e8e2d5] lg:col-span-8">
                {group.items.map((item) => (
                  <div
                    data-medical-price-id={item.id}
                    class="group grid min-w-0 gap-2 py-4.5 transition-colors hover:bg-muted/40 px-3 -mx-3 rounded sm:grid-cols-[minmax(0,1fr)_auto] sm:items-baseline sm:gap-8"
                  >
                    <dt class="min-w-0 text-sm font-medium leading-6 text-foreground sm:text-base">
                      <span class="flex min-w-0 items-baseline gap-3">
                        <span
                          class="shrink-0 text-[0.6875rem] font-semibold tabular-nums tracking-[0.12em] text-primary/60"
                          aria-hidden="true"
                        >
                          #{String(item.id).padStart(2, "0")}
                        </span>
                        <span class="min-w-0 break-words group-hover:text-primary transition-colors">
                          {getMedicalServiceDisplayName(item, locale)}
                        </span>
                      </span>
                      {
                        getMedicalServiceDisplayNote(item, locale) && (
                          <span class="mt-1 block break-words pl-8 text-xs font-normal leading-5 text-foreground/70">
                            {getMedicalServiceDisplayNote(item, locale)}
                          </span>
                        )
                      }
                    </dt>
                    <dd class="whitespace-nowrap pl-8 text-sm font-bold leading-6 tabular-nums text-primary sm:pl-0 sm:text-right sm:text-base">
                      <span class="sr-only">{t(locale, "services.priceLabel")}: </span>
                      {formatMedicalPrice(item.priceUah, locale)}
                    </dd>
                  </div>
                ))}
              </dl>
            </section>
          ))
        }
      </div>

      <aside
        class="mt-8 grid gap-8 border-y border-[#e8e2d5] py-8 sm:py-10 lg:grid-cols-12 lg:gap-12"
        aria-labelledby="price-list-source-heading"
      >
        <div class="lg:col-span-4">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary/80">
            {t(locale, "services.sourceEyebrow")}
          </p>
          <h3
            id="price-list-source-heading"
            class="mt-3 max-w-sm font-serif text-xl font-medium leading-tight text-foreground sm:text-2xl"
          >
            {t(locale, "services.sourceTitle")}
          </h3>
        </div>

        <div class="min-w-0 lg:col-span-8">
          <dl class="grid min-w-0 gap-x-8 gap-y-6 sm:grid-cols-2">
            <div class="min-w-0">
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-foreground/70">
                {t(locale, "services.approvedOnLabel")}
              </dt>
              <dd class="mt-2 text-sm leading-6 text-foreground">
                <time datetime={MEDICAL_PRICE_LIST_META.approvedOn}>
                  {approvedOnDisplay}
                </time>
              </dd>
            </div>
            <div class="min-w-0">
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-foreground/70">
                {t(locale, "services.currencyLabel")}
              </dt>
              <dd class="mt-2 text-sm leading-6 text-foreground">
                {MEDICAL_PRICE_LIST_META.currency}
              </dd>
            </div>
            <div class="min-w-0">
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-foreground/70">
                {t(locale, "services.legalEntityLabel")}
              </dt>
              <dd class="mt-2 break-words text-sm leading-6 text-foreground">
                {MEDICAL_PRICE_LIST_META.legalEntity}
              </dd>
            </div>
            <div class="min-w-0">
              <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-foreground/70">
                {t(locale, "services.officialAddressLabel")}
              </dt>
              <dd class="mt-2 break-words text-sm leading-6 text-foreground">
                {MEDICAL_PRICE_LIST_META.officialAddress}
              </dd>
            </div>
          </dl>
        </div>
      </aside>
    </Container>
  </section>

  <!-- Заклик до дії -->
  <section class="bg-primary py-16 text-primary-foreground sm:py-20" aria-labelledby="services-action-heading">
    <Container class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-16">
      <div class="lg:col-span-7">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">
          {t(locale, "services.nextEyebrow")}
        </p>
        <h2
          id="services-action-heading"
          class="mt-4 max-w-2xl font-serif text-balance text-3xl font-medium tracking-tight sm:text-4xl"
        >
          {t(locale, "services.nextTitle")}
        </h2>
        <p class="mt-5 max-w-xl text-sm leading-6 text-primary-foreground/75">
          {t(locale, "services.shopPrompt")}{" "}
          <a
            class="border-b border-primary-foreground/35 font-semibold text-primary-foreground transition-colors hover:border-accent hover:text-accent"
            href={localizePath("/shop", locale)}
          >
            {t(locale, "services.shopLink")}
          </a>
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap lg:col-span-5 lg:justify-end">
        <a
          class="focus-ring-primary inline-flex min-h-12 items-center justify-center bg-primary-foreground px-6 text-sm font-semibold text-primary transition-colors hover:bg-accent hover:text-foreground"
          href={appointmentHref}
        >
          {t(locale, "services.book")}
        </a>
        <a
          class="inline-flex min-h-12 items-center justify-center border border-primary-foreground/45 px-6 text-sm font-semibold text-primary-foreground transition-colors hover:border-accent hover:text-accent"
          href={clinicContact.phoneHref}
          aria-label={callAriaLabel}
        >
          {t(locale, "services.call")}
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
