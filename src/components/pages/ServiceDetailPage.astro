---
import AppointmentForm from "../clinic/AppointmentForm.astro";
import Container from "../ui/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { ServiceDetail } from "../../lib/cms";
import {
  localizePath,
  t,
  type Locale,
  type TranslationKey,
} from "../../lib/i18n";
import { localizeServiceDetail } from "./localize-service";

interface Props {
  locale: Locale;
  service: ServiceDetail;
}

const { locale, service } = Astro.props;
const localizedService = localizeServiceDetail(service, locale);

const categoryKeys: Record<ServiceDetail["category"], TranslationKey> = {
  adult: "serviceDetail.categoryAdult",
  pediatric: "serviceDetail.categoryPediatric",
  optical: "serviceDetail.categoryOptical",
};
---

<BaseLayout
  title={localizedService.metaTitle}
  description={localizedService.metaDescription}
  locale={locale}
>
  <nav class="border-b border-border bg-background" aria-label={t(locale, "breadcrumbs.label")}>
    <Container>
      <ol class="flex min-h-14 items-center gap-2 text-xs font-medium text-muted-foreground sm:text-sm">
        <li>
          <a
            class="focus-ring-primary inline-flex min-h-11 items-center transition-colors hover:text-primary"
            href={localizePath("/", locale)}
          >
            {t(locale, "breadcrumbs.home")}
          </a>
        </li>
        <li aria-hidden="true" class="text-border">/</li>
        <li>
          <a
            class="focus-ring-primary inline-flex min-h-11 items-center transition-colors hover:text-primary"
            href={localizePath("/services", locale)}
          >
            {t(locale, "breadcrumbs.services")}
          </a>
        </li>
        <li aria-hidden="true" class="text-border">/</li>
        <li class="min-w-0">
          <span class="block truncate text-foreground" aria-current="page">
            {localizedService.title}
          </span>
        </li>
      </ol>
    </Container>
  </nav>

  <article>
    <header class="bg-primary text-primary-foreground">
      <Container class="grid gap-10 py-16 sm:py-20 lg:grid-cols-12 lg:gap-16 lg:py-28">
        <div class="lg:col-span-8">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">
            {t(locale, categoryKeys[localizedService.category])}
          </p>
          <h1 class="mt-6 max-w-[13ch] text-balance text-[clamp(3rem,7vw,6.5rem)] font-medium leading-[0.94] tracking-[-0.04em]">
            {localizedService.title}
          </h1>
        </div>

        <div class="border-t border-primary-foreground/20 pt-7 lg:col-span-4 lg:mt-auto">
          <p class="max-w-lg font-serif text-2xl font-normal leading-snug text-primary-foreground/90 sm:text-3xl">
            {localizedService.heroTagline}
          </p>
          <p class="mt-6 max-w-lg text-sm font-light leading-7 text-primary-foreground/70 sm:text-base">
            {localizedService.description}
          </p>
        </div>
      </Container>
    </header>

    <section
      class="bg-background py-20 sm:py-24 lg:py-32"
      aria-labelledby="clinical-focus-heading"
    >
      <Container>
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
              {t(locale, "serviceDetail.clinicalEyebrow")}
            </p>
            <h2
              id="clinical-focus-heading"
              class="mt-5 max-w-md text-balance text-4xl font-medium leading-tight tracking-tight sm:text-5xl"
            >
              {t(locale, "serviceDetail.clinicalTitle")}
            </h2>
          </div>

          <ol class="grid gap-px overflow-hidden border border-border bg-border sm:grid-cols-2 lg:col-span-8">
            {
              localizedService.keyBenefits.map((benefit, index) => (
                <li class="min-h-52 bg-card p-7 sm:p-8 lg:min-h-60 lg:p-10">
                  <span class="text-xs font-semibold tabular-nums tracking-[0.18em] text-primary/70">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <p class="mt-10 max-w-sm font-serif text-xl leading-snug text-card-foreground sm:text-2xl">
                    {benefit}
                  </p>
                </li>
              ))
            }
          </ol>
        </div>

        <aside class="mt-12 flex flex-col gap-5 border-y border-border py-7 sm:flex-row sm:items-center sm:justify-between" aria-label={t(locale, "serviceDetail.shopAria")}>
          <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
            {t(locale, "serviceDetail.shopPrompt")}
          </p>
          <a class="inline-flex min-h-11 shrink-0 items-center border-b border-primary text-sm font-semibold text-primary" href={localizePath("/shop", locale)}>
            {t(locale, "serviceDetail.shopLink")}
          </a>
        </aside>
      </Container>
    </section>
  </article>

  <section
    id="appointment"
    class="scroll-mt-20 border-t border-border bg-muted py-20 sm:py-24 lg:py-32"
    aria-label={t(locale, "serviceDetail.appointmentAria")}
  >
    <Container class="grid gap-10 lg:grid-cols-12 lg:items-start lg:gap-16">
      <div class="lg:col-span-5 lg:pt-8">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
          {t(locale, "serviceDetail.appointmentEyebrow")}
        </p>
        <h2 class="mt-5 max-w-lg text-balance text-4xl font-medium leading-tight tracking-tight sm:text-5xl">
          {t(locale, "serviceDetail.appointmentTitle")}
        </h2>
        <p class="mt-6 max-w-lg text-base leading-7 text-muted-foreground">
          {t(locale, "serviceDetail.appointmentIntro")}
        </p>
      </div>

      <div class="lg:col-span-7 xl:pl-8">
        <AppointmentForm locale={locale} />
      </div>
    </Container>
  </section>
</BaseLayout>
