---
import Container from "../ui/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CertificateGallery from "../clinic/CertificateGallery.astro";
import { certificateAssets, siteImageAssets } from "../../lib/assets";
import {
  localizePath,
  t,
  type Locale,
  type TranslationKey,
} from "../../lib/i18n";
import { getAppointmentHref } from "../../lib/navigation";

interface Props {
  locale: Locale;
}

interface CopyCard {
  readonly title: TranslationKey;
  readonly body: TranslationKey;
}

const { locale } = Astro.props;
const appointmentHref = getAppointmentHref(Astro.url.pathname, locale);

const philosophyThemes: readonly CopyCard[] = [
  { title: "about.theme1Title", body: "about.theme1Body" },
  { title: "about.theme2Title", body: "about.theme2Body" },
  { title: "about.theme3Title", body: "about.theme3Body" },
  { title: "about.theme4Title", body: "about.theme4Body" },
];
---

<BaseLayout
  title={t(locale, "seo.about.title")}
  description={t(locale, "seo.about.description")}
  locale={locale}
>
  <article>
    <header class="border-b border-primary-foreground/15 bg-primary text-primary-foreground">
      <Container class="grid gap-12 py-16 sm:py-20 lg:grid-cols-12 lg:gap-16 lg:py-28">
        <div class="lg:col-span-8">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">
            {t(locale, "about.clinicIdentity")}
          </p>
          <h1 class="mt-6 max-w-[12ch] text-balance text-[clamp(3rem,7vw,6.5rem)] font-medium leading-[0.94] tracking-[-0.04em]">
            {t(locale, "about.heroTitle")}
          </h1>
        </div>

        <div class="border-t border-primary-foreground/20 pt-7 lg:col-span-4 lg:mt-auto">
          <p class="max-w-lg font-serif text-2xl leading-snug text-primary-foreground/90 sm:text-3xl">
            {t(locale, "about.heroQuote")}
          </p>
          <p class="mt-6 max-w-lg text-sm font-light leading-7 text-primary-foreground/70 sm:text-base">
            {t(locale, "about.heroIntro")}
          </p>
        </div>
      </Container>
    </header>

    <section
      class="border-b border-border bg-background py-20 sm:py-24 lg:py-32"
      aria-labelledby="chief-physician-heading"
    >
      <Container class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-16">
        <figure class="lg:col-span-5">
          <div class="overflow-hidden bg-muted">
            <img
              class="aspect-[4/5] h-full w-full object-cover object-center"
              src={siteImageAssets.miroslavaLeno.src}
              width={siteImageAssets.miroslavaLeno.width}
              height={siteImageAssets.miroslavaLeno.height}
              alt={t(locale, "about.portraitAlt")}
              loading="lazy"
              decoding="async"
              sizes="(min-width: 1024px) 38vw, 100vw"
            />
          </div>
          <figcaption class="mt-4 text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">
            {t(locale, "clinic.chiefRole")}
          </figcaption>
        </figure>

        <div class="lg:col-span-7 lg:pt-8">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
            {t(locale, "about.doctorEyebrow")}
          </p>
          <p class="mt-5 max-w-sm text-sm leading-7 text-muted-foreground sm:text-base">
            {t(locale, "about.doctorIntro")}
          </p>
          <div class="border-y border-border py-8 sm:py-10">
            <h2
              id="chief-physician-heading"
              class="max-w-3xl text-balance text-4xl font-medium leading-tight tracking-tight sm:text-5xl lg:text-6xl"
            >
              {t(locale, "clinic.chiefName")}
            </h2>

            <dl class="mt-10 grid gap-px border border-border bg-border sm:grid-cols-2">
              <div class="bg-card p-6 sm:p-8">
                <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
                  {t(locale, "about.roleLabel")}
                </dt>
                <dd class="mt-4 font-serif text-2xl text-card-foreground">
                  {t(locale, "clinic.chiefRole")}
                </dd>
              </div>
              <div class="bg-card p-6 sm:p-8">
                <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
                  {t(locale, "about.experienceLabel")}
                </dt>
                <dd class="mt-4 font-serif text-2xl text-card-foreground">
                  {t(locale, "clinic.chiefExperience")}
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </Container>
    </section>

    <section
      class="bg-muted py-20 sm:py-24 lg:py-32"
      aria-labelledby="philosophy-heading"
    >
      <Container>
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
              {t(locale, "about.philosophyEyebrow")}
            </p>
            <h2
              id="philosophy-heading"
              class="mt-5 max-w-md text-balance text-4xl font-medium leading-tight tracking-tight sm:text-5xl"
            >
              {t(locale, "about.philosophyTitle")}
            </h2>
          </div>

          <ol class="border-t border-border lg:col-span-8">
            {
              philosophyThemes.map((theme, index) => (
                <li class="grid gap-5 border-b border-border py-7 sm:grid-cols-[3rem_1fr] sm:py-9">
                  <span class="text-xs font-semibold tabular-nums tracking-[0.18em] text-primary/70">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <h3 class="text-2xl font-medium">{t(locale, theme.title)}</h3>
                    <p class="mt-3 max-w-2xl text-sm leading-7 text-muted-foreground sm:text-base">
                      {t(locale, theme.body)}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </Container>
    </section>

    <section class="bg-background py-20 sm:py-24 lg:py-32" aria-labelledby="credentials-heading">
      <Container>
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
            {t(locale, "about.documentsEyebrow")}
          </p>
          <h2
            id="credentials-heading"
            class="mt-5 text-balance text-4xl font-medium leading-tight tracking-tight sm:text-5xl"
          >
            {t(locale, "about.documentsTitle")}
          </h2>
          <p class="mt-6 max-w-2xl text-base leading-7 text-muted-foreground">
            {t(locale, "about.documentsIntro")}
          </p>
        </div>

        <div class="mt-12 lg:mt-16">
          <CertificateGallery locale={locale} certificates={certificateAssets} />
        </div>
      </Container>
    </section>

    <aside
      class="border-t border-primary-foreground/15 bg-primary text-primary-foreground"
      aria-label={t(locale, "about.actionsAria")}
    >
      <Container class="grid gap-8 py-14 sm:py-16 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">
            {t(locale, "about.actionEyebrow")}
          </p>
          <h2 class="mt-4 text-3xl font-medium sm:text-4xl">
            {t(locale, "about.actionTitle")}
          </h2>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
          <a
            class="inline-flex min-h-13 items-center justify-center rounded-lg bg-accent px-6 text-sm font-semibold text-primary transition-colors hover:bg-accent/90"
            href={appointmentHref}
          >
            {t(locale, "about.book")}
          </a>
          <a
            class="inline-flex min-h-13 items-center justify-center rounded-lg border border-primary-foreground/35 px-6 text-sm font-semibold text-primary-foreground transition-colors hover:border-primary-foreground"
            href={localizePath("/contacts", locale)}
          >
            {t(locale, "about.contact")}
          </a>
        </div>
      </Container>
    </aside>
  </article>
</BaseLayout>
