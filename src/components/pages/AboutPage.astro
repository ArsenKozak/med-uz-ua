---
import Container from "../ui/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CertificateGallery from "../clinic/CertificateGallery.astro";
import { certificateAssets, siteImageAssets } from "../../lib/assets";
import {
  localizePath,
  t,
  type Locale,
  type TranslationKey,
} from "../../lib/i18n";
import { getAppointmentHref } from "../../lib/navigation";

interface Props {
  locale: Locale;
}

interface CopyCard {
  readonly title: TranslationKey;
  readonly body: TranslationKey;
}

const { locale } = Astro.props;
const appointmentHref = getAppointmentHref(Astro.url.pathname, locale);

const philosophyThemes: readonly CopyCard[] = [
  { title: "about.theme1Title", body: "about.theme1Body" },
  { title: "about.theme2Title", body: "about.theme2Body" },
  { title: "about.theme3Title", body: "about.theme3Body" },
  { title: "about.theme4Title", body: "about.theme4Body" },
];
---

<BaseLayout
  title={t(locale, "seo.about.title")}
  description={t(locale, "seo.about.description")}
  locale={locale}
>
  <article>
    <!-- Hero Header -->
    <header class="border-b border-primary-foreground/15 bg-primary text-primary-foreground">
      <Container class="grid gap-10 py-16 sm:py-20 lg:grid-cols-12 lg:gap-16 lg:py-24">
        <div class="lg:col-span-7">
          <span class="inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/10 px-3.5 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-accent">
            <span class="size-1.5 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
            {t(locale, "about.clinicIdentity")}
          </span>
          <h1 class="mt-6 text-balance font-serif text-4xl font-medium leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
            {t(locale, "about.heroTitle")}
          </h1>
        </div>

        <div class="flex flex-col justify-end border-t border-primary-foreground/20 pt-7 lg:col-span-5 lg:border-t-0 lg:border-l lg:border-primary-foreground/15 lg:pl-10 lg:pt-0">
          <p class="font-serif text-xl leading-relaxed text-primary-foreground/90 sm:text-2xl">
            "{t(locale, "about.heroQuote")}"
          </p>
          <p class="mt-5 text-sm font-light leading-relaxed text-primary-foreground/75 sm:text-base">
            {t(locale, "about.heroIntro")}
          </p>
        </div>
      </Container>
    </header>

    <!-- Головна лікарка та експертиза -->
    <section
      class="border-b border-border bg-background py-16 sm:py-20 lg:py-28"
      aria-labelledby="chief-physician-heading"
    >
      <Container class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
        <!-- Фотографія лікаря з м'якою тінню та скругленням -->
        <figure class="lg:col-span-5">
          <div class="group relative overflow-hidden rounded-2xl border border-border/80 bg-muted/40 shadow-xl shadow-primary/5 transition-all duration-500 hover:shadow-2xl hover:shadow-primary/10 lg:rounded-3xl">
            <img
              class="aspect-[4/5] size-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-[1.03]"
              src={siteImageAssets.miroslavaLeno.src}
              width={siteImageAssets.miroslavaLeno.width}
              height={siteImageAssets.miroslavaLeno.height}
              alt={t(locale, "about.portraitAlt")}
              loading="eager"
              decoding="async"
              sizes="(min-width: 1024px) 38vw, 100vw"
            />
          </div>
        </figure>

        <!-- Текстовий блок лікаря -->
        <div class="flex flex-col justify-center lg:col-span-7">
          <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.22em] text-primary">
            <span class="size-2 rounded-full bg-primary" aria-hidden="true"></span>
            {t(locale, "about.doctorEyebrow")}
          </div>

          <h2
            id="chief-physician-heading"
            class="mt-4 font-serif text-3xl font-medium tracking-tight sm:text-4xl lg:text-5xl"
          >
            {t(locale, "clinic.chiefName")}
          </h2>

          <p class="mt-4 text-base leading-relaxed text-muted-foreground sm:text-lg">
            {t(locale, "about.doctorIntro")}
          </p>

          <!-- Картки характеристик -->
          <dl class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl border border-border/80 bg-card p-5 sm:p-6 shadow-xs">
              <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
                {t(locale, "about.roleLabel")}
              </dt>
              <dd class="mt-2 font-serif text-xl font-medium text-foreground sm:text-2xl">
                {t(locale, "clinic.chiefRole")}
              </dd>
            </div>
            <div class="rounded-2xl border border-border/80 bg-card p-5 sm:p-6 shadow-xs">
              <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
                {t(locale, "about.experienceLabel")}
              </dt>
              <dd class="mt-2 font-serif text-xl font-medium text-primary sm:text-2xl">
                {t(locale, "clinic.chiefExperience")}
              </dd>
            </div>
          </dl>

          <!-- Швидкі навігаційні кнопки -->
          <div class="mt-8 flex flex-wrap items-center gap-3.5">
            <a
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-md shadow-primary/15 transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary/95 hover:shadow-lg active:translate-y-0"
              href={appointmentHref}
            >
              <span>{t(locale, "about.book")}</span>
              <span class="text-accent" aria-hidden="true">→</span>
            </a>

            <a
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-border bg-card px-6 text-sm font-semibold text-foreground transition-all duration-200 hover:border-primary hover:bg-muted"
              href={localizePath("/services", locale)}
            >
              <span>{t(locale, "nav.services")}</span>
            </a>

            <a
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-border bg-card px-6 text-sm font-semibold text-foreground transition-all duration-200 hover:border-primary hover:bg-muted"
              href={localizePath("/shop", locale)}
            >
              <span>{t(locale, "nav.shop")}</span>
            </a>
          </div>
        </div>
      </Container>
    </section>

    <!-- Клінічні принципи -->
    <section
      class="bg-muted/40 py-16 sm:py-20 lg:py-28 border-b border-border"
      aria-labelledby="philosophy-heading"
    >
      <Container>
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <span class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
              {t(locale, "about.philosophyEyebrow")}
            </span>
            <h2
              id="philosophy-heading"
              class="mt-4 text-balance font-serif text-3xl font-medium tracking-tight sm:text-4xl"
            >
              {t(locale, "about.philosophyTitle")}
            </h2>
          </div>

          <div class="grid gap-4 sm:grid-cols-2 lg:col-span-8">
            {
              philosophyThemes.map((theme, index) => (
                <div class="flex flex-col justify-between rounded-2xl border border-border/80 bg-card p-6 sm:p-7 shadow-xs transition-all duration-300 hover:border-primary/40 hover:shadow-md">
                  <div>
                    <span class="text-xs font-bold tabular-nums tracking-widest text-primary/70">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <h3 class="mt-3 font-serif text-xl font-medium text-foreground">
                      {t(locale, theme.title)}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                      {t(locale, theme.body)}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </Container>
    </section>

    <!-- Галерея сертифікатів -->
    <section class="bg-background py-16 sm:py-20 lg:py-28" aria-labelledby="credentials-heading">
      <Container>
        <div class="max-w-3xl">
          <span class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
            {t(locale, "about.documentsEyebrow")}
          </span>
          <h2
            id="credentials-heading"
            class="mt-4 text-balance font-serif text-3xl font-medium tracking-tight sm:text-4xl"
          >
            {t(locale, "about.documentsTitle")}
          </h2>
          <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted-foreground">
            {t(locale, "about.documentsIntro")}
          </p>
        </div>

        <div class="mt-10 lg:mt-14">
          <CertificateGallery locale={locale} certificates={certificateAssets} />
        </div>
      </Container>
    </section>

    <!-- CTA Секція -->
    <aside
      class="border-t border-primary-foreground/15 bg-primary text-primary-foreground"
      aria-label={t(locale, "about.actionsAria")}
    >
      <Container class="grid gap-8 py-14 sm:py-16 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">
            {t(locale, "about.actionEyebrow")}
          </p>
          <h2 class="mt-3 font-serif text-3xl font-medium sm:text-4xl">
            {t(locale, "about.actionTitle")}
          </h2>
        </div>
        <div class="flex flex-col gap-3.5 sm:flex-row lg:col-span-5 lg:justify-end">
          <a
            class="inline-flex min-h-13 items-center justify-center rounded-xl bg-accent px-7 text-sm font-semibold text-primary shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent/90 hover:shadow-lg active:translate-y-0"
            href={appointmentHref}
          >
            {t(locale, "about.book")}
          </a>
          <a
            class="inline-flex min-h-13 items-center justify-center rounded-xl border border-primary-foreground/35 px-7 text-sm font-semibold text-primary-foreground transition-all duration-200 hover:border-primary-foreground hover:bg-primary-foreground/10 active:translate-y-0"
            href={localizePath("/contacts", locale)}
          >
            {t(locale, "about.contact")}
          </a>
        </div>
      </Container>
    </aside>
  </article>
</BaseLayout>
