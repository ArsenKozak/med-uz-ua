---
import Container from "../ui/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { ProductSummary } from "../../lib/cms";
import { formatMoneyMinor } from "../../lib/commerce/money";
import { defaultLocale, localizePath, t, type Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
  product: ProductSummary;
  relatedProducts?: readonly ProductSummary[];
}

const { locale = defaultLocale, product, relatedProducts = [] } = Astro.props;

const formattedPrice = formatMoneyMinor(
  product.priceMinor,
  product.currency,
  locale
);

const isPending = product.verificationStatus === "pending-clinic-confirmation";

const categoryLabels = {
  lenses: t(locale, "product.categories.lenses"),
  frames: t(locale, "product.categories.frames"),
  sunglasses: t(locale, "product.categories.sunglasses"),
  care: t(locale, "product.categories.care"),
};

const categoryTitle = categoryLabels[product.category] || product.category;

const copy = {
  uk: {
    catalog: "Каталог оптики",
    back: "← Назад до каталогу",
    guaranteeTitle: "Оригінальна якість",
    guaranteeText: "Офіційні поставки від виробника з контролем умов зберігання.",
    deliveryTitle: "Отримання та примірка",
    deliveryText: "Самовивіз із клініки в Ужгороді з можливістю примірки або швидка доставка.",
    consultTitle: "Потрібна допомога з підбором?",
    consultPrompt: "Лікар-офтальмолог перевірить зір і допоможе з точним рецептом.",
    book: "Запис на огляд",
    relatedTitle: "Рекомендовані товари категорії",
    inStock: "В наявності",
    outOfStock: "Під замовлення",
    toastTitle: "Товар додано в кошик",
    viewCart: "Переглянути кошик",
    continue: "Продовжити",
  },
  en: {
    catalog: "Optical Catalog",
    back: "← Back to catalog",
    guaranteeTitle: "Certified Quality",
    guaranteeText: "Direct official manufacturer supply compliant with medical standards.",
    deliveryTitle: "Pickup & Delivery",
    deliveryText: "In-clinic pickup with trial fitting in Uzhhorod or fast shipping.",
    consultTitle: "Need prescription assistance?",
    consultPrompt: "Our ophthalmologists provide complete diagnostic checkups.",
    book: "Book exam",
    relatedTitle: "Related in this category",
    inStock: "In stock",
    outOfStock: "On demand",
    toastTitle: "Added to your cart",
    viewCart: "View Cart",
    continue: "Continue",
  },
  sk: {
    catalog: "Katalóg optiky",
    back: "← Späť do katalógu",
    guaranteeTitle: "Certifikovaná kvalita",
    guaranteeText: "Oficiálne dodávky od výrobcu v súlade s lekárskymi štandardmi.",
    deliveryTitle: "Odber a doručenie",
    deliveryText: "Osobný odber na klinike v Užhorode s možnosťou vyskúšania alebo kuriér.",
    consultTitle: "Potrebujete pomôcť s výberom?",
    consultPrompt: "Očný lekár vyšetrí zrak a pomôže s presnými parametrami.",
    book: "Objednať sa",
    relatedTitle: "Odporúčané produkty",
    inStock: "Na sklade",
    outOfStock: "Na objednávku",
    toastTitle: "Tovar bol pridaný do košíka",
    viewCart: "Zobraziť košík",
    continue: "Pokračovať",
  },
  hu: {
    catalog: "Optikai katalógus",
    back: "← Vissza a katalógushoz",
    guaranteeTitle: "Eredeti minőség",
    guaranteeText: "Hivatalos gyártói forgalmazás orvosi minőségbiztosítással.",
    deliveryTitle: "Átvétel és próba",
    deliveryText: "Személyes átvétel és próba az ungvári klinikán vagy házhozszállítás.",
    consultTitle: "Segítségre van szüksége?",
    consultPrompt: "Szemész szakorvosunk készséggel áll rendelkezésére a vizsgálathoz.",
    book: "Időpontfoglalás",
    relatedTitle: "Ajánlott termékek",
    inStock: "Készleten",
    outOfStock: "Rendelésre",
    toastTitle: "Termék a kosárba helyezve",
    viewCart: "Kosár megnyitása",
    continue: "Tovább",
  },
}[locale];
---

<BaseLayout
  title={`${product.title} — ${copy.catalog} | Med.uz.ua`}
  description={product.description}
  locale={locale}
>
  <!-- Хлібні крихти -->
  <header class="border-b border-border/80 bg-[#faf8f5] py-4">
    <Container>
      <nav class="flex flex-wrap items-center gap-2 text-xs font-medium text-muted-foreground" aria-label="Breadcrumb">
        <a href={localizePath("/shop", locale)} class="hover:text-primary transition-colors">
          {copy.catalog}
        </a>
        <span aria-hidden="true" class="text-border">/</span>
        <span class="text-foreground/75">{categoryTitle}</span>
        <span aria-hidden="true" class="text-border">/</span>
        <span class="text-primary font-semibold truncate max-w-sm">{product.title}</span>
      </nav>
    </Container>
  </header>

  <main class="py-10 sm:py-14 lg:py-16">
    <Container>
      <div class="mb-6">
        <a
          href={localizePath("/shop", locale)}
          class="inline-flex items-center gap-2 text-sm font-semibold text-primary/90 hover:text-accent transition-colors"
        >
          {copy.back}
        </a>
      </div>

      <div class="grid gap-10 lg:grid-cols-12 lg:gap-14 items-start">
        <!-- Фотографія товару -->
        <div class="lg:col-span-6">
          <div class="relative aspect-square overflow-hidden rounded-2xl border border-border bg-white p-8 sm:p-12 shadow-sm flex items-center justify-center">
            <img
              src={product.image}
              alt={product.title}
              class="max-h-full max-w-full object-contain transition-transform duration-500 hover:scale-105"
              width="800"
              height="800"
              decoding="async"
              fetchpriority="high"
            />
            {product.imageKind !== "product" && (
              <span class="absolute bottom-4 left-4 rounded bg-background/90 backdrop-blur-sm px-3 py-1.5 text-xs font-semibold text-muted-foreground">
                {t(locale, "product.imageEditorial")}
              </span>
            )}
          </div>
        </div>

        <!-- Інформація про товар -->
        <div class="lg:col-span-6 flex flex-col">
          <div class="flex items-center justify-between gap-4">
            <span class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">
              {product.brand}
            </span>
            <span class:list={[
              "inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold tracking-wide",
              product.inStock ? "bg-emerald-50 text-emerald-800 border border-emerald-200" : "bg-muted text-muted-foreground"
            ]}>
              {product.inStock ? copy.inStock : copy.outOfStock}
            </span>
          </div>

          <h1 class="mt-4 font-serif text-3xl font-medium tracking-tight text-foreground sm:text-4xl lg:text-[2.75rem] leading-[1.12]">
            {product.title}
          </h1>

          <div class="mt-6 border-y border-[#e8e2d5] py-5">
            {isPending ? (
              <div class="border-l-2 border-accent pl-3">
                <p class="text-base font-semibold text-foreground">{t(locale, "product.pricePending")}</p>
                <p class="mt-1 text-sm text-muted-foreground">{t(locale, "product.pendingDescription")}</p>
              </div>
            ) : (
              <div class="flex items-baseline gap-3">
                <p class="font-serif text-3xl font-semibold text-primary sm:text-4xl">
                  {formattedPrice}
                </p>
                <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">
                  / {product.category === "lenses" ? "упаковка" : "шт."}
                </span>
              </div>
            )}
          </div>

          <!-- Опис товару -->
          <div class="mt-6 text-base sm:text-lg leading-relaxed text-foreground/85">
            <p>{product.description}</p>
          </div>

          <!-- Лічильник кількості + Кнопка замовлення -->
          <div class="mt-8 flex flex-col sm:flex-row items-stretch gap-3.5">
            {product.inStock && (
              <div class="inline-flex items-center justify-between border border-border rounded-sm bg-card px-3 py-2 sm:w-36 shrink-0 shadow-xs">
                <button
                  type="button"
                  id="qty-decrease"
                  class="size-8 flex items-center justify-center rounded text-foreground/70 hover:bg-muted hover:text-foreground text-lg font-bold transition-colors active:scale-95"
                  aria-label="Зменшити кількість"
                >
                  −
                </button>
                <span id="qty-display" class="font-serif text-lg font-semibold tabular-nums text-foreground px-3 select-none">
                  1
                </span>
                <button
                  type="button"
                  id="qty-increase"
                  class="size-8 flex items-center justify-center rounded text-foreground/70 hover:bg-muted hover:text-foreground text-lg font-bold transition-colors active:scale-95"
                  aria-label="Збільшити кількість"
                >
                  +
                </button>
              </div>
            )}

            <button
              class="focus-ring-primary flex-1 inline-flex min-h-12 items-center justify-center gap-2 rounded-sm bg-primary px-8 text-base font-semibold text-primary-foreground shadow-sm transition-all duration-200 hover:bg-primary/90 active:scale-[0.98] disabled:opacity-50"
              type="button"
              id="detail-add-btn"
              data-add-to-cart
              data-product-id={product.id}
              data-product-title={product.title}
              data-product-price-minor={String(product.priceMinor)}
              data-product-currency={product.currency}
              data-product-verification-status={product.verificationStatus}
              data-product-category={product.category}
              data-product-image={product.image}
              disabled={!product.inStock}
            >
              <span id="btn-text">{product.inStock ? t(locale, "actions.addToCart") : t(locale, "product.unavailable")}</span>
            </button>
          </div>

          <!-- Клінічні переваги -->
          <div class="mt-8 space-y-3.5 rounded-xl border border-[#e8e2d5] bg-[#faf8f5] p-5 text-sm text-foreground/85">
            <div class="flex items-start gap-3">
              <svg class="size-5 shrink-0 text-primary mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <div>
                <strong class="font-semibold text-foreground">{copy.guaranteeTitle}:</strong> {copy.guaranteeText}
              </div>
            </div>
            <div class="flex items-start gap-3 border-t border-[#e8e2d5] pt-3">
              <svg class="size-5 shrink-0 text-primary mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
              </svg>
              <div>
                <strong class="font-semibold text-foreground">{copy.deliveryTitle}:</strong> {copy.deliveryText}
              </div>
            </div>
          </div>

          <!-- Підказка лікаря -->
          <div class="mt-6 border-t border-border pt-5 text-sm text-muted-foreground flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <p class="font-semibold text-foreground">{copy.consultTitle}</p>
              <p class="mt-0.5 text-xs text-muted-foreground">{copy.consultPrompt}</p>
            </div>
            <a href={localizePath("/contacts", locale)} class="shrink-0 inline-flex items-center justify-center rounded-sm border border-primary/30 bg-primary/5 px-4 py-2 text-xs font-semibold text-primary hover:bg-primary hover:text-primary-foreground transition-all">
              {copy.book}
            </a>
          </div>
        </div>
      </div>

      <!-- Схожі товари -->
      {relatedProducts.length > 0 && (
        <section class="mt-20 border-t border-border pt-12">
          <h2 class="font-serif text-2xl font-medium tracking-tight text-foreground sm:text-3xl mb-8">
            {copy.relatedTitle}
          </h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {relatedProducts.slice(0, 4).map((rel) => (
              <a
                href={localizePath(`/shop/${rel.id}`, locale)}
                class="group flex flex-col overflow-hidden rounded-xl border border-border bg-card p-4 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-md"
              >
                <div class="aspect-square w-full overflow-hidden rounded-lg bg-white p-4 flex items-center justify-center">
                  <img
                    src={rel.image}
                    alt={rel.title}
                    class="max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
                <div class="mt-4 flex flex-1 flex-col">
                  <p class="text-[0.68rem] font-semibold uppercase tracking-wider text-accent">{rel.brand}</p>
                  <p class="mt-1 font-serif text-base font-medium text-foreground group-hover:text-primary transition-colors line-clamp-2">{rel.title}</p>
                  <p class="mt-auto pt-3 font-serif text-lg font-semibold text-primary">{formatMoneyMinor(rel.priceMinor, rel.currency, locale)}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </Container>
  </main>

  <!-- Спливаюче вікно кошика (Floating Toast Notification) -->
  <aside
    id="cart-toast"
    class="fixed right-4 top-20 z-50 w-[calc(100vw-2rem)] max-w-md translate-x-[120%] opacity-0 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] sm:right-6 pointer-events-none"
    role="status"
    aria-live="polite"
  >
    <div class="relative overflow-hidden rounded-xl border border-border bg-card/95 p-4 sm:p-5 shadow-2xl backdrop-blur-md">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-2 text-emerald-800 font-semibold text-sm">
          <span class="flex size-5 items-center justify-center rounded-full bg-emerald-100 text-emerald-800 text-xs">✓</span>
          <span>{copy.toastTitle}</span>
        </div>
        <button
          type="button"
          id="toast-close"
          class="rounded p-1 text-muted-foreground hover:bg-muted hover:text-foreground transition-colors"
          aria-label="Закрити сповіщення"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="mt-3.5 flex items-center gap-3.5 rounded-lg bg-muted/40 p-2.5 border border-border/50">
        <div class="size-14 shrink-0 overflow-hidden rounded-md bg-white p-1 border border-border/40 flex items-center justify-center">
          <img src={product.image} alt={product.title} class="max-h-full max-w-full object-contain" />
        </div>
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-semibold text-foreground">{product.title}</p>
          <p class="mt-0.5 text-xs text-muted-foreground">
            <span id="toast-qty">1</span> шт. • <span class="font-medium text-primary">{formattedPrice}</span>
          </p>
        </div>
      </div>

      <div class="mt-4 flex items-center gap-2">
        <button
          type="button"
          id="toast-open-cart"
          class="focus-ring-primary flex-1 inline-flex items-center justify-center rounded-sm bg-primary py-2.5 px-4 text-xs sm:text-sm font-semibold text-primary-foreground shadow-xs transition-colors hover:bg-primary/90"
        >
          {copy.viewCart}
        </button>
        <button
          type="button"
          id="toast-dismiss"
          class="inline-flex items-center justify-center rounded-sm border border-border py-2.5 px-3.5 text-xs sm:text-sm font-medium text-foreground hover:bg-muted transition-colors"
        >
          {copy.continue}
        </button>
      </div>

      <!-- Прогрес-бар автозакриття -->
      <div class="absolute bottom-0 left-0 right-0 h-1 bg-muted overflow-hidden">
        <div id="toast-progress" class="h-full bg-primary/70 transition-all duration-[4000ms] ease-linear w-full"></div>
      </div>
    </div>
  </aside>
</BaseLayout>

<script>
  import { addToCart, type CartVerificationStatus } from "../../store/cart";
  import { trackAddToCart } from "../../lib/analytics";

  let quantity = 1;
  const qtyDisplay = document.getElementById("qty-display");
  const btnDec = document.getElementById("qty-decrease");
  const btnInc = document.getElementById("qty-increase");
  const addBtn = document.getElementById("detail-add-btn") as HTMLButtonElement | null;
  const btnText = document.getElementById("btn-text");

  const toast = document.getElementById("cart-toast");
  const toastQty = document.getElementById("toast-qty");
  const toastClose = document.getElementById("toast-close");
  const toastDismiss = document.getElementById("toast-dismiss");
  const toastOpenCart = document.getElementById("toast-open-cart");
  const toastProgress = document.getElementById("toast-progress");

  let toastTimer: ReturnType<typeof setTimeout> | null = null;

  if (btnDec && qtyDisplay) {
    btnDec.addEventListener("click", () => {
      if (quantity > 1) {
        quantity--;
        qtyDisplay.textContent = String(quantity);
      }
    });
  }

  if (btnInc && qtyDisplay) {
    btnInc.addEventListener("click", () => {
      if (quantity < 20) {
        quantity++;
        qtyDisplay.textContent = String(quantity);
      }
    });
  }

  function hideToast() {
    if (!toast) return;
    toast.classList.add("translate-x-[120%]", "opacity-0", "pointer-events-none");
    toast.classList.remove("translate-x-0", "opacity-100", "pointer-events-auto");
    if (toastTimer) clearTimeout(toastTimer);
  }

  function showToast(qty: number) {
    if (!toast) return;
    if (toastQty) toastQty.textContent = String(qty);

    if (toastTimer) clearTimeout(toastTimer);

    if (toastProgress) {
      toastProgress.style.transition = "none";
      toastProgress.style.width = "100%";
      void toastProgress.offsetWidth;
      toastProgress.style.transition = "width 4000ms linear";
      toastProgress.style.width = "0%";
    }

    toast.classList.remove("translate-x-[120%]", "opacity-0", "pointer-events-none");
    toast.classList.add("translate-x-0", "opacity-100", "pointer-events-auto");

    toastTimer = setTimeout(() => {
      hideToast();
    }, 4000);
  }

  toastClose?.addEventListener("click", hideToast);
  toastDismiss?.addEventListener("click", hideToast);

  toastOpenCart?.addEventListener("click", () => {
    hideToast();
    const cartTriggers = document.querySelectorAll<HTMLElement>(
      '[aria-label*="кошик" i], [aria-label*="cart" i], [data-cart-drawer-trigger], button[data-cart-toggle]'
    );
    if (cartTriggers.length > 0) {
      cartTriggers[0].click();
    }
  });

  function isVerificationStatus(value: string | undefined): value is CartVerificationStatus {
    return value === "verified" || value === "pending-clinic-confirmation";
  }

  if (addBtn) {
    addBtn.addEventListener("click", () => {
      const id = addBtn.dataset.productId;
      const title = addBtn.dataset.productTitle;
      const priceMinorValue = addBtn.dataset.productPriceMinor;
      const currency = addBtn.dataset.productCurrency;
      const verificationStatus = addBtn.dataset.productVerificationStatus;

      if (!id || !title || !priceMinorValue || !currency || !isVerificationStatus(verificationStatus)) return;

      const priceMinor = Number(priceMinorValue);

      for (let i = 0; i < quantity; i++) {
        addToCart({ id, title, priceMinor, currency, verificationStatus });
      }

      const category = addBtn.dataset.productCategory;
      if (category) trackAddToCart({ id, category, priceMinor });

      // Мікроанімація кнопки
      if (btnText) {
        const originalText = btnText.textContent;
        btnText.textContent = "✓ Додано!";
        addBtn.classList.add("bg-emerald-800", "scale-[0.98]");
        setTimeout(() => {
          btnText.textContent = originalText;
          addBtn.classList.remove("bg-emerald-800", "scale-[0.98]");
        }, 1200);
      }

      showToast(quantity);
    });
  }
</script>
