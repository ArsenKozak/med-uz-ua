---
import Container from "../ui/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { clinicContact } from "../../lib/clinic";
import { localizePath, t, type Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const callAriaLabel = t(locale, "programs.callAria").replace(
  "{phone}",
  clinicContact.phoneDisplay,
);
---

<BaseLayout
  title={t(locale, "seo.programs.title")}
  description={t(locale, "seo.programs.description")}
  locale={locale}
>
  <nav class="border-b border-border bg-background" aria-label={t(locale, "breadcrumbs.label")}>
    <Container>
      <ol class="flex min-h-14 min-w-0 items-center gap-2 text-xs font-medium text-muted-foreground sm:text-sm">
        <li>
          <a
            class="focus-ring-primary inline-flex min-h-11 items-center transition-colors hover:text-primary"
            href={localizePath("/services", locale)}
          >
            {t(locale, "breadcrumbs.services")}
          </a>
        </li>
        <li aria-hidden="true" class="text-border">/</li>
        <li class="min-w-0">
          <span class="block truncate text-foreground" aria-current="page">
            {t(locale, "breadcrumbs.programs")}
          </span>
        </li>
      </ol>
    </Container>
  </nav>

  <header class="bg-primary py-16 text-primary-foreground sm:py-20 lg:py-28">
    <Container class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-16">
      <div class="lg:col-span-8">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent">
          {t(locale, "programs.heroEyebrow")}
        </p>
        <h1 class="mt-6 max-w-[13ch] text-balance text-5xl font-medium leading-[0.98] tracking-[-0.035em] sm:text-6xl lg:text-7xl">
          {t(locale, "programs.heroTitle")}
        </h1>
      </div>
      <p class="max-w-xl text-base font-light leading-7 text-primary-foreground/70 lg:col-span-4">
        {t(locale, "programs.heroIntro")}
      </p>
    </Container>
  </header>

  <section class="bg-background py-16 sm:py-20 lg:py-28" aria-labelledby="program-list-heading">
    <Container>
      <div class="max-w-3xl border-b border-border pb-8">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
          {t(locale, "programs.listEyebrow")}
        </p>
        <h2
          id="program-list-heading"
          class="mt-4 text-balance text-3xl font-medium tracking-tight sm:text-4xl"
        >
          {t(locale, "programs.listTitle")}
        </h2>
      </div>

      <div class="divide-y divide-border">
        <article class="grid gap-8 py-12 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-4">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">
              {t(locale, "programs.checkupEyebrow")}
            </p>
            <h3 class="mt-4 max-w-sm text-3xl font-medium leading-tight">
              {t(locale, "programs.checkupTitle")}
            </h3>
          </div>

          <dl class="divide-y divide-border border-t border-border lg:col-span-8">
            <div class="grid gap-2 py-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-baseline sm:gap-8">
              <dt class="font-medium text-foreground">{t(locale, "programs.standard")}</dt>
              <dd class="font-serif text-2xl tabular-nums text-primary">300 UAH</dd>
            </div>
            <div class="grid gap-2 py-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-baseline sm:gap-8">
              <dt>
                <span class="block font-medium text-foreground">{t(locale, "programs.stepAhead")}</span>
                <span class="mt-1 block text-sm text-muted-foreground">
                  {t(locale, "programs.seniorProgram")}
                </span>
              </dt>
              <dd class="font-serif text-2xl tabular-nums text-primary">200 UAH</dd>
            </div>
          </dl>
        </article>

        <article class="grid gap-8 py-12 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-4">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">
              {t(locale, "programs.expressEyebrow")}
            </p>
            <h3 class="mt-4 max-w-sm text-3xl font-medium leading-tight">
              {t(locale, "programs.expressTitle")}
            </h3>
          </div>

          <dl class="divide-y divide-border border-t border-border lg:col-span-8">
            <div class="grid gap-2 py-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-baseline sm:gap-8">
              <dt class="text-sm leading-6 text-muted-foreground">{t(locale, "programs.formatLabel")}</dt>
              <dd class="font-serif text-xl text-foreground sm:text-right">
                {t(locale, "programs.formatValue")}
              </dd>
            </div>
            <div class="grid gap-2 py-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-baseline sm:gap-8">
              <dt class="text-sm leading-6 text-muted-foreground">{t(locale, "programs.testsLabel")}</dt>
              <dd class="text-sm leading-6 text-muted-foreground sm:text-right">
                {t(locale, "services.pending")}
              </dd>
            </div>
          </dl>
        </article>

        <article class="grid gap-8 py-12 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-4">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">
              {t(locale, "programs.pediatricEyebrow")}
            </p>
            <h3 class="mt-4 max-w-sm text-3xl font-medium leading-tight">
              {t(locale, "programs.pediatricTitle")}
            </h3>
          </div>

          <div class="border-t border-border pt-6 lg:col-span-8">
            <p class="max-w-2xl font-serif text-2xl leading-snug text-foreground sm:text-3xl">
              {t(locale, "programs.pediatricCopy")}
            </p>
            <dl class="mt-8 border-t border-border">
              <div class="grid gap-2 py-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-baseline sm:gap-8">
                <dt class="text-sm leading-6 text-muted-foreground">
                  {t(locale, "programs.registrationLabel")}
                </dt>
                <dd class="text-sm leading-6 text-muted-foreground sm:text-right">
                  {t(locale, "services.pending")}
                </dd>
              </div>
            </dl>
          </div>
        </article>
      </div>
    </Container>
  </section>

  <section class="border-t border-border bg-muted py-16 sm:py-20" aria-labelledby="program-action-heading">
    <Container class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-16">
      <div class="lg:col-span-7">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
          {t(locale, "programs.enquiriesEyebrow")}
        </p>
        <h2
          id="program-action-heading"
          class="mt-4 max-w-2xl text-balance text-3xl font-medium tracking-tight sm:text-4xl"
        >
          {t(locale, "programs.enquiriesTitle")}
        </h2>
        <p class="mt-5 max-w-xl text-sm leading-6 text-muted-foreground">
          {t(locale, "programs.relatedPrompt")} {" "}
          <a class="font-semibold text-primary underline underline-offset-4" href={localizePath("/services", locale)}>
            {t(locale, "programs.servicesLink")}
          </a>
          <span aria-hidden="true"> · </span>
          <a class="font-semibold text-primary underline underline-offset-4" href={localizePath("/shop", locale)}>
            {t(locale, "programs.shopLink")}
          </a>
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap lg:col-span-5 lg:justify-end">
        <a
          class="focus-ring-primary inline-flex min-h-12 items-center justify-center bg-primary px-6 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
          href={localizePath("/#appointment-form", locale)}
        >
          {t(locale, "programs.book")}
        </a>
        <a
          class="focus-ring-primary inline-flex min-h-12 items-center justify-center border border-primary px-6 text-sm font-semibold text-primary transition-colors hover:bg-primary hover:text-primary-foreground"
          href={clinicContact.phoneHref}
          aria-label={callAriaLabel}
        >
          {t(locale, "programs.call")}
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
