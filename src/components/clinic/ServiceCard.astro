---
import type { ServiceDetail } from "../../lib/cms";
import { defaultLocale, t, type Locale } from "../../lib/i18n";
import { getAppointmentHref } from "../../lib/navigation";

interface Props {
  readonly service: ServiceDetail;
  readonly number: string;
  readonly locale?: Locale;
  readonly class?: string;
}

const {
  service,
  number,
  locale = defaultLocale,
  class: className,
} = Astro.props;

const appointmentHref = getAppointmentHref(Astro.url.pathname, locale);
---

<article
  class:list={[
    "group flex h-full flex-col bg-card p-7 transition-colors duration-300 hover:bg-muted/45 sm:p-9 lg:p-11",
    className,
  ]}
>
  <!-- Верхній блок: номер + лінія зліва, великий SVG-символ справа -->
  <div class="flex items-center justify-between gap-4" aria-hidden="true">
    <div class="flex items-center gap-4">
      <span class="font-sans text-xs font-semibold tracking-[0.18em] text-primary">
        {number}
      </span>
      <span class="h-px w-10 bg-accent"></span>
    </div>

    <div class="text-primary/75 transition-all duration-300 group-hover:scale-110 group-hover:text-primary">
      {/* 1. Доросла офтальмологія — Око */}
      {service.slug === "adult" && (
        <svg
          class="size-11 sm:size-12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" />
          <circle cx="12" cy="12" r="3.5" />
          <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
          <path d="M12 2.5v1.5M12 20v1.5M2.5 12h1.5M20 12h1.5" stroke-width="1.2" opacity="0.6" />
        </svg>
      )}

      {/* 2. Дитяча офтальмологія — Малюк */}
      {service.slug === "pediatric" && (
        <svg
          class="size-11 sm:size-12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="13.5" r="7.5" />
          <path d="M12 6c.6-1.6 2-2.1 3-1.6" />
          <path d="M4.5 12a1.8 1.8 0 0 0 0 3M19.5 12a1.8 1.8 0 0 1 0 3" />
          <circle cx="9.5" cy="13" r="1" fill="currentColor" stroke="none" />
          <circle cx="14.5" cy="13" r="1" fill="currentColor" stroke="none" />
          <path d="M10 16.5c.8.8 2.2.8 3 0" />
        </svg>
      )}

      {/* 3. Хірургічний супровід — Медичний хрест */}
      {service.slug === "surgical" && (
        <svg
          class="size-11 sm:size-12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <path d="M12 7.5v9M7.5 12h9" stroke-width="2" />
        </svg>
      )}
    </div>
  </div>

  <!-- Нижній блок: Заголовок, опис, посилання -->
  <div class="mt-auto pt-16">
    <h3 class="max-w-lg text-3xl font-medium leading-tight tracking-tight text-card-foreground sm:text-4xl">
      {service.title}
    </h3>
    <p class="mt-5 max-w-xl text-sm leading-7 text-muted-foreground sm:text-base">
      {service.description}
    </p>
    <a
      class="mt-8 inline-flex min-h-11 items-center gap-3 text-sm font-semibold text-primary underline-offset-4 hover:underline"
      href={appointmentHref}
    >
      {t(locale, "actions.requestConsultation")}
      <span
        class="transition-transform duration-200 motion-safe:group-hover:translate-x-1"
        aria-hidden="true"
      >
        →
      </span>
    </a>
  </div>
</article>
