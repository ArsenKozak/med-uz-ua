---
import {
  defaultLocale,
  t,
  type Locale,
} from "../../lib/i18n";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
---

<section
  id="appointment-form"
  class="scroll-mt-6 rounded-2xl border border-border bg-card p-6 text-card-foreground shadow-concierge sm:p-8 lg:p-10"
  aria-labelledby="appointment-panel-title"
>
  <header class="border-b border-border pb-7">
    <p class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-primary">
      {t(locale, "appointment.eyebrow")}
    </p>
    <h2 id="appointment-panel-title" class="mt-3 text-3xl font-medium leading-tight tracking-tight sm:text-4xl">
      {t(locale, "appointment.title")}
    </h2>
    <p class="mt-4 max-w-md text-sm leading-6 text-muted-foreground">
      {t(locale, "appointment.description")}
    </p>
  </header>

  <form
    id="appointment-request-form"
    class="mt-8"
    method="post"
    action="/api/appointments"
    novalidate
    data-invalid-message={t(locale, "appointment.errorInvalid")}
    data-sending-message={t(locale, "appointment.sending")}
    data-pending-message={t(locale, "appointment.pending")}
    data-success-message={t(locale, "appointment.success")}
    data-request-error-message={t(locale, "appointment.errorRequest")}
  >
    <div class="grid gap-7">
      <div class="grid gap-1.5">
        <label
          class="text-xs font-semibold uppercase tracking-[0.14em] text-foreground/70"
          for="appointment-name"
        >
          {t(locale, "appointment.nameLabel")}
        </label>
        <input
          class="focus-ring-primary w-full rounded-none border-0 border-b border-foreground/50 bg-transparent px-0 py-3 text-base text-card-foreground outline-none transition-colors duration-200 placeholder:text-muted-foreground focus:border-primary focus:ring-0"
          id="appointment-name"
          name="name"
          type="text"
          minlength="2"
          maxlength="80"
          autocomplete="name"
          placeholder={t(locale, "appointment.namePlaceholder")}
          required
        />
      </div>

      <div class="grid gap-1.5">
        <label
          class="text-xs font-semibold uppercase tracking-[0.14em] text-foreground/70"
          for="appointment-phone"
        >
          {t(locale, "appointment.phoneLabel")}
        </label>
        <input
          class="focus-ring-primary w-full rounded-none border-0 border-b border-foreground/50 bg-transparent px-0 py-3 text-base text-card-foreground outline-none transition-colors duration-200 placeholder:text-muted-foreground focus:border-primary focus:ring-0"
          id="appointment-phone"
          name="phone"
          type="tel"
          minlength="10"
          maxlength="20"
          autocomplete="tel"
          inputmode="tel"
          placeholder={t(locale, "appointment.phonePlaceholder")}
          required
        />
      </div>

      <button
        class="focus-ring-primary mt-1 inline-flex min-h-13 w-full items-center justify-center rounded-lg bg-primary px-6 py-3.5 text-sm font-semibold text-primary-foreground transition-colors duration-200 hover:bg-primary/90 disabled:cursor-wait disabled:opacity-60"
        type="submit"
      >
        {t(locale, "appointment.submit")}
      </button>
    </div>

    <p
      class="mt-5 text-sm leading-6 text-muted-foreground"
      data-form-status
      data-state="idle"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      hidden
    ></p>
  </form>
</section>

<script>
  import { trackAppointmentSuccess } from "../../lib/analytics";

  type SuccessResponse = {
    ok: true;
  };

  const form = document.querySelector<HTMLFormElement>(
    "#appointment-request-form",
  );
  const statusElement =
    document.querySelector<HTMLElement>("[data-form-status]");
  const submitButton = form?.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );

  function isSuccessResponse(value: unknown): value is SuccessResponse {
    return (
      typeof value === "object" &&
      value !== null &&
      "ok" in value &&
      value.ok === true
    );
  }

  function showStatus(
    message: string,
    state: "pending" | "success" | "error",
  ): void {
    if (!statusElement) {
      return;
    }

    statusElement.textContent = message;
    statusElement.dataset.state = state;
    statusElement.hidden = false;
  }

  if (form && submitButton) {
    const defaultButtonText = submitButton.textContent;
    const invalidMessage = form.dataset.invalidMessage;
    const sendingMessage = form.dataset.sendingMessage;
    const pendingMessage = form.dataset.pendingMessage;
    const successMessage = form.dataset.successMessage;
    const requestErrorMessage = form.dataset.requestErrorMessage;

    if (
      invalidMessage === undefined ||
      sendingMessage === undefined ||
      pendingMessage === undefined ||
      successMessage === undefined ||
      requestErrorMessage === undefined
    ) {
      throw new Error("APPOINTMENT_TRANSLATIONS_MISSING");
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        showStatus(invalidMessage, "error");
        form.querySelector<HTMLInputElement>("input:invalid")?.focus();
        return;
      }

      const formData = new FormData(form);
      const name = formData.get("name");
      const phone = formData.get("phone");

      if (typeof name !== "string" || typeof phone !== "string") {
        showStatus(invalidMessage, "error");
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = sendingMessage;
      showStatus(pendingMessage, "pending");

      try {
        const response = await fetch("/api/appointments", {
          method: "POST",
          headers: {
            accept: "application/json",
            "content-type": "application/json",
          },
          body: JSON.stringify({ name, phone }),
        });
        const responseBody: unknown = await response.json();

        if (response.status !== 200 || !isSuccessResponse(responseBody)) {
          throw new Error("APPOINTMENT_REQUEST_FAILED");
        }

        form.reset();
        showStatus(successMessage, "success");
        trackAppointmentSuccess();
      } catch {
        showStatus(requestErrorMessage, "error");
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = defaultButtonText;
      }
    });
  }
</script>

<style>
  [data-form-status][data-state="success"] {
    color: var(--color-success);
  }

  [data-form-status][data-state="error"] {
    color: var(--color-danger);
  }
</style>
