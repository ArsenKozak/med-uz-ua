const localized = sliderTranslations[locale] ?? sliderTranslations.uk;
---

<section
  class="relative min-w-0 overflow-hidden border-b border-border bg-primary text-primary-foreground"
  aria-roledescription="carousel"
  aria-label={localized.sectionLabel}
  data-hero-slider
>
  <div class="relative w-full h-[55vw] min-h-[400px] sm:h-[50vw] sm:min-h-[460px] lg:h-[70vh] lg:min-h-[600px] xl:min-h-[700px] 2xl:min-h-[760px]">
    {
      localized.slides.map((slide, index) => (
        <article
          class={`absolute inset-0 transition-opacity duration-1000 ease-in-out ${
            index === 0
              ? "z-10 opacity-100"
              : "pointer-events-none z-0 opacity-0"
          }`}
          data-slider-slide={index}
          aria-hidden={index === 0 ? "false" : "true"}
        >
          <img
            class="size-full scale-100 object-cover object-center transition-transform duration-[6000ms] ease-out"
            src={index === 0 ? slide.image : undefined}
            data-src={slide.image}
            alt={`${slide.badge} — ${slide.title}`}
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "auto"}
            decoding="async"
            data-slide-image
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-primary/95 via-primary/50 to-primary/20"
            aria-hidden="true"
          />

          <div
            class="absolute inset-0 bg-gradient-to-r from-primary/90 via-primary/40 to-transparent"
            aria-hidden="true"
          />

          <Container class="relative z-10 flex h-full flex-col justify-end pb-12 pt-16 sm:pb-16 lg:pb-20">
            <div class="max-w-3xl">
              <span class="inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.24em] text-accent">
                <span
                  class="size-1.5 animate-pulse rounded-full bg-accent"
                  aria-hidden="true"
                />
                {slide.badge}
              </span>

              <h3 class="mt-3 text-balance font-serif text-2xl font-medium leading-[1.08] tracking-[-0.02em] text-primary-foreground sm:text-4xl lg:text-5xl">
                {slide.title}
              </h3>

              <p class="mt-3 max-w-xl text-sm leading-6 text-primary-foreground/80 sm:text-base sm:leading-7">
                {slide.subtitle}
              </p>
            </div>
          </Container>
        </article>
      ))
    }

    <Container class="pointer-events-none absolute inset-x-0 bottom-6 z-20 flex items-center justify-between sm:bottom-8 lg:bottom-10">
      <div
        class="pointer-events-auto flex items-center gap-1.5"
        data-slider-dots
      >
        {
          localized.slides.map((_, index) => (
            <button
              type="button"
              class="flex size-8 items-center justify-center rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              data-slider-dot={index}
              aria-label={`${localized.slideAria} ${index + 1}`}
            >
              <span
                data-slider-dot-indicator
                class={`h-1.5 rounded-full transition-all duration-500 ${
                  index === 0
                    ? "w-8 bg-accent"
                    : "w-2 bg-primary-foreground/40"
                }`}
                aria-hidden="true"
              />
            </button>
          ))
        }
      </div>

      <div class="pointer-events-auto flex items-center gap-3">
        <button
          type="button"
          class="flex size-11 items-center justify-center rounded-full border border-primary-foreground/25 bg-primary/60 text-primary-foreground backdrop-blur-md transition-all duration-300 hover:border-accent hover:bg-accent hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          data-slider-prev
          aria-label={localized.prevAria}
        >
          <svg
            class="size-4.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.75 19.5L8.25 12l7.5-7.5"
            />
          </svg>
        </button>

        <button
          type="button"
          class="flex size-11 items-center justify-center rounded-full border border-primary-foreground/25 bg-primary/60 text-primary-foreground backdrop-blur-md transition-all duration-300 hover:border-accent hover:bg-accent hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          data-slider-next
          aria-label={localized.nextAria}
        >
          <svg
            class="size-4.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8.25 4.5l7.5 7.5-7.5 7.5"
            />
          </svg>
        </button>
      </div>
    </Container>
  </div>
</section>

<script>
  function initializeHeroSliders(): void {
    const sliders =
      document.querySelectorAll<HTMLElement>("[data-hero-slider]");

    sliders.forEach((slider) => {
      if (slider.dataset.bound === "true") return;
      slider.dataset.bound = "true";

      const slides =
        slider.querySelectorAll<HTMLElement>("[data-slider-slide]");

      const dots =
        slider.querySelectorAll<HTMLElement>("[data-slider-dot]");

      const prevBtn =
        slider.querySelector<HTMLButtonElement>("[data-slider-prev]");

      const nextBtn =
        slider.querySelector<HTMLButtonElement>("[data-slider-next]");

      if (slides.length <= 1) return;

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      let activeIndex = 0;
      let autoplayTimer: number | null = null;
      let autoplayEnabled = false;

      function loadSlideImage(index: number): void {
        const slide = slides[index];
        if (!slide) return;
        const img = slide.querySelector<HTMLImageElement>("[data-slide-image]");
        if (img && !img.hasAttribute("src") && img.dataset.src) {
          img.src = img.dataset.src;
        }
      }

      function render(nextIndex: number): void {
        loadSlideImage(nextIndex);

        slides.forEach((slide, idx) => {
          const img =
            slide.querySelector<HTMLImageElement>("[data-slide-image]");

          if (idx === nextIndex) {
            slide.classList.remove(
              "opacity-0",
              "pointer-events-none",
              "z-0",
            );

            slide.classList.add("opacity-100", "z-10");
            slide.setAttribute("aria-hidden", "false");

            if (img && !prefersReducedMotion) {
              img.classList.add("scale-105");
            }
          } else {
            slide.classList.remove("opacity-100", "z-10");

            slide.classList.add(
              "opacity-0",
              "pointer-events-none",
              "z-0",
            );

            slide.setAttribute("aria-hidden", "true");

            if (img) {
              img.classList.remove("scale-105");
            }
          }
        });

        dots.forEach((dot, idx) => {
          const indicator =
            dot.querySelector<HTMLElement>("[data-slider-dot-indicator]");
          if (!indicator) return;

          if (idx === nextIndex) {
            indicator.className =
              "h-1.5 w-8 rounded-full bg-accent transition-all duration-500";
          } else {
            indicator.className =
              "h-1.5 w-2 rounded-full bg-primary-foreground/40 hover:bg-primary-foreground/75 transition-all duration-500";
          }
        });

        activeIndex = nextIndex;
      }

      function goNext(): void {
        render((activeIndex + 1) % slides.length);
      }

      function goPrev(): void {
        render((activeIndex - 1 + slides.length) % slides.length);
      }

      function stopAutoplay(): void {
        if (autoplayTimer !== null) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      function startAutoplay(): void {
        if (prefersReducedMotion || !autoplayEnabled) return;

        stopAutoplay();
        autoplayTimer = window.setInterval(goNext, 6000);
      }

      function enableAutoplay(): void {
        autoplayEnabled = true;
        startAutoplay();
      }

      nextBtn?.addEventListener("click", () => {
        goNext();
        enableAutoplay();
      });

      prevBtn?.addEventListener("click", () => {
        goPrev();
        enableAutoplay();
      });

      dots.forEach((dot, idx) => {
        dot.addEventListener("click", () => {
          render(idx);
          enableAutoplay();
        });
      });

      slider.addEventListener("mouseenter", stopAutoplay);
      slider.addEventListener("mouseleave", startAutoplay);
      slider.addEventListener("focusin", stopAutoplay);
      slider.addEventListener("focusout", stopAutoplay);
    });
  }

  initializeHeroSliders();

  document.addEventListener(
    "astro:page-load",
    initializeHeroSliders,
  );
</script>
