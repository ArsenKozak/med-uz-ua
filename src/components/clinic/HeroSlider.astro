    prevAria: "Predchádzajúci snímok",
    nextAria: "Nasledujúci snímok",
    slideAria: "Snímok",
    slides: [
      {
        image: clinicImageAssets.doctorInCabinet.src,
        badge: "Med.uz.ua",
        title: "Oftalmologické centrum v Užhorode",
        subtitle: "Profesionálna diagnostika zraku, konzultácie a individuálny prístup",
      },
      {
        image: clinicImageAssets.diagnosticConsultation.src,
        badge: "Presná diagnostika",
        title: "Špičkové prístrojové vybavenie",
        subtitle: "Komplexné hodnotenie zrakových funkcií a očného pozadia",
      },
      {
        image: clinicImageAssets.adultExamination.src,
        badge: "Oftalmológia",
