    sectionLabel: "Clinic Space Gallery",
    prevAria: "Previous slide",
    nextAria: "Next slide",
    slideAria: "Slide",
    slides: [
      {
        image: clinicImageAssets.doctorInCabinet.src,
        badge: "Med.uz.ua",
        title: "Ophthalmology Center in Uzhhorod",
        subtitle: "Professional eye diagnostics, consultations and personalized care",
      },
      {
        image: clinicImageAssets.diagnosticConsultation.src,
        badge: "Precision Care",
        title: "High-Precision Examination Tools",
        subtitle: "Comprehensive digital evaluation of visual acuity and retinal health",
      },
      {
        image: clinicImageAssets.adultExamination.src,
        badge: "Ophthalmology",
        title: "Care for Your Vision",
        subtitle: "A modern approach to eye diagnostics, prevention and vision correction",
      },
      {
        image: clinicImageAssets.pediatricExamination.src,
        badge: "Healthy Vision",
        title: "Attention to Every Detail",
        subtitle: "Comprehensive examinations and professional care for your eye health",
      },
      {
        image: siteImageAssets.clinicEditorial.src,
