---
interface Props {
  title?: string;
  src?: string;
}

const {
  title = "Med.uz.ua clinic address in Uzhhorod",
  src = "https://www.google.com/maps?q=%D0%B2%D1%83%D0%BB.%20%D0%AE%D1%80%D1%96%D1%8F%20%D0%93%D0%BE%D0%B9%D0%B4%D0%B8%2C%2010%D0%90%2C%20%D0%A3%D0%B6%D0%B3%D0%BE%D1%80%D0%BE%D0%B4%2C%20%D0%A3%D0%BA%D1%80%D0%B0%D1%97%D0%BD%D0%B0&output=embed",
} = Astro.props;
---

<div class="overflow-hidden border border-border bg-card">
  <iframe
    class="block aspect-video w-full border-0"
    src={src}
    title={title}
    width="800"
    height="450"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
</div>
