---
interface Props {
  title?: string;
  src?: string;
}

const {
  title = "Provisional Med.uz.ua clinic location in Uzhhorod",
  src = "https://www.google.com/maps?q=Uzhhorod%2C%20Ukraine&output=embed",
} = Astro.props;
---

<div class="overflow-hidden rounded-2xl border border-border bg-card">
  <iframe
    class="block aspect-video w-full border-0"
    src={src}
    title={title}
    width="800"
    height="450"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
</div>
