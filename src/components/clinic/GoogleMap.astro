---
import { clinicContact } from "../../lib/clinic";

interface Props {
  title?: string;
  src?: string;
  openHref?: string;
  openLabel?: string;
}

const {
  title = "European Ophthalmological Clinic address in Uzhhorod",
  src = clinicContact.mapEmbedHref,
  openHref = clinicContact.mapHref,
  openLabel = "Відкрити маршрут у Google Maps",
} = Astro.props;
---

<div class="group relative overflow-hidden rounded-2xl border border-border/80 bg-card shadow-xl shadow-primary/[0.04] transition-all duration-300 hover:shadow-2xl hover:shadow-primary/10 lg:rounded-3xl">
  <iframe
    class="block aspect-[16/10] w-full border-0 sm:aspect-[16/9]"
    src={src}
    title={title}
    width="800"
    height="450"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>

  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-border/80 bg-card/90 p-4 sm:p-5 backdrop-blur-xs">
    <div class="flex items-center gap-2.5 text-xs text-muted-foreground">
      <span class="size-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
      <span>м. Ужгород, вул. Юрія Гойди, 10А</span>
    </div>

    <a
      class="group/btn inline-flex min-h-12 w-full sm:w-auto items-center justify-center gap-2.5 rounded-xl bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-md shadow-primary/15 transition-all duration-300 hover:-translate-y-0.5 hover:bg-primary/95 hover:shadow-lg active:translate-y-0"
      href={openHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span>{openLabel}</span>
      <svg class="size-4 text-accent transition-transform duration-300 group-hover/btn:translate-x-1 group-hover/btn:-translate-y-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 3h8v8M13 3 3 13"></path>
      </svg>
    </a>
  </div>
</div>
