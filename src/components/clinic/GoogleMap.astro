---
import { clinicContact } from "../../lib/clinic";

interface Props {
  title?: string;
  src?: string;
  openHref?: string;
  openLabel?: string;
}

const {
  title = "European Ophthalmological Clinic address in Uzhhorod",
  src = clinicContact.mapEmbedHref,
  openHref = clinicContact.mapHref,
  openLabel = "Open route in Google Maps",
} = Astro.props;
---

<div class="overflow-hidden border border-border bg-card">
  <iframe
    class="block aspect-video w-full border-0"
    src={src}
    title={title}
    width="800"
    height="450"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
  <div class="border-t border-border p-4">
    <a
      class="focus-ring-primary inline-flex min-h-11 items-center text-sm font-semibold text-primary underline decoration-accent decoration-2 underline-offset-4"
      href={openHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      {openLabel}
      <svg class="ml-2 size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
        <path d="M5 3h8v8M13 3 3 13"></path>
      </svg>
    </a>
  </div>
</div>
