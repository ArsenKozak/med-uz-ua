      },
      {
        author: "Svitlana Fursaj",
        avatarType: "initials",
        avatarBg: "bg-rose-700",
        avatarText: "SF",
        reviewsCount: 11,
        isLocalGuide: false,
        text: "Ďakujem oftalmologičke Miroslave Jurijivne za pozorný, citlivý prístup a skutočne presnú diagnózu.",
      },
      {
        author: "Daša Lukjanec",
        avatarType: "initials",
        avatarBg: "bg-[#6A1B9A]",
        avatarText: "D",
        reviewsCount: 6,
