---
import Container from "../ui/Container.astro";
import type { Locale } from "../../lib/i18n";
import { reviewsConfiguration } from "../../lib/reviews/config";

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;

const copy = {
  uk: {
    eyebrow: "Відгуки та репутація",
    title: "Що говорять наші пацієнти",
    subtitle: "199+ підтверджених відгуків у Google із найвищою оцінкою 5.0",
    action: "Відкрити всі відгуки в Google Maps",
  },
  en: {
    eyebrow: "Reviews & Reputation",
    title: "What our patients say",
    subtitle: "199+ verified Google reviews with a 5.0 rating",
    action: "Open all reviews in Google Maps",
  },
  sk: {
    eyebrow: "Recenzie a reputácia",
    title: "Čo hovoria naši pacienti",
    subtitle: "199+ overených recenzií na Google s hodnotením 5.0",
    action: "Otvoriť recenzie v Google Maps",
  },
  hu: {
    eyebrow: "Vélemények és hírnév",
    title: "Mit mondanak pácienseink",
    subtitle: "199+ ellenőrzött Google vélemény 5.0 értékeléssel",
    action: "Vélemények megnyitása a Google Maps-en",
  },
} as const;

const localized = copy[locale];
---

<section
  class="min-w-0 border-t border-border bg-card py-16 sm:py-20 lg:py-24"
  aria-labelledby="reviews-panel-heading"
  data-google-reviews-panel
>
  <Container>
    <div class="mb-10 flex flex-col items-center text-center sm:mb-12">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
        {localized.eyebrow}
      </p>
      <h2
        id="reviews-panel-heading"
        class="mt-3 max-w-2xl text-balance text-3xl font-medium leading-tight tracking-tight text-foreground sm:text-4xl"
      >
        {localized.title}
      </h2>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted-foreground sm:text-base">
        {localized.subtitle}
      </p>
    </div>

    <!-- Контейнер для лінивого завантаження Trustindex -->
    <div class="min-h-[160px] w-full overflow-hidden" data-trustindex-slot>
      <!-- Скрипт завантажується динамічно при наближенні до viewport -->
    </div>

    <div class="mt-8 flex justify-center sm:mt-10">
      <a
        class="focus-ring-primary inline-flex min-h-11 items-center gap-2 border-b border-primary text-sm font-semibold text-primary underline-offset-4 hover:underline"
        href={reviewsConfiguration.googleBusinessProfileHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>{localized.action}</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </Container>
</section>

<script>
  function setupLazyTrustindex(): void {
    const panels = document.querySelectorAll<HTMLElement>("[data-google-reviews-panel]");

    panels.forEach((panel) => {
      if (panel.dataset.loaded === "true") return;

      const slot = panel.querySelector<HTMLElement>("[data-trustindex-slot]");
      if (!slot) return;

      const loadWidget = (): void => {
        if (panel.dataset.loaded === "true") return;
        panel.dataset.loaded = "true";

        const script = document.createElement("script");
        script.src = "https://cdn.trustindex.io/loader.js?2a8e43b79dad1161e706a179cb0";
        script.async = true;
        script.defer = true;
        slot.appendChild(script);
      };

      if (typeof IntersectionObserver !== "undefined") {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                obs.disconnect();
                loadWidget();
              }
            });
          },
          { rootMargin: "300px" }
        );
        observer.observe(panel);
      } else {
        loadWidget();
      }
    });
  }

  setupLazyTrustindex();
  document.addEventListener("astro:page-load", setupLazyTrustindex);
</script>
