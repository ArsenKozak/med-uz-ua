const localized = copy[locale];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  name: "Європейська Офтальмологія — Med.uz.ua",
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5.0",
    bestRating: "5",
    worstRating: "1",
    ratingCount: "199",
  },
};
---

<section
  class="relative min-w-0 overflow-hidden border-t border-border bg-gradient-to-b from-card via-background to-card py-16 sm:py-20 lg:py-24"
  aria-labelledby="reviews-panel-heading"
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <Container>
    <!-- Заголовок секції -->
    <div class="mb-12 flex flex-col items-center text-center sm:mb-16">
      <span class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3.5 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-primary">
        <svg class="size-3.5 fill-current text-amber-500" viewBox="0 0 24 24">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
        </svg>
        {localized.badge}
      </span>

      <h2
        id="reviews-panel-heading"
        class="mt-4 max-w-3xl text-balance font-serif text-3xl font-medium leading-tight tracking-tight text-foreground sm:text-4xl lg:text-5xl"
      >
        {localized.title}
      </h2>

      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">
        {localized.subtitle}
      </p>
    </div>

    <!-- Google Trust Badge плашка -->
    <div class="mx-auto mb-12 max-w-4xl rounded-2xl border border-border/80 bg-card p-6 shadow-sm sm:p-8">
      <div class="flex flex-col items-center justify-between gap-6 text-center md:flex-row md:text-left">
        <!-- Ліва частина: Google Logo + Score -->
        <div class="flex items-center gap-4">
          <div class="flex size-14 shrink-0 items-center justify-center rounded-2xl border border-border/60 bg-background shadow-inner">
            <svg class="size-7" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
            </svg>
          </div>

          <div>
            <div class="flex items-center justify-center gap-2 md:justify-start">
              <span class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">5.0</span>
              <div class="flex items-center gap-1 text-amber-500">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="size-5 fill-current" viewBox="0 0 24 24">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                  </svg>
                ))}
              </div>
            </div>
            <p class="mt-0.5 text-xs font-medium text-muted-foreground sm:text-sm">
              {localized.basedOn}
            </p>
          </div>
        </div>

        <div class="hidden h-12 w-px bg-border md:block" aria-hidden="true" />

        <!-- Середня частина: Верифікаційний бейдж -->
        <div class="flex flex-col items-center md:items-start">
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
            <svg class="size-4 fill-current" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            {localized.verifiedBadge}
          </span>
          <p class="mt-1 text-xs text-muted-foreground">
            {localized.ratingLabel} серед медичних центрів регіону
          </p>
        </div>

        <!-- Права частина: Кнопка дії -->
        <a
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-primary px-5 text-xs font-semibold text-primary-foreground shadow-sm transition-all duration-200 hover:bg-primary/90 active:scale-98 sm:text-sm"
          href={reviewsConfiguration.googleBusinessProfileHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>{localized.readAllAction}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- Сітка 6 реальних відгуків -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        localized.reviews.map((review) => (
          <article class="flex flex-col justify-between rounded-2xl border border-border/80 bg-card p-6 shadow-sm transition-all duration-300 hover:border-primary/40 hover:shadow-md">
            <div>
              <!-- Шапка картки: Аватар + Ім'я + Google Icon -->
              <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div
                    class={`relative flex size-10 shrink-0 items-center justify-center rounded-full font-medium text-white shadow-sm text-sm ${review.avatarBg}`}
                  >
                    <span>{review.avatarText}</span>
                    {review.isLocalGuide && (
                      <span
                        class="absolute -bottom-1 -right-1 flex size-4 items-center justify-center rounded-full bg-amber-500 text-[10px] text-white shadow"
                        title={localized.localGuideBadge}
                      >
                        ★
                      </span>
                    )}
                  </div>
                  <div>
                    <h3 class="text-sm font-semibold text-foreground">
                      {review.author}
                    </h3>
                    <p class="text-xs text-muted-foreground">
                      {review.isLocalGuide ? localized.localGuideBadge : `${review.reviewsCount} ${localized.reviewsCountText}`}
                    </p>
                  </div>
                </div>

                <svg class="size-4 shrink-0 opacity-75" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
                </svg>
              </div>

              <!-- Зірочки -->
              <div class="mt-4 flex items-center gap-1 text-amber-500">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="size-4 fill-current" viewBox="0 0 24 24">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                  </svg>
                ))}
              </div>

              <!-- Текст відгуку -->
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                "{review.text}"
              </p>
            </div>

            <!-- Футер картки: без відносних дат -->
            <div class="mt-5 flex items-center justify-between border-t border-border/50 pt-3 text-xs text-muted-foreground/70">
              <span class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400 font-medium">
                <svg class="size-3 fill-current" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                </svg>
                Google Maps
              </span>
              <span class="font-medium text-foreground/80">Оцінка 5.0 ★</span>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>
