---
import type { Locale } from "../../lib/i18n";
import { reviewsConfiguration } from "../../lib/reviews/config";

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const copy = {
  uk: {
    eyebrow: "Відгуки",
    title: "Відгуки — без вигаданих оцінок.",
    body: "Ми не копіюємо відгуки й не показуємо неперевірений рейтинг або кількість оцінок. Перейдіть до підтвердженого профілю клініки в Google, щоб переглянути доступні там відгуки або залишити власний.",
    action: "Переглянути або залишити відгук у Google",
  },
  en: {
    eyebrow: "Reviews",
    title: "Reviews, without invented ratings.",
    body: "We do not copy reviews or display an unverified score or count. Open the clinic’s confirmed Google profile to see the reviews available there or leave your own.",
    action: "View or leave a review on Google",
  },
  sk: {
    eyebrow: "Recenzie",
    title: "Recenzie bez vymysleného hodnotenia.",
    body: "Recenzie nekopírujeme a nezobrazujeme neoverené skóre ani počet hodnotení. V potvrdenom profile kliniky na Google si môžete pozrieť dostupné recenzie alebo pridať vlastnú.",
    action: "Pozrieť alebo pridať recenziu na Google",
  },
  hu: {
    eyebrow: "Vélemény",
    title: "Vélemények kitalált értékelések nélkül.",
    body: "Nem másolunk véleményeket, és nem mutatunk ellenőrizetlen pontszámot vagy darabszámot. A klinika megerősített Google-profilján megtekintheti az ott elérhető véleményeket, vagy írhat sajátot.",
    action: "Vélemények megtekintése vagy írása a Google-on",
  },
} as const;
const localized = copy[locale];
---

<section
  class="min-h-80 border border-border bg-card p-7 sm:p-10"
  aria-labelledby="reviews-panel-heading"
  data-google-reviews-panel
>
  <div class="grid min-w-0 gap-8 lg:grid-cols-12 lg:items-end">
    <div class="min-w-0 lg:col-span-8">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">
        {localized.eyebrow}
      </p>
      <h2
        id="reviews-panel-heading"
        class="mt-5 max-w-3xl break-words text-balance text-3xl font-medium leading-tight tracking-[-0.02em] sm:text-4xl"
      >
        {localized.title}
      </h2>
      <p class="mt-5 max-w-2xl text-sm leading-7 text-muted-foreground sm:text-base">
        {localized.body}
      </p>
    </div>

    <div class="min-w-0 lg:col-span-4 lg:justify-self-end">
      <a
        class="focus-ring-primary inline-flex min-h-12 w-full items-center justify-center bg-primary px-6 text-center text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 sm:w-auto"
        href={reviewsConfiguration.googleBusinessProfileHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        {localized.action}
      </a>
    </div>
  </div>
</section>
