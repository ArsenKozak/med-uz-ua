---
import { clinicContact } from "../../lib/clinic";
import {
  isNavigationItemActive,
  primaryNavigation,
  programsNavigation,
} from "../../lib/navigation";
import Container from "../ui/Container.astro";

const currentYear = new Date().getFullYear();
const pathname = Astro.url.pathname;
---

<footer class="bg-primary text-primary-foreground">
  <Container class="py-16 sm:py-20 lg:py-24">
    <div class="grid gap-12 border-b border-primary-foreground/15 pb-14 md:grid-cols-12">
      <div class="md:col-span-5 lg:col-span-6">
        <a
          class="inline-flex min-h-11 items-center font-serif text-3xl font-medium tracking-tight"
          href="/"
          aria-label="Med.uz.ua home"
        >
          Med.uz.ua
        </a>
        <p class="mt-5 max-w-sm text-sm leading-7 text-primary-foreground/65">
          A calm digital starting point for private ophthalmology care in
          {clinicContact.city}.
        </p>
      </div>

      <div class="md:col-span-4 lg:col-span-3">
        <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-primary-foreground/50">
          Clinic contact
        </h2>
        <address class="mt-5 text-sm not-italic leading-7 text-primary-foreground/75">
          <span class="block">
            {clinicContact.city}, {clinicContact.country}
          </span>
          <span class="block">{clinicContact.streetAddress}</span>
          <span class="block">{clinicContact.floor}</span>
          <a
            class="mt-2 inline-flex min-h-11 items-center border-b border-primary-foreground/25 transition-colors hover:border-primary-foreground hover:text-primary-foreground"
            href={clinicContact.phoneHref}
          >
            {clinicContact.phoneDisplay}
          </a>
        </address>
      </div>

      <nav class="md:col-span-3" aria-label="Footer navigation">
        <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-primary-foreground/50">
          Explore
        </h2>
        <ul class="mt-5 space-y-1 text-sm text-primary-foreground/75">
          {
            primaryNavigation.map((item) => {
              const isActive = isNavigationItemActive(pathname, item);

              return (
                <li>
                  <a
                    class:list={[
                      "inline-flex min-h-11 items-center border-b transition-colors hover:text-primary-foreground",
                      isActive
                        ? "border-accent text-primary-foreground"
                        : "border-transparent",
                    ]}
                    href={item.href}
                    aria-current={isActive ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
          <li>
            <a
              class="inline-flex min-h-11 items-center border-b border-transparent transition-colors hover:text-primary-foreground"
              href={programsNavigation.href}
            >
              {programsNavigation.label}
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="flex flex-col gap-3 pt-7 text-xs text-primary-foreground/50 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {currentYear} Med.uz.ua. All rights reserved.</p>
      <p>Designed for clarity, privacy, and calm.</p>
    </div>
  </Container>
</footer>
