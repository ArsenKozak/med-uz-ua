---
import { clinicContact } from "../../lib/clinic";
import { legalConfig } from "../../config/legal";
import {
  defaultLocale,
  localizePath,
  t,
  type Locale,
} from "../../lib/i18n";
import {
  isNavigationItemActive,
  normalizePathname,
  primaryNavigation,
  programsNavigation,
  type NavigationItem,
} from "../../lib/navigation";
import Container from "../ui/Container.astro";
import ClinicWordmark from "./ClinicWordmark.astro";
import SocialLinks from "./SocialLinks.astro";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const currentYear = new Date().getFullYear();
const pathname = Astro.url.pathname;
const legalLabels = {
  uk: { heading: "Правова інформація", offer: "Публічна оферта", privacy: "Конфіденційність", map: "Відкрити карту", analytics: "Налаштування аналітики" },
  en: { heading: "Legal", offer: "Public Offer", privacy: "Privacy Policy", map: "Open map", analytics: "Analytics settings" },
  sk: { heading: "Právne informácie", offer: "Verejná ponuka", privacy: "Ochrana súkromia", map: "Otvoriť mapu", analytics: "Nastavenia analytiky" },
  hu: { heading: "Jogi információ", offer: "Nyilvános ajánlat", privacy: "Adatvédelem", map: "Térkép megnyitása", analytics: "Analitikai beállítások" },
} as const;
const legalLabel = legalLabels[locale];
const brandHomeLabel = {
  uk: "European Ophthalmological Clinic — головна",
  en: "European Ophthalmological Clinic home",
  sk: "European Ophthalmological Clinic — domov",
  hu: "European Ophthalmological Clinic — kezdőlap",
} as const;

function getNavigationLabel(href: string): string {
  switch (href) {
    case "/services":
      return t(locale, "nav.services");
    case "/shop":
      return t(locale, "nav.shop");
    case "/about":
      return t(locale, "nav.about");
    case "/contacts":
      return t(locale, "nav.contacts");
    default:
      return href;
  }
}

const localizedPrimaryNavigation = primaryNavigation.map((item) => ({
  ...item,
  href: localizePath(item.href, locale),
  label: getNavigationLabel(item.href),
}));
const localizedProgramsNavigation = {
  ...programsNavigation,
  href: localizePath(programsNavigation.href, locale),
  label: t(locale, "nav.programs"),
};
const footerNavigation = [
  localizedPrimaryNavigation[0],
  localizedProgramsNavigation,
  ...localizedPrimaryNavigation.slice(1),
].filter((item) => item !== undefined);
function isFooterItemActive(item: NavigationItem): boolean {
  return isNavigationItemActive(pathname, item);
}

function isFooterItemCurrent(item: NavigationItem): boolean {
  return normalizePathname(pathname) === normalizePathname(item.href);
}
---

<footer class="bg-primary text-primary-foreground">
  <Container class="py-16 sm:py-20 lg:py-24">
    <div class="grid min-w-0 gap-10 border-b border-primary-foreground/15 pb-14 sm:grid-cols-2 lg:grid-cols-12 lg:gap-12">
      <div class="min-w-0 sm:col-span-2 lg:col-span-4">
        <a
          class="focus-ring-primary inline-flex min-h-11 min-w-0 items-center"
          href={localizePath("/", locale)}
          aria-label={brandHomeLabel[locale]}
        >
          <ClinicWordmark tone="ivory" />
        </a>
        <p class="mt-3 max-w-xs text-xs uppercase leading-5 tracking-[0.16em] text-primary-foreground/50">
          {t(locale, "clinic.publicName")}
        </p>
        <p class="mt-5 max-w-sm text-sm leading-7 text-primary-foreground/65">
          {t(locale, "footer.tagline")}
        </p>
      </div>

      <div class="min-w-0 lg:col-span-2">
        <h2 class="break-words font-sans text-xs font-semibold uppercase tracking-[0.18em] text-primary-foreground/50">
          {t(locale, "footer.contactHeading")}
        </h2>
        <address class="mt-5 text-sm not-italic leading-7 text-primary-foreground/75">
          <span class="block">{legalConfig.legalName}</span>
          <span class="block">{legalConfig.taxIdLabel}: {legalConfig.taxId}</span>
          <span class="block">{legalConfig.actualAddress}</span>
          <a class="mt-2 inline-flex min-h-11 items-center border-b border-primary-foreground/25 transition-colors hover:border-accent hover:text-accent" href={clinicContact.mapHref} target="_blank" rel="noopener noreferrer">
            {legalLabel.map}
          </a>
          <a
            class="mt-2 inline-flex min-h-11 items-center border-b border-primary-foreground/25 transition-colors hover:border-primary-foreground hover:text-primary-foreground"
            href={legalConfig.phoneHref}
          >
            {legalConfig.phoneDisplay}
          </a>
          <a
            class="mt-2 inline-flex min-h-11 max-w-full items-center break-all border-b border-primary-foreground/25 transition-colors hover:border-primary-foreground hover:text-primary-foreground"
            href={`mailto:${legalConfig.email}`}
          >
            {legalConfig.email}
          </a>
        </address>
      </div>

      <nav class="min-w-0 lg:col-span-2" aria-label={t(locale, "a11y.footerNavigation")}>
        <h2 class="break-words font-sans text-xs font-semibold uppercase tracking-[0.18em] text-primary-foreground/50">
          {t(locale, "footer.explore")}
        </h2>
        <ul class="mt-5 space-y-1 text-sm text-primary-foreground/75">
          {
            footerNavigation.map((item) => {
              const isActive = isFooterItemActive(item);
              const isCurrent = isFooterItemCurrent(item);

              return (
                <li>
                  <a
                    class:list={[
                      "inline-flex min-h-11 items-center border-b transition-colors hover:text-primary-foreground",
                      isActive
                        ? "border-accent text-primary-foreground"
                        : "border-transparent",
                    ]}
                    href={item.href}
                    aria-current={isCurrent ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="min-w-0 lg:col-span-2">
        <SocialLinks locale={locale} tone="light" compact />
      </div>

      <nav class="min-w-0 lg:col-span-2" aria-label={legalLabel.heading}>
        <h2 class="break-words font-sans text-xs font-semibold uppercase tracking-[0.18em] text-primary-foreground/50">
          {legalLabel.heading}
        </h2>
        <ul class="mt-5 space-y-1 text-sm text-primary-foreground/75">
          <li><a class="inline-flex min-h-11 items-center border-b border-transparent transition-colors hover:border-accent hover:text-accent" href={localizePath("/offer", locale)}>{legalLabel.offer}</a></li>
          <li><a class="inline-flex min-h-11 items-center border-b border-transparent transition-colors hover:border-accent hover:text-accent" href={localizePath("/privacy", locale)}>{legalLabel.privacy}</a></li>
          <li><button class="focus-ring-primary inline-flex min-h-11 items-center border-b border-transparent text-left transition-colors hover:border-accent hover:text-accent" type="button" data-analytics-settings>{legalLabel.analytics}</button></li>
        </ul>
      </nav>
    </div>

    <div class="flex flex-col gap-3 pt-7 text-xs text-primary-foreground/50 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {currentYear} {legalConfig.shortLegalName}</p>
      <p>{t(locale, "footer.closing")}</p>
    </div>
  </Container>
</footer>
