---
import { BOOKING_HREF, clinicContact } from "../../lib/clinic";
import { brandImageAssets } from "../../lib/assets";
import {
  defaultLocale,
  localizePath,
  t,
  type Locale,
} from "../../lib/i18n";
import {
  isNavigationItemActive,
  normalizePathname,
  type NavigationItem,
} from "../../lib/navigation";
import Container from "../ui/Container.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const pathname = Astro.url.pathname;
const currentPath = `${pathname}${Astro.url.search}`;
const bookingHref = localizePath(BOOKING_HREF, locale);

const headerNavigation: readonly NavigationItem[] = [
  {
    label: t(locale, "nav.services"),
    href: localizePath("/services", locale),
    match: "prefix",
  },
  {
    label: t(locale, "nav.programs"),
    href: localizePath("/services/programs", locale),
    match: "exact",
  },
  {
    label: t(locale, "nav.shop"),
    href: localizePath("/shop", locale),
    match: "exact",
  },
  {
    label: t(locale, "nav.about"),
    href: localizePath("/about", locale),
    match: "exact",
  },
  {
    label: t(locale, "nav.contacts"),
    href: localizePath("/contacts", locale),
    match: "exact",
  },
];
function isHeaderItemActive(item: NavigationItem): boolean {
  return isNavigationItemActive(pathname, item);
}

function isHeaderItemCurrent(item: NavigationItem): boolean {
  return normalizePathname(pathname) === normalizePathname(item.href);
}
const initialCartLabel = t(locale, "a11y.openCartMany").replace(
  "{count}",
  "0",
);
---

<header
  class="group sticky top-0 z-30 border-b border-border bg-background transition-[background-color,box-shadow] duration-200 data-[scrolled=true]:bg-background/95 data-[scrolled=true]:shadow-[0_8px_30px_rgb(6_44_48_/_0.08)] data-[scrolled=true]:backdrop-blur-sm"
  data-site-header
  data-scrolled="false"
>
  <Container class="flex h-20 items-center justify-between gap-2 transition-[height] duration-200 group-data-[scrolled=true]:h-16 xl:gap-4">
    <a
      class="focus-ring-primary inline-flex min-h-11 shrink-0 items-center font-serif text-[1.35rem] font-medium tracking-[-0.02em] text-primary sm:text-2xl"
      href={localizePath("/", locale)}
      aria-label={t(locale, "a11y.home")}
      data-logo-mark
    >
      <span
        class="inline-flex h-9 w-[3.7rem] shrink-0 sm:h-10 sm:w-[4.1rem]"
        data-logo-lens
      >
        <img
          class="size-full object-contain"
          src={brandImageAssets.legacyClinicMark.src}
          width={brandImageAssets.legacyClinicMark.width}
          height={brandImageAssets.legacyClinicMark.height}
          alt=""
          loading="eager"
          decoding="async"
        />
      </span>
      <span class="hidden sm:inline">Med.uz.ua</span>
      <span class="sm:hidden">Med</span>
    </a>

    <div class="flex min-w-0 items-center gap-2 xl:gap-3">
      <nav class="hidden xl:block" aria-label={t(locale, "a11y.primaryNavigation")}>
        <ul class="flex items-center gap-0.5">
          {
            headerNavigation.map((item) => {
              const isActive = isHeaderItemActive(item);
              const isCurrent = isHeaderItemCurrent(item);

              return (
                <li>
                  <a
                    class:list={[
                      "focus-ring-primary inline-flex min-h-11 items-center border-b-2 px-2 text-[0.8125rem] font-medium transition-colors duration-200 2xl:px-3 2xl:text-sm",
                      isActive
                        ? "border-accent text-primary"
                        : "border-transparent text-foreground/70 hover:border-border hover:text-primary",
                    ]}
                    href={item.href}
                    aria-current={isCurrent ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <LanguageSwitcher locale={locale} currentPath={currentPath} />

      <a
        class="focus-ring-primary hidden size-11 shrink-0 items-center justify-center border border-border bg-card text-primary transition-colors hover:border-primary hover:bg-muted xl:inline-flex"
        href={clinicContact.phoneHref}
        aria-label={t(locale, "a11y.callClinic", { phone: clinicContact.phoneDisplay })}
        title={clinicContact.phoneDisplay}
      >
        <svg
          class="size-[1.125rem]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M8.3 3.5 10.1 8 7.8 9.7a15 15 0 0 0 6.5 6.5l1.7-2.3 4.5 1.8v3.4a1.4 1.4 0 0 1-1.4 1.4A15.6 15.6 0 0 1 3.5 4.9a1.4 1.4 0 0 1 1.4-1.4h3.4Z"></path>
        </svg>
      </a>

      <button
        class="focus-ring-primary relative inline-flex size-11 shrink-0 items-center justify-center border border-border bg-card text-primary transition-colors duration-200 hover:bg-muted"
        type="button"
        aria-label={initialCartLabel}
        aria-haspopup="dialog"
        aria-controls="cart-dialog"
        data-cart-trigger
        data-cart-label-one={t(locale, "a11y.openCartOne")}
        data-cart-label-many={t(locale, "a11y.openCartMany")}
      >
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M6.75 8.25h10.5l-.75 10.5h-9l-.75-10.5Z"></path>
          <path d="M9 8.25V6a3 3 0 0 1 6 0v2.25"></path>
        </svg>
        <span
          class="absolute -right-1.5 -top-1.5 inline-flex min-h-5 min-w-5 items-center justify-center rounded-full bg-accent px-1 text-[0.65rem] font-bold leading-none text-primary"
          data-cart-count
          aria-hidden="true"
        >0</span>
      </button>

      <a
        class="focus-ring-primary hidden min-h-11 shrink-0 items-center justify-center bg-primary px-3 text-center text-xs font-semibold text-primary-foreground transition-colors duration-200 hover:bg-primary/90 xl:inline-flex 2xl:px-5 2xl:text-sm"
        href={bookingHref}
      >
        <span class="2xl:hidden">{t(locale, "actions.bookShort")}</span>
        <span class="hidden 2xl:inline">{t(locale, "actions.bookConsultation")}</span>
      </a>

      <details class="group relative xl:hidden" data-mobile-navigation>
        <summary
          class="focus-ring-primary inline-flex size-11 cursor-pointer list-none items-center justify-center border border-border bg-card text-primary transition-colors duration-200 hover:bg-muted [&::-webkit-details-marker]:hidden"
        >
          <span class="sr-only">{t(locale, "a11y.toggleNavigation")}</span>
          <svg
            class="size-5 group-open:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M4 7.5h16M4 12h16M4 16.5h16"></path>
          </svg>
          <svg
            class="hidden size-5 group-open:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </summary>

        <div
          class="absolute right-0 top-[calc(100%+0.75rem)] w-[min(20rem,calc(100vw-2.5rem))] border border-border bg-card p-3 shadow-concierge"
        >
          <nav aria-label={t(locale, "a11y.mobileNavigation")}>
            <ul class="space-y-1">
              {
                headerNavigation.map((item) => {
                  const isActive = isHeaderItemActive(item);
                  const isCurrent = isHeaderItemCurrent(item);

                  return (
                    <li>
                      <a
                        class:list={[
                          "focus-ring-primary flex min-h-12 items-center border-l-2 px-4 text-sm font-medium transition-colors duration-200",
                          isActive
                            ? "border-accent bg-muted text-primary"
                            : "border-transparent text-foreground/75 hover:bg-muted hover:text-primary",
                        ]}
                        href={item.href}
                        aria-current={isCurrent ? "page" : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </nav>

          <a
            class="focus-ring-primary mt-3 flex min-h-12 items-center justify-center border border-primary px-5 text-center text-sm font-semibold text-primary transition-colors hover:bg-primary hover:text-primary-foreground"
            href={clinicContact.phoneHref}
          >
            {clinicContact.phoneDisplay}
          </a>
          <a
            class="focus-ring-primary mt-2 inline-flex min-h-12 w-full items-center justify-center bg-primary px-5 text-center text-sm font-semibold text-primary-foreground transition-colors duration-200 hover:bg-primary/90"
            href={bookingHref}
          >
            {t(locale, "actions.bookConsultation")}
          </a>
        </div>
      </details>
    </div>
  </Container>
</header>

<script>
  import { $cartCount } from "../../store/cart";

  for (const header of document.querySelectorAll<HTMLElement>(
    "[data-site-header]",
  )) {
    if (header.dataset.scrollBound === "true") {
      continue;
    }

    header.dataset.scrollBound = "true";
    let animationFrame = 0;

    const updateScrollState = (): void => {
      animationFrame = 0;
      header.dataset.scrolled = String(window.scrollY > 24);
    };

    const scheduleScrollState = (): void => {
      if (animationFrame === 0) {
        animationFrame = window.requestAnimationFrame(updateScrollState);
      }
    };

    updateScrollState();
    window.addEventListener("scroll", scheduleScrollState, { passive: true });
  }

  const countElements = document.querySelectorAll<HTMLElement>(
    "[data-cart-count]",
  );
  const cartTriggers = document.querySelectorAll<HTMLButtonElement>(
    "button[data-cart-trigger]",
  );

  $cartCount.subscribe((count) => {
    for (const element of countElements) {
      element.textContent = String(count);
    }

    for (const trigger of cartTriggers) {
      const labelTemplate =
        count === 1
          ? trigger.dataset.cartLabelOne
          : trigger.dataset.cartLabelMany;

      if (labelTemplate === undefined) {
        continue;
      }

      trigger.setAttribute(
        "aria-label",
        labelTemplate.replace("{count}", String(count)),
      );
    }
  });

  const mobileMenus = document.querySelectorAll<HTMLDetailsElement>(
    "details[data-mobile-navigation]",
  );

  for (const menu of mobileMenus) {
    const summary = menu.querySelector<HTMLElement>("summary");

    menu.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !menu.open) return;

      event.preventDefault();
      menu.open = false;
      summary?.focus();
    });

    menu.addEventListener("click", (event) => {
      const target = event.target;

      if (target instanceof Element && target.closest("a")) {
        menu.open = false;
      }
    });

    document.addEventListener("pointerdown", (event) => {
      const target = event.target;

      if (menu.open && target instanceof Node && !menu.contains(target)) {
        menu.open = false;
      }
    });
  }
</script>
