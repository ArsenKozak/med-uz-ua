---
import { Image } from "astro:assets";
import logoMarkImg from "../../assets/critical/logo_oft1.png";
import { clinicContact } from "../../lib/clinic";
import {
  defaultLocale,
  localizePath,
  t,
  type Locale,
} from "../../lib/i18n";
import {
  getAppointmentHref,
  isNavigationItemActive,
  normalizePathname,
  type NavigationItem,
} from "../../lib/navigation";
import Container from "../ui/Container.astro";
import ClinicWordmark from "./ClinicWordmark.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const pathname = Astro.url.pathname;
const currentPath = `${pathname}${Astro.url.search}`;
const bookingHref = getAppointmentHref(pathname, locale);
const brandHomeLabel = {
  uk: "European Ophthalmological Clinic — головна",
  en: "European Ophthalmological Clinic home",
  sk: "European Ophthalmological Clinic — domov",
  hu: "European Ophthalmological Clinic — kezdőlap",
} as const;

const SHOW_SPECIAL_PROGRAMS = false;

const headerNavigation: readonly NavigationItem[] = [
  {
    label: t(locale, "nav.services"),
    href: localizePath("/services", locale),
    match: "prefix",
  },
  ...(SHOW_SPECIAL_PROGRAMS
    ? [
        {
          label: t(locale, "nav.programs"),
          href: localizePath("/services/programs", locale),
          match: "exact" as const,
        },
      ]
    : []),
  {
    label: t(locale, "nav.shop"),
    href: localizePath("/shop", locale),
    match: "exact",
  },
  {
    label: t(locale, "nav.about"),
    href: localizePath("/about", locale),
    match: "exact",
  },
  {
    label: t(locale, "nav.contacts"),
    href: localizePath("/contacts", locale),
    match: "exact",
  },
];

function isHeaderItemActive(item: NavigationItem): boolean {
  return isNavigationItemActive(pathname, item);
}

function isHeaderItemCurrent(item: NavigationItem): boolean {
  return normalizePathname(pathname) === normalizePathname(item.href);
}

const initialCartLabel = t(locale, "a11y.openCartMany").replace(
  "{count}",
  "0",
);
---

<header
  class="group sticky top-0 z-30 border-b border-border bg-background transition-[background-color,box-shadow] duration-200 data-[scrolled=true]:bg-background/95 data-[scrolled=true]:shadow-[0_8px_30px_rgb(6_44_48_/_0.08)] data-[scrolled=true]:backdrop-blur-sm"
  data-site-header
  data-scrolled="false"
>
  <Container class="flex h-20 items-center justify-between gap-3 transition-[height] duration-200 group-data-[scrolled=true]:h-16 xl:gap-5">
    <a
      class="focus-ring-primary inline-flex min-h-12 min-w-0 shrink items-center gap-2.5 text-primary sm:gap-3.5"
      href={localizePath("/", locale)}
      aria-label={brandHomeLabel[locale]}
      data-logo-mark
    >
      <Image
        src={logoMarkImg}
        alt=""
        aria-hidden="true"
        width={80}
        quality={85}
        format="webp"
        loading="eager"
        decoding="async"
        class="h-9 w-auto shrink-0 object-contain sm:h-10"
      />
      <ClinicWordmark compact />
    </a>

    <div class="flex min-w-0 shrink-0 items-center gap-2 sm:gap-2.5 xl:gap-3.5">
      <!-- Десктопна навігація -->
      <nav class="hidden xl:block" aria-label={t(locale, "a11y.primaryNavigation")}>
        <ul class="flex items-center gap-1">
          {
            headerNavigation.map((item) => {
              const isActive = isHeaderItemActive(item);
              const isCurrent = isHeaderItemCurrent(item);

              return (
                <li>
                  <a
                    class:list={[
                      "focus-ring-primary inline-flex min-h-12 items-center border-b-2 px-3 text-sm font-medium transition-colors duration-200 2xl:px-4 2xl:text-base",
                      isActive
                        ? "border-accent text-primary"
                        : "border-transparent text-foreground/75 hover:border-border hover:text-primary",
                    ]}
                    href={item.href}
                    aria-current={isCurrent ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <!-- Мовний перемикач -->
      <LanguageSwitcher locale={locale} currentPath={currentPath} />

      <!-- Кнопка дзвінка -->
      <a
        class="focus-ring-primary hidden size-12 2xl:size-[3.25rem] shrink-0 items-center justify-center rounded-xl border border-border/80 bg-card text-primary shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-primary hover:bg-primary hover:text-primary-foreground hover:shadow-md active:translate-y-0 xl:inline-flex"
        href={clinicContact.phoneHref}
        aria-label={t(locale, "a11y.callClinic", { phone: clinicContact.phoneDisplay })}
        title={clinicContact.phoneDisplay}
      >
        <svg
          class="size-5 2xl:size-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M8.3 3.5 10.1 8 7.8 9.7a15 15 0 0 0 6.5 6.5l1.7-2.3 4.5 1.8v3.4a1.4 1.4 0 0 1-1.4 1.4A15.6 15.6 0 0 1 3.5 4.9a1.4 1.4 0 0 1 1.4-1.4h3.4Z"></path>
        </svg>
      </a>

      <!-- Кнопка кошика -->
      <button
        class="focus-ring-primary relative inline-flex size-12 2xl:size-[3.25rem] shrink-0 items-center justify-center rounded-xl border border-border/80 bg-card text-primary shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-primary hover:bg-muted hover:shadow-md active:translate-y-0"
        type="button"
        aria-label={initialCartLabel}
        aria-haspopup="dialog"
        aria-controls="cart-dialog"
        data-cart-trigger
        data-cart-label-one={t(locale, "a11y.openCartOne")}
        data-cart-label-many={t(locale, "a11y.openCartMany")}
      >
        <svg
          class="size-5.5 2xl:size-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M6.75 8.25h10.5l-.75 10.5h-9l-.75-10.5Z"></path>
          <path d="M9 8.25V6a3 3 0 0 1 6 0v2.25"></path>
        </svg>
        <span
          class="absolute -right-1 -top-1 inline-flex min-h-5.5 min-w-5.5 items-center justify-center rounded-full bg-accent px-1.5 text-xs font-bold leading-none text-primary shadow-xs"
          data-cart-count
          aria-hidden="true"
        >0</span>
      </button>

      <!-- Головна кнопка CTA -->
      <a
        class="focus-ring-primary hidden min-h-12 2xl:min-h-[3.25rem] shrink-0 items-center justify-center rounded-xl bg-primary px-5 xl:px-6 2xl:px-8 text-center text-sm font-semibold text-primary-foreground shadow-md shadow-primary/15 transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary/95 hover:shadow-lg hover:shadow-primary/25 active:translate-y-0 xl:inline-flex 2xl:text-base"
        href={bookingHref}
      >
        <span>{t(locale, "actions.bookConsultation")}</span>
      </a>

      <!-- Бургер -->
      <button
        type="button"
        class="focus-ring-primary inline-flex size-12 items-center justify-center rounded-xl border border-border bg-card text-primary shadow-xs transition-colors duration-200 hover:bg-muted xl:hidden"
        aria-label={t(locale, "a11y.toggleNavigation")}
        aria-expanded="false"
        aria-controls="mobile-navigation-drawer"
        aria-haspopup="dialog"
        data-mobile-menu-trigger
      >
        <svg
          class="size-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 7.5h16M4 12h16M4 16.5h16"></path>
        </svg>
      </button>
    </div>
  </Container>

  <!-- Мобільне меню -->
  <div
    id="mobile-navigation-drawer"
    class="fixed inset-0 z-[9999] hidden h-[100dvh] w-screen"
    role="dialog"
    aria-modal="true"
    aria-label={t(locale, "a11y.mobileNavigation")}
    data-mobile-drawer
  >
    <!-- Затемнення фону -->
    <div
      class="fixed inset-0 bg-black/75 backdrop-blur-xs transition-opacity duration-300 opacity-0"
      data-drawer-backdrop
    ></div>

    <!-- Виїзна панель меню (100% непрозорий моноліт) -->
    <aside
      class="fixed inset-y-0 right-0 z-10 flex h-[100dvh] w-full max-w-sm flex-col justify-between border-l border-white/10 p-6 text-white shadow-2xl transition-transform duration-300 ease-out translate-x-full sm:max-w-md sm:p-8 overflow-y-auto"
      data-drawer-panel
      style="background-color: #062c30 !important; opacity: 1 !important;"
    >
      <div class="flex items-center justify-between border-b border-white/10 pb-5 shrink-0">
        <div class="flex items-center gap-3 min-w-0 pr-2">
          <img
            src="/favicon.svg"
            alt=""
            aria-hidden="true"
            class="size-7 shrink-0 object-contain"
          />
          <span class="font-serif text-xs sm:text-sm font-medium tracking-wide text-white line-clamp-2">
            Європейська офтальмологічна клініка
          </span>
        </div>

        <button
          type="button"
          class="flex size-11 items-center justify-center rounded-full border border-white/20 text-white transition-colors hover:border-accent hover:bg-accent hover:text-[#062c30] focus:outline-none"
          data-drawer-close
          aria-label="Закрити меню"
        >
          <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <nav class="py-8 my-auto shrink-0" aria-label={t(locale, "a11y.mobileNavigation")}>
        <ul class="space-y-4">
          {
            headerNavigation.map((item, index) => {
              const isActive = isHeaderItemActive(item);
              const isCurrent = isHeaderItemCurrent(item);

              return (
                <li>
                  <a
                    class:list={[
                      "group flex min-h-12 items-center justify-between border-b border-white/10 px-2 py-3 transition-colors duration-200",
                      isActive
                        ? "text-accent"
                        : "text-white/90 hover:text-accent",
                    ]}
                    href={item.href}
                    aria-current={isCurrent ? "page" : undefined}
                    data-drawer-link
                  >
                    <div class="flex items-baseline gap-3">
                      <span class="text-xs font-semibold tabular-nums tracking-widest text-white/40 group-hover:text-accent">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                      <span class="font-serif text-2xl font-medium tracking-tight">
                        {item.label}
                      </span>
                    </div>

                    <svg
                      class="size-4 opacity-40 transition-transform duration-200 group-hover:translate-x-1 group-hover:opacity-100"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="space-y-3 border-t border-white/10 pt-6 shrink-0">
        <a
          class="flex min-h-12 items-center justify-center gap-2.5 rounded-xl border border-white/20 px-4 text-center text-sm font-semibold text-white transition-colors hover:border-accent hover:text-accent"
          href={clinicContact.phoneHref}
          data-drawer-link
        >
          <svg class="size-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.3 3.5 10.1 8 7.8 9.7a15 15 0 0 0 6.5 6.5l1.7-2.3 4.5 1.8v3.4a1.4 1.4 0 0 1-1.4 1.4A15.6 15.6 0 0 1 3.5 4.9a1.4 1.4 0 0 1 1.4-1.4h3.4Z"></path>
          </svg>
          <span>{clinicContact.phoneDisplay}</span>
        </a>

        <a
          class="flex min-h-13 w-full items-center justify-center rounded-xl bg-white px-5 text-center text-sm font-semibold text-[#062c30] shadow-md transition-all duration-200 hover:bg-accent hover:text-[#062c30] active:scale-98"
          href={bookingHref}
          data-drawer-link
        >
          {t(locale, "actions.bookConsultation")}
        </a>
      </div>
    </aside>
  </div>
</header>

<script>
  import { $cartCount } from "../../store/cart";

  function initHeaderAndDrawer() {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    if (header && header.dataset.scrollBound !== "true") {
      header.dataset.scrollBound = "true";
      let animationFrame = 0;

      const updateScrollState = (): void => {
        animationFrame = 0;
        header.dataset.scrolled = String(window.scrollY > 24);
      };

      const scheduleScrollState = (): void => {
        if (animationFrame === 0) {
          animationFrame = window.requestAnimationFrame(updateScrollState);
        }
      };

      updateScrollState();
      window.addEventListener("scroll", scheduleScrollState, { passive: true });
    }

    const trigger = document.querySelector<HTMLButtonElement>("[data-mobile-menu-trigger]");
    const drawer = document.querySelector<HTMLElement>("[data-mobile-drawer]");
    const backdrop = document.querySelector<HTMLElement>("[data-drawer-backdrop]");
    const panel = document.querySelector<HTMLElement>("[data-drawer-panel]");
    const closeBtn = document.querySelector<HTMLButtonElement>("[data-drawer-close]");
    const drawerLinks = document.querySelectorAll<HTMLElement>("[data-drawer-link]");

    if (!trigger || !drawer || !backdrop || !panel) return;

    // Телепортуємо дровер безпосередньо в <body>, щоб вийти з CSS-пастки хедера
    if (drawer.parentElement !== document.body) {
      document.body.appendChild(drawer);
    }

    function openMenu() {
      if (!drawer || !backdrop || !panel) return;
      drawer.classList.remove("hidden");
      
      // Примусовий reflow перед запуском CSS-анімації
      void drawer.offsetWidth;

      backdrop.classList.remove("opacity-0");
      backdrop.classList.add("opacity-100");
      panel.classList.remove("translate-x-full");
      panel.classList.add("translate-x-0");

      trigger?.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      closeBtn?.focus({ preventScroll: true });
    }

    function closeMenu() {
      if (!drawer || !backdrop || !panel) return;
      backdrop.classList.remove("opacity-100");
      backdrop.classList.add("opacity-0");
      panel.classList.remove("translate-x-0");
      panel.classList.add("translate-x-full");

      setTimeout(() => {
        drawer.classList.add("hidden");
        document.body.style.overflow = "";
      }, 300);

      trigger?.setAttribute("aria-expanded", "false");
    }

    trigger.onclick = openMenu;
    if (closeBtn) closeBtn.onclick = closeMenu;
    backdrop.onclick = closeMenu;

    drawerLinks.forEach((link) => {
      link.onclick = closeMenu;
    });

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !drawer.classList.contains("hidden")) {
        closeMenu();
      }
    });
  }

  const countElements = document.querySelectorAll<HTMLElement>("[data-cart-count]");
  const cartTriggers = document.querySelectorAll<HTMLButtonElement>("button[data-cart-trigger]");

  $cartCount.subscribe((count) => {
    for (const element of countElements) {
      element.textContent = String(count);
    }
    for (const trigger of cartTriggers) {
      const labelTemplate = count === 1 ? trigger.dataset.cartLabelOne : trigger.dataset.cartLabelMany;
      if (labelTemplate) {
        trigger.setAttribute("aria-label", labelTemplate.replace("{count}", String(count)));
      }
    }
  });

  initHeaderAndDrawer();
  document.addEventListener("astro:page-load", initHeaderAndDrawer);
</script>
