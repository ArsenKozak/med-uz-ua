---
import { socialChannels } from "../../lib/clinic";
import type { Locale } from "../../lib/i18n";

interface Props {
  readonly locale: Locale;
  readonly tone?: "light" | "dark";
  readonly compact?: boolean;
}

const { locale, tone = "dark", compact = false } = Astro.props;

const localizedCopy = {
  uk: { heading: "Соціальні мережі", open: "Відкрити профіль {channel}" },
  en: { heading: "Social networks", open: "Open the {channel} profile" },
  sk: { heading: "Sociálne siete", open: "Otvoriť profil {channel}" },
  hu: { heading: "Közösségi oldalak", open: "A(z) {channel} profil megnyitása" },
} as const;
const copy = localizedCopy[locale];
const instagramGradientId = compact
  ? "instagram-icon-compact"
  : "instagram-icon-full";
---

<div>
  <h2 class:list={["break-words font-sans text-xs font-semibold uppercase tracking-[0.18em]", tone === "light" ? "text-primary-foreground/60" : "text-primary"]}>
    {copy.heading}
  </h2>
  <ul class:list={["mt-5", compact ? "space-y-1" : "grid gap-3 sm:grid-cols-3"]}>
    {
      socialChannels.map((channel) => (
        <li>
          <a
            class:list={[
              "focus-ring-primary group flex min-h-12 min-w-0 items-center gap-3 border px-4 py-2 text-sm font-semibold transition-colors",
              tone === "light"
                ? "border-primary-foreground/20 text-primary-foreground hover:border-accent hover:text-accent"
                : "border-border bg-card text-primary hover:border-primary hover:bg-muted",
            ]}
            href={channel.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={copy.open.replace("{channel}", channel.label)}
          >
            <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-white shadow-[0_5px_14px_rgb(0_0_0_/_0.16)]">
              {
                channel.id === "instagram" ? (
                  <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true" focusable="false">
                    <defs>
                      <linearGradient id={instagramGradientId} x1="2" y1="22" x2="22" y2="2">
                        <stop stop-color="#feda75"></stop>
                        <stop offset="0.45" stop-color="#d62976"></stop>
                        <stop offset="1" stop-color="#4f5bd5"></stop>
                      </linearGradient>
                    </defs>
                    <rect x="3" y="3" width="18" height="18" rx="5" fill={`url(#${instagramGradientId})`}></rect>
                    <circle cx="12" cy="12" r="4" fill="none" stroke="white" stroke-width="1.7"></circle>
                    <circle cx="17.2" cy="6.8" r="1.1" fill="white"></circle>
                  </svg>
                ) : channel.id === "tiktok" ? (
                  <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true" focusable="false">
                    <path d="M14.3 3v11.2a4.4 4.4 0 1 1-3.8-4.36v2.6a1.9 1.9 0 1 0 1.3 1.8V3h2.5Z" fill="#25f4ee" transform="translate(-.7 .4)"></path>
                    <path d="M15.1 3c.25 2.1 1.42 3.3 3.4 3.75v2.57a7.2 7.2 0 0 1-3.4-1.03v6a4.4 4.4 0 1 1-4.5-4.4v2.55a1.9 1.9 0 1 0 1.98 1.85V3h2.52Z" fill="#fe2c55" transform="translate(.6 -.25)"></path>
                    <path d="M14.6 3c.25 2.1 1.42 3.3 3.4 3.75v2.2a7.2 7.2 0 0 1-3.4-1.03v6.37a4.4 4.4 0 1 1-3.8-4.36v2.5a1.9 1.9 0 1 0 1.3 1.86V3h2.5Z" fill="#111"></path>
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="10" fill="#1877f2"></circle>
                    <path d="M13.45 20v-7h2.35l.35-2.72h-2.7V8.54c0-.79.22-1.33 1.35-1.33h1.44V4.78c-.25-.03-1.1-.1-2.1-.1-2.08 0-3.5 1.27-3.5 3.6v2H8.3V13h2.34v7h2.81Z" fill="white"></path>
                  </svg>
                )
              }
            </span>
            <span class="min-w-0 break-words">{channel.label}</span>
            <svg class="ml-auto size-4 shrink-0 transition-transform motion-safe:group-hover:-translate-y-0.5 motion-safe:group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
              <path d="M5 3h8v8M13 3 3 13"></path>
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</div>
