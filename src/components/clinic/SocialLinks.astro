---
import { socialChannels } from "../../lib/clinic";
import type { Locale } from "../../lib/i18n";

interface Props {
  locale?: Locale;
}

const { locale } = Astro.props;
---

<div class="flex flex-wrap items-center gap-3">
  {
    socialChannels.map((channel) => {
      const isInstagram = channel.id === "instagram";
      const isTiktok = channel.id === "tiktok";
      const isFacebook = channel.id === "facebook";

      return (
        <a
          class:list={[
            "group inline-flex min-h-12 items-center gap-3 rounded-xl border border-border/80 bg-card px-5 text-sm font-semibold text-foreground shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md active:translate-y-0",
            isInstagram && "hover:border-pink-500/50 hover:bg-pink-50/40 hover:text-pink-600",
            isTiktok && "hover:border-black/50 hover:bg-neutral-50 hover:text-foreground",
            isFacebook && "hover:border-blue-600/50 hover:bg-blue-50/40 hover:text-blue-700",
          ]}
          href={channel.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          {isInstagram && (
            <span class="flex size-7 items-center justify-center rounded-full bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 text-white shadow-xs">
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
              </svg>
            </span>
          )}

          {isTiktok && (
            <span class="flex size-7 items-center justify-center rounded-full bg-black text-white shadow-xs">
              <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.47 6.27 6.27 0 0 0 1.95-4.47V8.17a8.27 8.27 0 0 0 4.82 1.52V6.69h-1z"></path>
              </svg>
            </span>
          )}

          {isFacebook && (
            <span class="flex size-7 items-center justify-center rounded-full bg-[#1877F2] text-white shadow-xs">
              <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
              </svg>
            </span>
          )}

          <span>{channel.label}</span>
          <span class="text-xs text-muted-foreground transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
        </a>
      );
    })
  }
</div>
