---
import { t, type Locale, type TranslationKey } from "../../lib/i18n";
import { wayfindingAssets } from "../../lib/assets";

interface Props {
  locale: Locale;
}

interface WayfindingStep {
  readonly titleKey: TranslationKey;
  readonly bodyKey: TranslationKey;
}

const { locale } = Astro.props;
const steps: readonly WayfindingStep[] = [
  {
    titleKey: "wayfinding.atbTitle",
    bodyKey: "wayfinding.atbBody",
  },
  {
    titleKey: "wayfinding.entranceTitle",
    bodyKey: "wayfinding.entranceBody",
  },
  {
    titleKey: "wayfinding.floorTitle",
    bodyKey: "wayfinding.floorBody",
  },
  {
    titleKey: "wayfinding.clinicTitle",
    bodyKey: "wayfinding.clinicBody",
  },
];

const images = wayfindingAssets.slice(0, 2);

const localizedImageCopy = {
  uk: {
    alt: [
      "Вхід до будівлі поруч із вивіскою супермаркету АТБ",
      "Орієнтир біля АТБ із нанесеними підказками до входу",
    ],
    caption: [
      "Головний орієнтир: фасад будівлі біля супермаркету АТБ. Вхідні двері розташовані одразу ліворуч від вивіски.",
      "Вхід до клініки: заходьте через скляні двері та піднімайтеся на 2-й поверх до рецепції.",
    ],
  },
  en: {
    alt: [
      "Building entrance beside an ATB supermarket sign",
      "ATB landmark with directional clues to the entrance",
    ],
    caption: [
      "Main landmark: the modern building facade right next to ATB. The entrance is located immediately to the left.",
      "Clinic entrance: step through the glass doors and head up to the 2nd floor reception.",
    ],
  },
  sk: {
    alt: [
      "Vstup do budovy vedľa označenia supermarketu ATB",
      "Orientačný bod ATB so smerovými tipmi ku vchodu",
    ],
    caption: [
      "Hlavný orientačný bod: fasáda budovy priamo vedľa supermarketu ATB. Vstupné dvere sú hneď naľavo.",
      "Vstup na kliniku: vojdite cez presklené dvere a vyjdite na 2. poschodie k recepcii.",
    ],
  },
  hu: {
    alt: [
      "Épületbejárat az ATB szupermarket táblája mellett",
      "ATB tájékozódási pont a bejárathoz vezető jelzésekkel",
    ],
    caption: [
      "Fő tájékozódási pont: az épület homlokzata közvetlenül az ATB szupermarket mellett.",
      "Klinika bejárata: lépjen be az üvegajtón, és menjen fel a 2. emeleti recepcióra.",
    ],
  },
} as const;

const imageCopy = localizedImageCopy[locale];
---

<div class="grid min-w-0 gap-8 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:items-stretch">
  {
    images.length > 0 ? (
      <div class="grid min-w-0 gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        {images.map((image, index) => (
          <figure class="group flex min-w-0 flex-col overflow-hidden rounded-2xl border border-border/80 bg-card shadow-md transition-all duration-300 hover:shadow-xl hover:border-primary/40">
            <div class="aspect-[3/4] w-full overflow-hidden bg-muted">
              <img
                class="size-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-105"
                src={image.src}
                width={image.width}
                height={image.height}
                alt={imageCopy.alt[index] ?? imageCopy.alt[0]}
                loading="lazy"
                decoding="async"
                sizes="(min-width: 1280px) 20vw, (min-width: 1024px) 40vw, (min-width: 640px) 48vw, 100vw"
              />
            </div>
            <figcaption class="flex flex-1 flex-col justify-center bg-card p-4 text-xs leading-relaxed text-muted-foreground border-t border-border/60">
              {imageCopy.caption[index] ?? imageCopy.caption[0]}
            </figcaption>
          </figure>
        ))}
      </div>
    ) : null
  }

  <!-- Список 4 кроків у вигляді стильних карток -->
  <div class="grid min-w-0 gap-4 sm:grid-cols-2">
    {
      steps.map((step, index) => (
        <div class="flex flex-col justify-between rounded-2xl border border-border/80 bg-card p-6 shadow-xs transition-all duration-300 hover:border-primary/40 hover:shadow-md">
          <div>
            <span class="inline-flex size-8 items-center justify-center rounded-full bg-primary/10 text-xs font-bold tabular-nums text-primary">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-4 font-serif text-xl font-medium leading-tight text-foreground">
              {t(locale, step.titleKey)}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              {t(locale, step.bodyKey)}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</div>
