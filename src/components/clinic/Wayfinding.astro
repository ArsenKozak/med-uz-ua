---
import { t, type Locale, type TranslationKey } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

interface WayfindingStep {
  readonly titleKey: TranslationKey;
  readonly bodyKey: TranslationKey;
}

const { locale } = Astro.props;
const steps: readonly WayfindingStep[] = [
  {
    titleKey: "wayfinding.atbTitle",
    bodyKey: "wayfinding.atbBody",
  },
  {
    titleKey: "wayfinding.entranceTitle",
    bodyKey: "wayfinding.entranceBody",
  },
  {
    titleKey: "wayfinding.floorTitle",
    bodyKey: "wayfinding.floorBody",
  },
  {
    titleKey: "wayfinding.clinicTitle",
    bodyKey: "wayfinding.clinicBody",
  },
];
---

<ol class="grid border-y border-border md:grid-cols-4">
  {
    steps.map((step, index) => (
      <li class="relative grid min-h-44 grid-cols-[3.25rem_1fr] border-b border-border py-7 last:border-b-0 md:min-h-56 md:grid-cols-1 md:border-b-0 md:border-r md:px-7 md:py-8 md:last:border-r-0 lg:min-h-60 lg:px-8">
        <span class="font-serif text-2xl tabular-nums text-primary/45 md:text-3xl">
          {String(index + 1).padStart(2, "0")}
        </span>
        <div class="md:self-end">
          <h3 class="text-xl font-medium leading-tight text-foreground">
            {t(locale, step.titleKey)}
          </h3>
          <p class="mt-3 max-w-xs text-sm leading-6 text-muted-foreground">
            {t(locale, step.bodyKey)}
          </p>
        </div>
      </li>
    ))
  }
</ol>
