---
import { defaultLocale,
    t,
  type Locale, localizePath } from "../../lib/i18n";
import { getActiveCartCatalogProducts } from "../../lib/cms";
import { clinicContact } from "../../lib/clinic";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const activeCartCatalog = await getActiveCartCatalogProducts();
const serializedCartCatalog = JSON.stringify(activeCartCatalog);
const initialCountLabel = t(locale, "cart.countMany").replace(
  "{count}",
  "0",
);

const copy = {
  uk: {
    eyebrow: "Оптична колекція",
    title: "Ваш кошик",
    emptyTitle: "Кошик поки порожній",
    emptyDescription: "Перегляньте наш каталог контактних лінз, розчинів та оправ.",
    continue: "Перейти до покупок",
    subtotal: "Загальна сума",
    clear: "Очистити",
    checkoutBtn: "Оформити замовлення",
    callOrder: "Замовити за телефоном",
    guarantee: "100% оригінальна оптика",
    delivery: "Самовивіз в Ужгороді / Доставка",
    removed: "{product} видалено з кошика.",
    quantity: "Кількість {product}: {count}.",
  },
  en: {
    eyebrow: "Optical Collection",
    title: "Shopping Cart",
    emptyTitle: "Your cart is empty",
    emptyDescription: "Explore our collection of lenses, care solutions, and eyewear.",
    continue: "Start shopping",
    subtotal: "Total amount",
    clear: "Clear cart",
    checkoutBtn: "Proceed to Checkout",
    callOrder: "Order by Phone",
    guarantee: "100% genuine products",
    delivery: "Clinic pickup / Express shipping",
    removed: "{product} removed from cart.",
    quantity: "Quantity for {product}: {count}.",
  },
  sk: {
    eyebrow: "Optická kolekcia",
    title: "Váš košík",
    emptyTitle: "Košík je prázdny",
    emptyDescription: "Pozrite si našu ponuku kontaktných šošoviek a okuliarov.",
    continue: "Pokračovať v nákupe",
    subtotal: "Celková suma",
    clear: "Vyprázdniť",
    checkoutBtn: "Dokončiť objednávku",
    callOrder: "Objednať telefonicky",
    guarantee: "100% originálna optika",
    delivery: "Odber v Užhorode / Kuriér",
    removed: "{product} bol odstránený z košíka.",
    quantity: "Množstvo pre {product}: {count}.",
  },
  hu: {
    eyebrow: "Optikai kollekció",
    title: "Bevásárlókosár",
    emptyTitle: "A kosara üres",
    emptyDescription: "Böngésszen kontaktlencséink és szemüvegkereteink között.",
    continue: "Vásárlás folytatása",
    subtotal: "Végösszeg",
    clear: "Kosár ürítése",
    checkoutBtn: "Megrendelés",
    callOrder: "Rendelés telefonon",
    guarantee: "100%-ban eredeti termékek",
    delivery: "Ungvári átvétel / Kiszállítás",
    removed: "A(z) {product} eltávolítva a kosárból.",
    quantity: "A(z) {product} mennyisége: {count}.",
  },
}[locale];
---

<cart-drawer
  data-locale={locale}
  data-cart-catalog={serializedCartCatalog}
  data-checkout-status-message={t(locale, "cart.checkoutStatus")}
  data-count-one-message={t(locale, "cart.countOne")}
  data-count-many-message={t(locale, "cart.countMany")}
  data-pending-confirmation-message={t(locale, "cart.pendingConfirmation")}
  data-unavailable-message={t(locale, "cart.unavailable")}
  data-unit-price-pending-message={t(locale, "cart.unitPricePending")}
  data-remove-message={t(locale, "cart.remove")}
  data-quantity-message={t(locale, "cart.quantity")}
  data-remove-product-message={t(locale, "a11y.removeProduct")}
  data-decrease-product-message={t(locale, "a11y.decreaseProduct")}
  data-increase-product-message={t(locale, "a11y.increaseProduct")}
  data-quantity-product-message={t(locale, "a11y.quantityProduct")}
  data-removed-confirmation-message={copy.removed}
  data-quantity-confirmation-message={copy.quantity}
>
  <dialog
    id="cart-dialog"
    class="cart-dialog bg-card text-card-foreground shadow-2xl"
    aria-labelledby="cart-dialog-title"
    aria-modal="true"
    data-cart-dialog
  >
    <div class="flex h-full min-h-full flex-col bg-background">
      <!-- Шапка кошика -->
      <header class="flex items-center justify-between gap-4 border-b border-border/80 bg-[#faf8f5] px-6 py-5">
        <div class="flex items-center gap-3">
          <div>
            <p class="text-[0.65rem] font-semibold uppercase tracking-[0.24em] text-accent">
              {copy.eyebrow}
            </p>
            <h2 id="cart-dialog-title" class="font-serif text-2xl font-medium tracking-tight text-foreground sm:text-3xl">
              {copy.title}
            </h2>
          </div>
          <span
            id="cart-header-badge"
            class="inline-flex size-7 items-center justify-center rounded-full bg-primary/10 text-xs font-bold text-primary"
            data-cart-header-badge
          >
            0
          </span>
        </div>

        <button
          class="focus-ring-primary inline-flex size-10 items-center justify-center rounded-full border border-border/80 text-lg text-foreground/70 transition-all hover:bg-muted hover:text-foreground hover:scale-105"
          type="button"
          aria-label={t(locale, "a11y.closeCart")}
          data-cart-close
        >
          <span aria-hidden="true">✕</span>
        </button>
      </header>

      <!-- Тіло списку товарів -->
      <div class="flex-1 overflow-y-auto px-6 py-6">
        <!-- Порожній кошик -->
        <div class="py-20 text-center" data-cart-empty>
          <div class="mx-auto flex size-20 items-center justify-center rounded-full bg-primary/5 text-primary/60 border border-primary/10">
            <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
            </svg>
          </div>
          <p class="mt-5 font-serif text-2xl font-medium text-foreground">{copy.emptyTitle}</p>
          <p class="mt-2 text-sm text-muted-foreground max-w-xs mx-auto">
            {copy.emptyDescription}
          </p>
          <a
            href={localizePath("/shop", locale)}
            class="focus-ring-primary mt-6 inline-flex min-h-12 items-center justify-center rounded-xl bg-primary px-7 text-sm font-semibold text-primary-foreground shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary/90 hover:shadow-lg active:translate-y-0"
            data-cart-close
          >
            {copy.continue}
          </a>
        </div>

        <!-- Список карток товарів -->
        <ul
          class="space-y-4"
          data-cart-items
          aria-label={t(locale, "a11y.cartItems")}
        ></ul>
        <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-cart-live></p>
      </div>

      <!-- Футер кошика із підсумками -->
      <footer class="cart-summary border-t border-border/80 bg-[#faf8f5] p-6 shadow-lg" data-cart-summary hidden>
        <div class="flex items-baseline justify-between gap-4">
          <div>
            <p class="text-xs uppercase tracking-[0.16em] text-muted-foreground">
              {copy.subtotal} · <span data-cart-summary-count>{initialCountLabel}</span>
            </p>
            <p class="mt-1 font-serif text-3xl font-semibold text-primary" data-cart-subtotal></p>
          </div>
          <button
            class="focus-ring-primary text-xs font-semibold text-muted-foreground/80 underline underline-offset-4 hover:text-red-700 transition-colors"
            type="button"
            data-cart-clear
          >
            {copy.clear}
          </button>
        </div>

        <p class="mt-2 text-xs text-muted-foreground" data-cart-pricing-note hidden>
          {t(locale, "cart.pendingPriceNote")}
        </p>

        <!-- Кнопки дій оформлення -->
        <div class="mt-5 space-y-2.5">
          <a
            href={clinicContact.phoneHref}
            class="focus-ring-primary inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-sm bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-sm transition-all duration-200 hover:bg-primary/90 active:scale-[0.99]"
            id="cart-checkout-action"
          >
            <span>{copy.checkoutBtn}</span>
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>

          <a
            href={clinicContact.phoneHref}
            class="inline-flex min-h-10 w-full items-center justify-center rounded-sm border border-border bg-card px-4 text-xs font-medium text-foreground hover:bg-muted transition-colors"
          >
            📞 {copy.callOrder}: {clinicContact.phoneDisplay}
          </a>
        </div>

        <!-- Гарантії довіри внизу -->
        <div class="mt-4 flex items-center justify-center gap-4 text-[0.68rem] font-medium text-muted-foreground border-t border-border/60 pt-3.5">
          <span class="flex items-center gap-1">🛡️ {copy.guarantee}</span>
          <span>•</span>
          <span class="flex items-center gap-1">📍 {copy.delivery}</span>
        </div>

        <div class="hidden" data-checkout-unavailable>
          <p class="text-xs text-muted-foreground" data-checkout-status>{t(locale, "cart.checkoutStatus")}</p>
        </div>
      </footer>
    </div>
  </dialog>
</cart-drawer>

<style>
  .cart-dialog {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(100%, 30rem);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--color-border, #e5e5e5);
  }

  .cart-dialog[open] {
    animation: cart-drawer-enter 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cart-summary {
    padding-bottom: calc(1.5rem + env(safe-area-inset-bottom));
  }

  .cart-dialog::backdrop {
    background: rgb(15 23 42 / 0.5);
    backdrop-filter: blur(4px);
  }

  @keyframes cart-drawer-enter {
    from {
      opacity: 0;
      transform: translateX(100%);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-dialog[open] {
      animation: none;
    }
  }
</style>

<script>
  import {
    $cart,
    clearCart,
    removeFromCart,
    setCartItemQuantity,
    type CartItem,
  } from "../../store/cart";
  import {
    createCartCatalogIndex,
    decodeCartCatalog,
    resolveCart,
    type CartCatalogProduct,
    type ResolvedCartLine,
  } from "../../lib/commerce/cart-catalog";
  import { trackViewCart } from "../../lib/analytics";
  import { formatMoneyMinor } from "../../lib/commerce/money";
  import { isLocale, type Locale } from "../../lib/i18n";

  interface CartMessages {
    readonly locale: Locale;
    readonly checkoutStatus: string;
    readonly countOne: string;
    readonly countMany: string;
    readonly pendingConfirmation: string;
    readonly unavailable: string;
    readonly unitPricePending: string;
    readonly remove: string;
    readonly quantity: string;
    readonly removeProduct: string;
    readonly decreaseProduct: string;
    readonly increaseProduct: string;
    readonly quantityProduct: string;
    readonly removedConfirmation: string;
    readonly quantityConfirmation: string;
  }

  function readCartMessages(element: HTMLElement): CartMessages | null {
    const locale = element.dataset.locale;
    const checkoutStatus = element.dataset.checkoutStatusMessage;
    const countOne = element.dataset.countOneMessage;
    const countMany = element.dataset.countManyMessage;
    const pendingConfirmation = element.dataset.pendingConfirmationMessage;
    const unavailable = element.dataset.unavailableMessage;
    const unitPricePending = element.dataset.unitPricePendingMessage;
    const remove = element.dataset.removeMessage;
    const quantity = element.dataset.quantityMessage;
    const removeProduct = element.dataset.removeProductMessage;
    const decreaseProduct = element.dataset.decreaseProductMessage;
    const increaseProduct = element.dataset.increaseProductMessage;
    const quantityProduct = element.dataset.quantityProductMessage;
    const removedConfirmation = element.dataset.removedConfirmationMessage;
    const quantityConfirmation = element.dataset.quantityConfirmationMessage;

    if (
      !isLocale(locale) ||
      checkoutStatus === undefined ||
      countOne === undefined ||
      countMany === undefined ||
      pendingConfirmation === undefined ||
      unavailable === undefined ||
      unitPricePending === undefined ||
      remove === undefined ||
      quantity === undefined ||
      removeProduct === undefined ||
      decreaseProduct === undefined ||
      increaseProduct === undefined ||
      quantityProduct === undefined ||
      removedConfirmation === undefined ||
      quantityConfirmation === undefined
    ) {
      return null;
    }

    return {
      locale,
      checkoutStatus,
      countOne,
      countMany,
      pendingConfirmation,
      unavailable,
      unitPricePending,
      remove,
      quantity,
      removeProduct,
      decreaseProduct,
      increaseProduct,
      quantityProduct,
      removedConfirmation,
      quantityConfirmation,
    };
  }

  function formatMessage(
    template: string,
    values: Readonly<Record<string, string | number>>,
  ): string {
    let message = template;
    for (const [key, value] of Object.entries(values)) {
      message = message.replaceAll(`{${key}}`, String(value));
    }
    return message;
  }

  class CartDrawerElement extends HTMLElement {
    #dialog: HTMLDialogElement | null = null;
    #itemsElement: HTMLUListElement | null = null;
    #emptyElement: HTMLElement | null = null;
    #summaryElement: HTMLElement | null = null;
    #countElement: HTMLElement | null = null;
    #subtotalElement: HTMLElement | null = null;
    #pricingNoteElement: HTMLElement | null = null;
    #badgeElement: HTMLElement | null = null;
    #liveElement: HTMLElement | null = null;
    #items: readonly CartItem[] = [];
    #catalog: ReadonlyMap<string, CartCatalogProduct> = new Map();
    #unsubscribers: Array<() => void> = [];
    #openingTrigger: HTMLButtonElement | null = null;
    #isConnected = false;
    #messages: CartMessages | null = null;

    connectedCallback(): void {
      if (this.#isConnected) return;

      const dialog = this.querySelector("[data-cart-dialog]");
      const itemsElement = this.querySelector("[data-cart-items]");
      const emptyElement = this.querySelector("[data-cart-empty]");
      const summaryElement = this.querySelector("[data-cart-summary]");
      const countElement = this.querySelector("[data-cart-summary-count]");
      const subtotalElement = this.querySelector("[data-cart-subtotal]");
      const pricingNoteElement = this.querySelector("[data-cart-pricing-note]");
      const badgeElement = this.querySelector("[data-cart-header-badge]");
      const liveElement = this.querySelector("[data-cart-live]");
      const messages = readCartMessages(this);

      if (
        !(dialog instanceof HTMLDialogElement) ||
        !(itemsElement instanceof HTMLUListElement) ||
        !(emptyElement instanceof HTMLElement) ||
        !(summaryElement instanceof HTMLElement) ||
        !(countElement instanceof HTMLElement) ||
        !(subtotalElement instanceof HTMLElement) ||
        !(pricingNoteElement instanceof HTMLElement) ||
        !(liveElement instanceof HTMLElement) ||
        messages === null
      ) {
        return;
      }

      this.#dialog = dialog;
      this.#itemsElement = itemsElement;
      this.#emptyElement = emptyElement;
      this.#summaryElement = summaryElement;
      this.#countElement = countElement;
      this.#subtotalElement = subtotalElement;
      this.#pricingNoteElement = pricingNoteElement;
      this.#badgeElement = badgeElement instanceof HTMLElement ? badgeElement : null;
      this.#liveElement = liveElement;
      this.#messages = messages;
      this.#catalog = createCartCatalogIndex(
        decodeCartCatalog(this.dataset.cartCatalog),
      );
      this.#isConnected = true;

      document.addEventListener("click", this.#handleDocumentClick);
      document.addEventListener("keydown", this.#handleDocumentKeydown);
      dialog.addEventListener("click", this.#handleDialogClick);
      dialog.addEventListener("cancel", this.#handleDialogCancel);
      dialog.addEventListener("close", this.#handleDialogClose);

      this.#unsubscribers = [
        $cart.subscribe((items) => {
          this.#items = items;
          this.#render();
        }),
      ];
    }

    disconnectedCallback(): void {
      document.removeEventListener("click", this.#handleDocumentClick);
      document.removeEventListener("keydown", this.#handleDocumentKeydown);
      this.#dialog?.removeEventListener("click", this.#handleDialogClick);
      this.#dialog?.removeEventListener("cancel", this.#handleDialogCancel);
      this.#dialog?.removeEventListener("close", this.#handleDialogClose);
      this.#unsubscribers.forEach((unsubscribe) => unsubscribe());
      this.#unsubscribers = [];
      this.#messages = null;
      this.#isConnected = false;
    }

    #handleDocumentClick = (event: MouseEvent): void => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest("[data-cart-trigger]");
      if (trigger instanceof HTMLButtonElement) {
        this.#open(trigger);
      }
    };

    #handleDialogClick = (event: MouseEvent): void => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target === this.#dialog || target.closest("[data-cart-close]")) {
        this.#close();
        return;
      }

      if (target.closest("[data-cart-clear]")) {
        clearCart();
      }
    };

    #handleDocumentKeydown = (event: KeyboardEvent): void => {
      if (event.key === "Escape" && this.#dialog?.open) {
        event.preventDefault();
        this.#close();
      }
    };

    #handleDialogCancel = (event: Event): void => {
      event.preventDefault();
      this.#close();
    };

    #handleDialogClose = (): void => {
      document.body.style.overflow = "";
      if (this.#openingTrigger?.isConnected) {
        this.#openingTrigger.focus();
      }
      this.#openingTrigger = null;
    };

    #open(trigger: HTMLButtonElement): void {
      if (this.#dialog === null || this.#dialog.open) return;
      this.#openingTrigger = trigger;
      document.body.style.overflow = "hidden";
      this.#dialog.showModal();

      const resolvedCart = resolveCart(this.#items, this.#catalog);
      trackViewCart({
        subtotalMinor: resolvedCart.subtotalMinor,
        currency: resolvedCart.currency,
        itemCount: resolvedCart.count,
      });
    }

    #close(): void {
      const dialog = this.#dialog;
      if (dialog?.open) {
        dialog.close();
      }
    }

    #render(): void {
      if (
        this.#itemsElement === null ||
        this.#emptyElement === null ||
        this.#summaryElement === null ||
        this.#countElement === null ||
        this.#subtotalElement === null ||
        this.#pricingNoteElement === null ||
        this.#messages === null
      ) {
        return;
      }

      const messages = this.#messages;
      const resolvedCart = resolveCart(this.#items, this.#catalog);
      this.#itemsElement.replaceChildren(
        ...resolvedCart.lines.map((item) =>
          this.#createCartLine(item, messages),
        ),
      );

      const isEmpty = resolvedCart.lines.length === 0;
      this.#emptyElement.hidden = !isEmpty;
      this.#itemsElement.hidden = isEmpty;
      this.#summaryElement.hidden = isEmpty;

      if (this.#badgeElement) {
        this.#badgeElement.textContent = String(resolvedCart.count);
      }

      if (isEmpty) return;

      this.#countElement.textContent = formatMessage(
        resolvedCart.count === 1 ? messages.countOne : messages.countMany,
        { count: resolvedCart.count },
      );

      this.#pricingNoteElement.hidden = !resolvedCart.hasPendingPricing;

      if (
        resolvedCart.hasUnavailableLines ||
        resolvedCart.subtotalMinor === null
      ) {
        this.#subtotalElement.textContent = messages.unavailable;
      } else if (resolvedCart.hasPendingPricing) {
        this.#subtotalElement.textContent = messages.pendingConfirmation;
      } else if (resolvedCart.currency !== null) {
        this.#subtotalElement.textContent = formatMoneyMinor(
          resolvedCart.subtotalMinor,
          resolvedCart.currency,
          messages.locale,
        );
      }
    }

    #createCartLine(
      item: ResolvedCartLine,
      messages: CartMessages,
    ): HTMLLIElement {
      const li = document.createElement("li");
      li.className =
        "group relative flex gap-4 rounded-xl border border-border/70 bg-card p-4 shadow-xs transition-all hover:border-accent/40";

      // 1. Мініатюра товару
      const imgContainer = document.createElement("div");
      imgContainer.className =
        "relative size-16 shrink-0 overflow-hidden rounded-lg border border-border/60 bg-white p-1.5 flex items-center justify-center";
      
      const img = document.createElement("img");
      img.src = item.image || "/images/artificial/macro-lens-hydration.jpg";
      img.alt = item.title;
      img.className = "max-h-full max-w-full object-contain";
      imgContainer.append(img);

      // 2. Деталі товару
      const body = document.createElement("div");
      body.className = "flex min-w-0 flex-1 flex-col justify-between";

      // Верхній рядок (назва + кнопка видалення)
      const topRow = document.createElement("div");
      topRow.className = "flex items-start justify-between gap-2";

      const titleLink = document.createElement("a");
      titleLink.href = `/shop/${item.productId}`;
      titleLink.className =
        "font-serif text-sm font-semibold leading-snug text-foreground hover:text-primary transition-colors line-clamp-2";
      titleLink.textContent = item.title;

      const removeBtn = document.createElement("button");
      removeBtn.type = "button";
      removeBtn.className =
        "p-1 text-muted-foreground/70 hover:text-red-700 transition-colors";
      removeBtn.innerHTML = `
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      `;
      removeBtn.setAttribute(
        "aria-label",
        formatMessage(messages.removeProduct, { product: item.title }),
      );
      removeBtn.addEventListener("click", () => {
        removeFromCart(item.productId);
      });

      topRow.append(titleLink, removeBtn);

      // Нижній рядок (контролери кількості + сума рядка)
      const bottomRow = document.createElement("div");
      bottomRow.className = "mt-3 flex items-center justify-between gap-3";

      // Сегментований перемикач кількості
      const qtyBox = document.createElement("div");
      qtyBox.className =
        "inline-flex items-center rounded-sm border border-border bg-background shadow-2xs";

      const decBtn = document.createElement("button");
      decBtn.type = "button";
      decBtn.className =
        "size-7 flex items-center justify-center text-xs font-bold text-foreground/70 hover:bg-muted transition-colors";
      decBtn.textContent = "−";
      decBtn.addEventListener("click", () => {
        setCartItemQuantity(item.productId, item.quantity - 1);
      });

      const qtySpan = document.createElement("span");
      qtySpan.className =
        "min-w-7 text-center font-serif text-xs font-semibold tabular-nums text-foreground";
      qtySpan.textContent = String(item.quantity);

      const incBtn = document.createElement("button");
      incBtn.type = "button";
      incBtn.className =
        "size-7 flex items-center justify-center text-xs font-bold text-foreground/70 hover:bg-muted transition-colors";
      incBtn.textContent = "+";
      incBtn.addEventListener("click", () => {
        setCartItemQuantity(item.productId, item.quantity + 1);
      });

      qtyBox.append(decBtn, qtySpan, incBtn);

      // Вартість рядка
      const priceText = document.createElement("p");
      priceText.className = "font-serif text-sm font-bold text-primary";
      const unitPriceFormatted = formatMoneyMinor(
        item.unitPriceMinor * item.quantity,
        item.currency,
        messages.locale,
      );
      priceText.textContent = unitPriceFormatted;

      bottomRow.append(qtyBox, priceText);
      body.append(topRow, bottomRow);

      li.append(imgContainer, body);
      return li;
    }
  }

  if (!customElements.get("cart-drawer")) {
    customElements.define("cart-drawer", CartDrawerElement);
  }
</script>
