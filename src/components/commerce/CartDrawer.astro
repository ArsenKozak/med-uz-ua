---
import {
  defaultLocale,
  t,
  type Locale,
} from "../../lib/i18n";
import { getActiveCartCatalogProducts } from "../../lib/cms";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const activeCartCatalog = await getActiveCartCatalogProducts();
const serializedCartCatalog = JSON.stringify(activeCartCatalog);
const initialCountLabel = t(locale, "cart.countMany").replace(
  "{count}",
  "0",
);
const changeCopy = {
  uk: {
    removed: "{product} видалено з кошика.",
    quantity: "Кількість {product}: {count}.",
  },
  en: {
    removed: "{product} removed from the cart.",
    quantity: "Quantity for {product}: {count}.",
  },
  sk: {
    removed: "Produkt {product} bol odstránený z košíka.",
    quantity: "Množstvo pre {product}: {count}.",
  },
  hu: {
    removed: "A(z) {product} eltávolítva a kosárból.",
    quantity: "A(z) {product} mennyisége: {count}.",
  },
} as const;
const localizedChangeCopy = changeCopy[locale];
---

<cart-drawer
  data-locale={locale}
  data-cart-catalog={serializedCartCatalog}
  data-checkout-status-message={t(locale, "cart.checkoutStatus")}
  data-count-one-message={t(locale, "cart.countOne")}
  data-count-many-message={t(locale, "cart.countMany")}
  data-pending-confirmation-message={t(locale, "cart.pendingConfirmation")}
  data-unavailable-message={t(locale, "cart.unavailable")}
  data-unit-price-pending-message={t(locale, "cart.unitPricePending")}
  data-remove-message={t(locale, "cart.remove")}
  data-quantity-message={t(locale, "cart.quantity")}
  data-remove-product-message={t(locale, "a11y.removeProduct")}
  data-decrease-product-message={t(locale, "a11y.decreaseProduct")}
  data-increase-product-message={t(locale, "a11y.increaseProduct")}
  data-quantity-product-message={t(locale, "a11y.quantityProduct")}
  data-removed-confirmation-message={localizedChangeCopy.removed}
  data-quantity-confirmation-message={localizedChangeCopy.quantity}
>
  <dialog
    id="cart-dialog"
    class="cart-dialog bg-card text-card-foreground"
    aria-labelledby="cart-dialog-title"
    aria-modal="true"
    data-cart-dialog
  >
    <div class="flex min-h-full flex-col">
      <header class="flex items-center justify-between gap-4 border-b border-border px-5 py-5 sm:px-7">
        <div>
          <p class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-primary">
            {t(locale, "cart.eyebrow")}
          </p>
          <h2 id="cart-dialog-title" class="mt-1 text-3xl font-medium tracking-tight">
            {t(locale, "cart.title")}
          </h2>
        </div>
        <button
          class="focus-ring-primary inline-flex size-11 items-center justify-center border border-border text-xl text-primary transition-colors hover:bg-muted"
          type="button"
          aria-label={t(locale, "a11y.closeCart")}
          data-cart-close
        >
          <span aria-hidden="true">×</span>
        </button>
      </header>

      <div class="flex-1 overflow-y-auto px-5 py-6 sm:px-7">
        <div class="py-16 text-center" data-cart-empty>
          <svg
            class="mx-auto h-16 w-16 text-primary/45"
            viewBox="0 0 64 64"
            fill="none"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M15 21h34l-3 29H18l-3-29Z" stroke="currentColor" stroke-width="1.5" />
            <path d="M23 25v-5a9 9 0 0 1 18 0v5" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <p class="mt-6 font-serif text-2xl">{t(locale, "cart.emptyTitle")}</p>
          <p class="mt-2 text-sm text-muted-foreground">
            {t(locale, "cart.emptyDescription")}
          </p>
          <button
            class="focus-ring-primary mt-7 min-h-11 text-sm font-semibold text-primary underline underline-offset-4"
            type="button"
            data-cart-close
          >
            {t(locale, "cart.continueBrowsing")}
          </button>
        </div>

        <ul
          class="divide-y divide-border"
          data-cart-items
          aria-label={t(locale, "a11y.cartItems")}
        ></ul>
        <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-cart-live></p>
      </div>

      <footer class="cart-summary border-t border-border bg-background px-5 pt-5 sm:px-7" data-cart-summary hidden>
        <div class="flex items-end justify-between gap-5">
          <div>
            <p class="text-xs uppercase tracking-[0.16em] text-muted-foreground">
              {t(locale, "cart.subtotal")} · <span data-cart-summary-count>{initialCountLabel}</span>
            </p>
            <p class="mt-2 font-serif text-2xl font-medium" data-cart-subtotal></p>
          </div>
          <button
            class="focus-ring-primary min-h-11 text-xs font-semibold text-muted-foreground underline underline-offset-4 hover:text-primary"
            type="button"
            data-cart-clear
          >
            {t(locale, "cart.clear")}
          </button>
        </div>

        <p class="mt-3 text-xs leading-5 text-muted-foreground" data-cart-pricing-note hidden>
          {t(locale, "cart.pendingPriceNote")}
        </p>

        <div class="mt-5 border border-border bg-muted px-5 py-4" data-checkout-unavailable>
          <p class="text-sm font-semibold text-primary">{t(locale, "cart.checkoutPending")}</p>
          <p class="mt-2 text-xs leading-5 text-muted-foreground" data-checkout-status>
            {t(locale, "cart.checkoutStatus")}
          </p>
        </div>
      </footer>
    </div>
  </dialog>
</cart-drawer>

<style>
  .cart-dialog {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(100%, 32rem);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    box-shadow: -20px 0 60px rgb(0 0 0 / 0.12);
  }

  .cart-dialog[open] {
    animation: cart-drawer-enter 220ms ease-out;
  }

  .cart-summary {
    padding-bottom: calc(1.25rem + env(safe-area-inset-bottom));
  }

  .cart-dialog::backdrop {
    background: rgb(6 44 48 / 0.46);
  }

  @keyframes cart-drawer-enter {
    from {
      opacity: 0;
      transform: translateX(2rem);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-dialog[open] {
      animation: none;
    }
  }
</style>

<script>
  import {
    $cart,
    clearCart,
    removeFromCart,
    setCartItemQuantity,
    type CartItem,
  } from "../../store/cart";
  import {
    createCartCatalogIndex,
    decodeCartCatalog,
    resolveCart,
    type CartCatalogProduct,
    type ResolvedCartLine,
  } from "../../lib/commerce/cart-catalog";
  import { trackViewCart } from "../../lib/analytics";
  import { formatMoneyMinor } from "../../lib/commerce/money";
  import { isLocale, type Locale } from "../../lib/i18n";

  const ITEM_BUTTON_CLASS =
    "focus-ring-primary inline-flex size-11 items-center justify-center border border-border text-sm font-semibold text-primary transition-colors hover:bg-muted";

  interface CartMessages {
    readonly locale: Locale;
    readonly checkoutStatus: string;
    readonly countOne: string;
    readonly countMany: string;
    readonly pendingConfirmation: string;
    readonly unavailable: string;
    readonly unitPricePending: string;
    readonly remove: string;
    readonly quantity: string;
    readonly removeProduct: string;
    readonly decreaseProduct: string;
    readonly increaseProduct: string;
    readonly quantityProduct: string;
    readonly removedConfirmation: string;
    readonly quantityConfirmation: string;
  }

  function readCartMessages(element: HTMLElement): CartMessages | null {
    const locale = element.dataset.locale;
    const checkoutStatus = element.dataset.checkoutStatusMessage;
    const countOne = element.dataset.countOneMessage;
    const countMany = element.dataset.countManyMessage;
    const pendingConfirmation = element.dataset.pendingConfirmationMessage;
    const unavailable = element.dataset.unavailableMessage;
    const unitPricePending = element.dataset.unitPricePendingMessage;
    const remove = element.dataset.removeMessage;
    const quantity = element.dataset.quantityMessage;
    const removeProduct = element.dataset.removeProductMessage;
    const decreaseProduct = element.dataset.decreaseProductMessage;
    const increaseProduct = element.dataset.increaseProductMessage;
    const quantityProduct = element.dataset.quantityProductMessage;
    const removedConfirmation = element.dataset.removedConfirmationMessage;
    const quantityConfirmation = element.dataset.quantityConfirmationMessage;

    if (
      !isLocale(locale) ||
      checkoutStatus === undefined ||
      countOne === undefined ||
      countMany === undefined ||
      pendingConfirmation === undefined ||
      unavailable === undefined ||
      unitPricePending === undefined ||
      remove === undefined ||
      quantity === undefined ||
      removeProduct === undefined ||
      decreaseProduct === undefined ||
      increaseProduct === undefined ||
      quantityProduct === undefined ||
      removedConfirmation === undefined ||
      quantityConfirmation === undefined
    ) {
      return null;
    }

    return {
      locale,
      checkoutStatus,
      countOne,
      countMany,
      pendingConfirmation,
      unavailable,
      unitPricePending,
      remove,
      quantity,
      removeProduct,
      decreaseProduct,
      increaseProduct,
      quantityProduct,
      removedConfirmation,
      quantityConfirmation,
    };
  }

  function formatMessage(
    template: string,
    values: Readonly<Record<string, string | number>>,
  ): string {
    let message = template;

    for (const [key, value] of Object.entries(values)) {
      message = message.replaceAll(`{${key}}`, String(value));
    }

    return message;
  }

  function createTextElement<K extends keyof HTMLElementTagNameMap>(
    tagName: K,
    text: string,
    className: string,
  ): HTMLElementTagNameMap[K] {
    const element = document.createElement(tagName);
    element.textContent = text;
    element.className = className;
    return element;
  }

  type CartLineAction = "decrement" | "increment" | "remove";

  interface PendingCartLineFocus {
    readonly productId: string;
    readonly action: CartLineAction;
  }

  function isCartLineAction(
    value: string | undefined,
  ): value is CartLineAction {
    return value === "decrement" || value === "increment" || value === "remove";
  }

  class CartDrawerElement extends HTMLElement {
    #dialog: HTMLDialogElement | null = null;
    #itemsElement: HTMLUListElement | null = null;
    #emptyElement: HTMLElement | null = null;
    #summaryElement: HTMLElement | null = null;
    #countElement: HTMLElement | null = null;
    #subtotalElement: HTMLElement | null = null;
    #pricingNoteElement: HTMLElement | null = null;
    #liveElement: HTMLElement | null = null;
    #items: readonly CartItem[] = [];
    #catalog: ReadonlyMap<string, CartCatalogProduct> = new Map();
    #unsubscribers: Array<() => void> = [];
    #openingTrigger: HTMLButtonElement | null = null;
    #previousBodyOverflow: string | null = null;
    #previousBodyPaddingRight: string | null = null;
    #pendingLineFocus: PendingCartLineFocus | null = null;
    #lineFocusRestoreScheduled = false;
    #isConnected = false;
    #messages: CartMessages | null = null;

    connectedCallback(): void {
      if (this.#isConnected) {
        return;
      }

      const dialog = this.querySelector("[data-cart-dialog]");
      const itemsElement = this.querySelector("[data-cart-items]");
      const emptyElement = this.querySelector("[data-cart-empty]");
      const summaryElement = this.querySelector("[data-cart-summary]");
      const countElement = this.querySelector("[data-cart-summary-count]");
      const subtotalElement = this.querySelector("[data-cart-subtotal]");
      const pricingNoteElement = this.querySelector("[data-cart-pricing-note]");
      const checkoutStatusElement = this.querySelector("[data-checkout-status]");
      const liveElement = this.querySelector("[data-cart-live]");
      const messages = readCartMessages(this);

      if (
        !(dialog instanceof HTMLDialogElement) ||
        !(itemsElement instanceof HTMLUListElement) ||
        !(emptyElement instanceof HTMLElement) ||
        !(summaryElement instanceof HTMLElement) ||
        !(countElement instanceof HTMLElement) ||
        !(subtotalElement instanceof HTMLElement) ||
        !(pricingNoteElement instanceof HTMLElement) ||
        !(checkoutStatusElement instanceof HTMLElement) ||
        !(liveElement instanceof HTMLElement) ||
        messages === null
      ) {
        return;
      }

      this.#dialog = dialog;
      this.#itemsElement = itemsElement;
      this.#emptyElement = emptyElement;
      this.#summaryElement = summaryElement;
      this.#countElement = countElement;
      this.#subtotalElement = subtotalElement;
      this.#pricingNoteElement = pricingNoteElement;
      this.#liveElement = liveElement;
      this.#messages = messages;
      this.#catalog = createCartCatalogIndex(
        decodeCartCatalog(this.dataset.cartCatalog),
      );
      this.#isConnected = true;

      document.addEventListener("click", this.#handleDocumentClick);
      document.addEventListener("keydown", this.#handleDocumentKeydown);
      dialog.addEventListener("click", this.#handleDialogClick);
      dialog.addEventListener("cancel", this.#handleDialogCancel);
      dialog.addEventListener("close", this.#handleDialogClose);

      this.#unsubscribers = [
        $cart.subscribe((items) => {
          this.#items = items;
          this.#render();
        }),
      ];
    }

    disconnectedCallback(): void {
      document.removeEventListener("click", this.#handleDocumentClick);
      document.removeEventListener("keydown", this.#handleDocumentKeydown);
      this.#dialog?.removeEventListener("click", this.#handleDialogClick);
      this.#dialog?.removeEventListener("cancel", this.#handleDialogCancel);
      this.#dialog?.removeEventListener("close", this.#handleDialogClose);
      this.#unsubscribers.forEach((unsubscribe) => unsubscribe());
      this.#unsubscribers = [];
      this.#unlockBodyScroll();
      this.#pendingLineFocus = null;
      this.#messages = null;
      this.#isConnected = false;
    }

    #handleDocumentClick = (event: MouseEvent): void => {
      const target = event.target;

      if (!(target instanceof Element)) {
        return;
      }

      const trigger = target.closest("[data-cart-trigger]");

      if (trigger instanceof HTMLButtonElement) {
        this.#open(trigger);
      }
    };

    #handleDialogClick = (event: MouseEvent): void => {
      const target = event.target;

      if (!(target instanceof Element)) {
        return;
      }

      if (target === this.#dialog || target.closest("[data-cart-close]")) {
        this.#close();
        return;
      }

      if (target.closest("[data-cart-clear]")) {
        clearCart();
        queueMicrotask(() => {
          if (!this.#dialog?.open) {
            return;
          }

          const closeButton = this.#dialog.querySelector("[data-cart-close]");
          if (closeButton instanceof HTMLButtonElement) {
            closeButton.focus();
          }
        });
        return;
      }

    };

    #handleDocumentKeydown = (event: KeyboardEvent): void => {
      if (event.key === "Escape" && this.#dialog?.open) {
        event.preventDefault();
        this.#close();
      }
    };

    #handleDialogCancel = (event: Event): void => {
      event.preventDefault();
      this.#close();
    };

    #handleDialogClose = (): void => {
      this.#unlockBodyScroll();
      this.#pendingLineFocus = null;

      if (this.#openingTrigger?.isConnected) {
        this.#openingTrigger.focus();
      }

      this.#openingTrigger = null;
    };

    #open(trigger: HTMLButtonElement): void {
      if (this.#dialog === null || this.#dialog.open) {
        return;
      }

      this.#openingTrigger = trigger;
      this.#lockBodyScroll();
      this.#dialog.showModal();

      const resolvedCart = resolveCart(this.#items, this.#catalog);
      trackViewCart({
        subtotalMinor: resolvedCart.subtotalMinor,
        currency: resolvedCart.currency,
        itemCount: resolvedCart.count,
      });

      const closeButton = this.#dialog.querySelector("[data-cart-close]");
      if (closeButton instanceof HTMLButtonElement) {
        queueMicrotask(() => closeButton.focus());
      }
    }

    #close(): void {
      const dialog = this.#dialog;
      if (dialog?.open) {
        if (
          window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
          dialog.dataset.closing === "true"
        ) {
          if (dialog.dataset.closing !== "true") dialog.close();
          return;
        }

        dialog.dataset.closing = "true";
        const animation = dialog.animate(
          [
            { opacity: 1, transform: "translateX(0)" },
            { opacity: 0, transform: "translateX(1.5rem)" },
          ],
          { duration: 160, easing: "ease-in" },
        );
        void animation.finished.finally(() => {
          delete dialog.dataset.closing;
          if (dialog.open) dialog.close();
        });
      }
    }

    #lockBodyScroll(): void {
      if (this.#previousBodyOverflow !== null) {
        return;
      }

      this.#previousBodyOverflow = document.body.style.overflow;
      this.#previousBodyPaddingRight = document.body.style.paddingRight;
      const scrollbarWidth = Math.max(
        0,
        window.innerWidth - document.documentElement.clientWidth,
      );
      if (scrollbarWidth > 0) {
        document.body.style.paddingRight = `${scrollbarWidth}px`;
      }
      document.body.style.overflow = "hidden";
    }

    #unlockBodyScroll(): void {
      if (this.#previousBodyOverflow === null) {
        return;
      }

      document.body.style.overflow = this.#previousBodyOverflow;
      document.body.style.paddingRight = this.#previousBodyPaddingRight ?? "";
      this.#previousBodyOverflow = null;
      this.#previousBodyPaddingRight = null;
    }

    #render(): void {
      if (
        this.#itemsElement === null ||
        this.#emptyElement === null ||
        this.#summaryElement === null ||
        this.#countElement === null ||
        this.#subtotalElement === null ||
        this.#pricingNoteElement === null ||
        this.#messages === null
      ) {
        return;
      }

      const activeElement = document.activeElement;
      if (
        activeElement instanceof HTMLButtonElement &&
        this.#itemsElement.contains(activeElement)
      ) {
        const productId = activeElement.dataset.cartProductId;
        const action = activeElement.dataset.cartLineAction;

        if (productId !== undefined && isCartLineAction(action)) {
          this.#pendingLineFocus = { productId, action };
        }
      }

      const messages = this.#messages;
      const resolvedCart = resolveCart(this.#items, this.#catalog);
      this.#itemsElement.replaceChildren(
        ...resolvedCart.lines.map((item) =>
          this.#createCartLine(item, messages),
        ),
      );

      const isEmpty = resolvedCart.lines.length === 0;
      this.#emptyElement.hidden = !isEmpty;
      this.#itemsElement.hidden = isEmpty;
      this.#summaryElement.hidden = isEmpty;

      if (isEmpty) {
        this.#scheduleLineFocusRestore();
        return;
      }

      this.#countElement.textContent = formatMessage(
        resolvedCart.count === 1 ? messages.countOne : messages.countMany,
        { count: resolvedCart.count },
      );

      this.#pricingNoteElement.hidden = !resolvedCart.hasPendingPricing;

      if (
        resolvedCart.hasUnavailableLines ||
        resolvedCart.subtotalMinor === null
      ) {
        this.#subtotalElement.textContent = messages.unavailable;
      } else if (resolvedCart.hasPendingPricing) {
        this.#subtotalElement.textContent = messages.pendingConfirmation;
      } else if (resolvedCart.currency !== null) {
        this.#subtotalElement.textContent = formatMoneyMinor(
          resolvedCart.subtotalMinor,
          resolvedCart.currency,
          messages.locale,
        );
      } else {
        this.#subtotalElement.textContent = messages.unavailable;
      }

      this.#scheduleLineFocusRestore();
    }

    #scheduleLineFocusRestore(): void {
      if (
        this.#pendingLineFocus === null ||
        this.#lineFocusRestoreScheduled
      ) {
        return;
      }

      this.#lineFocusRestoreScheduled = true;
      queueMicrotask(() => {
        this.#lineFocusRestoreScheduled = false;
        const pendingFocus = this.#pendingLineFocus;
        this.#pendingLineFocus = null;

        if (
          pendingFocus === null ||
          !this.#dialog?.open ||
          this.#itemsElement === null
        ) {
          return;
        }

        const actionButtons =
          this.#itemsElement.querySelectorAll<HTMLButtonElement>(
            "button[data-cart-line-action][data-cart-product-id]",
          );
        let fallbackButton: HTMLButtonElement | null = null;

        for (const button of actionButtons) {
          if (button.dataset.cartLineAction !== pendingFocus.action) {
            continue;
          }

          fallbackButton ??= button;

          if (button.dataset.cartProductId === pendingFocus.productId) {
            button.focus();
            return;
          }
        }

        const closeButton = this.#dialog.querySelector("[data-cart-close]");
        if (fallbackButton !== null) {
          fallbackButton.focus();
        } else if (closeButton instanceof HTMLButtonElement) {
          closeButton.focus();
        }
      });
    }

    #createCartLine(
      item: ResolvedCartLine,
      messages: CartMessages,
    ): HTMLLIElement {
      const listItem = document.createElement("li");
      listItem.className = "py-6 first:pt-0 last:pb-0";

      const headingRow = document.createElement("div");
      headingRow.className = "flex min-w-0 items-start justify-between gap-4";

      const headingGroup = document.createElement("div");
      headingGroup.className = "min-w-0";
      headingGroup.append(
        createTextElement(
          "h3",
          item.title,
          "break-words font-serif text-xl font-medium leading-snug",
        ),
      );

      const unitPrice =
        item.availability === "unavailable"
          ? messages.unavailable
          : item.verificationStatus === "pending-clinic-confirmation"
          ? messages.unitPricePending
          : formatMoneyMinor(
              item.unitPriceMinor,
              item.currency,
              messages.locale,
            );
      headingGroup.append(
        createTextElement(
          "p",
          unitPrice,
          "mt-2 text-xs leading-5 text-muted-foreground",
        ),
      );

      const removeButton = document.createElement("button");
      removeButton.type = "button";
      removeButton.className =
        "focus-ring-primary min-h-11 shrink-0 text-xs font-semibold text-muted-foreground underline underline-offset-4 hover:text-primary";
      removeButton.textContent = messages.remove;
      removeButton.setAttribute(
        "aria-label",
        formatMessage(messages.removeProduct, {
          product: item.title,
        }),
      );
      removeButton.dataset.cartProductId = item.productId;
      removeButton.dataset.cartLineAction = "remove";
      removeButton.addEventListener("click", () => {
        if (removeFromCart(item.productId)) {
          this.#announce(
            formatMessage(messages.removedConfirmation, {
              product: item.title,
            }),
          );
        }
      });

      headingRow.append(headingGroup, removeButton);

      if (item.availability === "unavailable") {
        const unavailableQuantity = createTextElement(
          "p",
          `${messages.quantity}: ${item.quantity}`,
          "mt-5 text-xs uppercase tracking-[0.14em] text-muted-foreground",
        );
        listItem.append(headingRow, unavailableQuantity);
        return listItem;
      }

      const quantityRow = document.createElement("div");
      quantityRow.className = "mt-5 flex items-center justify-between gap-4";
      quantityRow.append(
        createTextElement(
          "span",
          messages.quantity,
          "text-xs uppercase tracking-[0.14em] text-muted-foreground",
        ),
      );

      const controls = document.createElement("div");
      controls.className = "flex items-center";

      const decrementButton = document.createElement("button");
      decrementButton.type = "button";
      decrementButton.className = ITEM_BUTTON_CLASS;
      decrementButton.textContent = "−";
      decrementButton.setAttribute(
        "aria-label",
        formatMessage(messages.decreaseProduct, {
          product: item.title,
        }),
      );
      decrementButton.dataset.cartProductId = item.productId;
      decrementButton.dataset.cartLineAction = "decrement";
      decrementButton.addEventListener("click", () => {
        const nextQuantity = item.quantity - 1;
        if (setCartItemQuantity(item.productId, nextQuantity)) {
          this.#announce(
            nextQuantity > 0
              ? formatMessage(messages.quantityConfirmation, {
                  product: item.title,
                  count: nextQuantity,
                })
              : formatMessage(messages.removedConfirmation, {
                  product: item.title,
                }),
          );
        }
      });

      const quantity = createTextElement(
        "span",
        String(item.quantity),
        "inline-flex min-w-10 items-center justify-center px-2 text-sm font-semibold",
      );
      quantity.setAttribute(
        "aria-label",
        formatMessage(messages.quantityProduct, {
          count: item.quantity,
          product: item.title,
        }),
      );

      const incrementButton = document.createElement("button");
      incrementButton.type = "button";
      incrementButton.className = ITEM_BUTTON_CLASS;
      incrementButton.textContent = "+";
      incrementButton.setAttribute(
        "aria-label",
        formatMessage(messages.increaseProduct, {
          product: item.title,
        }),
      );
      incrementButton.dataset.cartProductId = item.productId;
      incrementButton.dataset.cartLineAction = "increment";
      incrementButton.addEventListener("click", () => {
        const nextQuantity = item.quantity + 1;
        if (setCartItemQuantity(item.productId, nextQuantity)) {
          this.#announce(
            formatMessage(messages.quantityConfirmation, {
              product: item.title,
              count: nextQuantity,
            }),
          );
        }
      });

      controls.append(decrementButton, quantity, incrementButton);
      quantityRow.append(controls);
      listItem.append(headingRow, quantityRow);

      return listItem;
    }

    #announce(message: string): void {
      if (this.#liveElement === null) return;
      this.#liveElement.textContent = "";
      queueMicrotask(() => {
        if (this.#liveElement !== null) this.#liveElement.textContent = message;
      });
    }
  }

  if (!customElements.get("cart-drawer")) {
    customElements.define("cart-drawer", CartDrawerElement);
  }
</script>
