---
import type {
  ProductCategory,
  ProductSummary,
} from "../../lib/cms";
import { formatMoneyMinor } from "../../lib/commerce/money";

interface Props {
  product: ProductSummary;
}

const { product } = Astro.props;

const categoryLabels: Record<ProductCategory, string> = {
  contacts: "Contact lenses",
  glasses: "Optical frames",
  care: "Lens care",
};

const isPending =
  product.verificationStatus === "pending-clinic-confirmation";
const formattedPrice = formatMoneyMinor(
  product.priceMinor,
  product.currency,
);
---

<article class="group flex h-full min-w-0 flex-col border border-border bg-card">
  <div
    class="flex aspect-[4/3] items-center justify-center overflow-hidden border-b border-border bg-muted/60 p-7 text-primary sm:p-9"
  >
    {
      product.category === "contacts" && (
        <svg
          class="h-full max-h-52 w-full max-w-72 transition-transform duration-500 motion-safe:group-hover:scale-[1.025]"
          viewBox="0 0 400 280"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="147" cy="140" r="68" stroke="currentColor" stroke-width="2" />
          <circle cx="253" cy="140" r="68" stroke="currentColor" stroke-width="2" />
          <circle cx="147" cy="140" r="43" stroke="currentColor" stroke-opacity="0.28" />
          <circle cx="253" cy="140" r="43" stroke="currentColor" stroke-opacity="0.28" />
          <path d="M200 54v172" stroke="currentColor" stroke-opacity="0.18" />
        </svg>
      )
    }

    {
      product.category === "glasses" && (
        <svg
          class="h-full max-h-52 w-full max-w-72 transition-transform duration-500 motion-safe:group-hover:scale-[1.025]"
          viewBox="0 0 400 280"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M53 125c8-23 31-36 66-36 42 0 68 19 70 56 1 34-24 57-62 57-43 0-68-28-74-77Zm294 0c-8-23-31-36-66-36-42 0-68 19-70 56-1 34 24 57 62 57 43 0 68-28 74-77Z"
            stroke="currentColor"
            stroke-width="2"
          />
          <path d="M188 133c8-8 16-12 24 0" stroke="currentColor" stroke-width="2" />
          <path d="M53 125 22 112M347 125l31-13" stroke="currentColor" stroke-linecap="round" />
          <path d="M81 118c12-11 29-16 51-14M319 118c-12-11-29-16-51-14" stroke="currentColor" stroke-opacity="0.22" />
        </svg>
      )
    }

    {
      product.category === "care" && (
        <svg
          class="h-full max-h-52 w-full max-w-72 transition-transform duration-500 motion-safe:group-hover:scale-[1.025]"
          viewBox="0 0 400 280"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M164 76h72v28l15 21v93a14 14 0 0 1-14 14h-74a14 14 0 0 1-14-14v-93l15-21V76Z"
            stroke="currentColor"
            stroke-width="2"
          />
          <path d="M174 76V50h52v26M150 137h100" stroke="currentColor" stroke-width="2" />
          <path d="M173 164h54M173 181h38" stroke="currentColor" stroke-opacity="0.26" />
          <circle cx="200" cy="140" r="106" stroke="currentColor" stroke-opacity="0.12" />
        </svg>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <p class="text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-primary">
      {categoryLabels[product.category]}
    </p>
    <h2 class="mt-4 break-words text-2xl font-medium leading-tight tracking-tight text-card-foreground">
      {product.title}
    </h2>
    <p class="mt-4 text-sm leading-6 text-muted-foreground">
      {product.description}
    </p>

    <div class="mt-auto pt-8">
      {
        isPending ? (
          <div class="border-l-2 border-accent pl-3">
            <p class="text-sm font-semibold text-foreground">Price pending</p>
            <p class="mt-1 text-xs leading-5 text-muted-foreground">
              Product data and pricing await clinic confirmation.
            </p>
          </div>
        ) : (
          <p class="font-serif text-2xl font-medium text-foreground">
            {formattedPrice}
          </p>
        )
      }

      <button
        class="focus-ring-primary mt-6 inline-flex min-h-12 w-full items-center justify-between border border-primary bg-primary px-5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
        type="button"
        aria-label={`Add ${product.title} to cart`}
        data-add-to-cart
        data-product-id={product.id}
        data-product-title={product.title}
        data-product-price-minor={String(product.priceMinor)}
        data-product-currency={product.currency}
        data-product-verification-status={product.verificationStatus}
      >
        <span>Add to cart</span>
        <span aria-hidden="true">＋</span>
      </button>
      <p
        class="mt-3 min-h-5 text-xs font-medium text-success"
        data-add-status
        role="status"
        aria-live="polite"
      ></p>
    </div>
  </div>
</article>

<script>
  import {
    addToCart,
    type AddToCartInput,
    type CartVerificationStatus,
  } from "../../store/cart";

  function isVerificationStatus(
    value: string | undefined,
  ): value is CartVerificationStatus {
    return value === "verified" || value === "pending-clinic-confirmation";
  }

  function readProduct(button: HTMLButtonElement): AddToCartInput | null {
    const id = button.dataset.productId;
    const title = button.dataset.productTitle;
    const priceMinorValue = button.dataset.productPriceMinor;
    const currency = button.dataset.productCurrency;
    const verificationStatus = button.dataset.productVerificationStatus;

    if (
      id === undefined ||
      title === undefined ||
      priceMinorValue === undefined ||
      currency === undefined ||
      !isVerificationStatus(verificationStatus)
    ) {
      return null;
    }

    const priceMinor = Number(priceMinorValue);

    if (
      !Number.isSafeInteger(priceMinor) ||
      priceMinor < 0 ||
      !/^[A-Z]{3}$/.test(currency)
    ) {
      return null;
    }

    return { id, title, priceMinor, currency, verificationStatus };
  }

  document.querySelectorAll("[data-add-to-cart]").forEach((element) => {
    if (
      !(element instanceof HTMLButtonElement) ||
      element.dataset.cartBound === "true"
    ) {
      return;
    }

    element.dataset.cartBound = "true";
    element.addEventListener("click", () => {
      const product = readProduct(element);

      if (product === null) {
        return;
      }

      addToCart(product);

      const card = element.closest("article");
      const status = card?.querySelector("[data-add-status]");

      if (status instanceof HTMLElement) {
        status.textContent = "";
        queueMicrotask(() => {
          status.textContent = `${product.title} added to your cart.`;
        });
      }
    });
  });
</script>
