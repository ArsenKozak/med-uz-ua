---
import type { ProductCategory, ProductSummary } from "../../lib/cms";
import { formatMoneyMinor } from "../../lib/commerce/money";
import { defaultLocale, localizePath, t, type Locale } from "../../lib/i18n";

interface Props {
  product: ProductSummary;
  locale?: Locale;
}

const { product, locale = defaultLocale } = Astro.props;

const categoryLabels: Record<ProductCategory, string> = {
  lenses: t(locale, "product.categories.lenses"),
  frames: t(locale, "product.categories.frames"),
  sunglasses: t(locale, "product.categories.sunglasses"),
  care: t(locale, "product.categories.care"),
};

const isPending = product.verificationStatus === "pending-clinic-confirmation";
const formattedPrice = formatMoneyMinor(product.priceMinor, product.currency, locale);
const addToCartLabel = t(locale, "a11y.addProduct").replace("{product}", product.title);
const imageKindLabel = t(
  locale,
  product.imageKind === "product" ? "product.imageProduct" : "product.imageEditorial"
);
const imageAlt = product.imageKind === "product" ? product.title : `${imageKindLabel} — ${categoryLabels[product.category]}`;
const productActionLabel = product.inStock ? t(locale, "actions.addToCart") : t(locale, "product.unavailable");
const productActionAriaLabel = product.inStock ? addToCartLabel : `${product.title} — ${productActionLabel}`;
const productDetailUrl = localizePath(`/shop/${product.id}`, locale);
---

<article class="group flex h-full min-w-0 flex-col rounded-lg border border-border bg-card shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-md">
  <!-- Клікабельне зображення -->
  <a
    href={productDetailUrl}
    class="relative aspect-[4/3] block overflow-hidden border-b border-border bg-white"
    aria-label={product.title}
  >
    <img
      class="size-full object-contain p-5 transition-transform duration-500 ease-out group-hover:scale-105"
      src={product.image}
      alt={imageAlt}
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
      data-product-image
    />
    {product.imageKind !== "product" && (
      <span class="absolute bottom-3 left-3 rounded bg-background/90 px-2.5 py-1 text-[0.625rem] font-semibold uppercase tracking-[0.12em] text-muted-foreground backdrop-blur-sm">
        {imageKindLabel}
      </span>
    )}
  </a>

  <!-- Текстовий блок -->
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <div class="flex items-center justify-between gap-2">
      <span class="text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-primary">
        {categoryLabels[product.category]}
      </span>
      <span class="text-[0.65rem] font-medium tracking-wider text-muted-foreground uppercase">
        {product.brand}
      </span>
    </div>

    <h2 class="mt-3 break-words font-serif text-xl font-medium leading-snug tracking-tight text-card-foreground sm:text-2xl">
      <a href={productDetailUrl} class="transition-colors hover:text-primary">
        {product.title}
      </a>
    </h2>

    <p class="mt-3 line-clamp-2 text-sm leading-6 text-muted-foreground">
      {product.description}
    </p>

    <!-- Ціна та кнопка швидкого додавання -->
    <div class="mt-auto pt-6">
      {
        isPending ? (
          <div class="border-l-2 border-accent pl-3">
            <p class="text-sm font-semibold text-foreground">{t(locale, "product.pricePending")}</p>
            <p class="mt-0.5 text-xs text-muted-foreground">{t(locale, "product.pendingDescription")}</p>
          </div>
        ) : (
          <p class="font-serif text-2xl font-medium text-foreground">
            {formattedPrice}
          </p>
        )
      }

      <button
        class="focus-ring-primary mt-5 inline-flex min-h-11 w-full items-center justify-between rounded-sm border border-primary bg-primary px-5 text-sm font-semibold text-primary-foreground transition-all hover:bg-primary/90 active:scale-[0.99] disabled:cursor-not-allowed disabled:border-border disabled:bg-muted disabled:text-muted-foreground"
        type="button"
        aria-label={productActionAriaLabel}
        data-add-to-cart={product.inStock ? "" : undefined}
        data-product-id={product.id}
        data-product-title={product.title}
        data-product-price-minor={String(product.priceMinor)}
        data-product-currency={product.currency}
        data-product-verification-status={product.verificationStatus}
        data-product-category={product.category}
        data-added-message={t(locale, "product.addedToCart")}
        disabled={!product.inStock}
      >
        <span>{productActionLabel}</span>
        {product.inStock && <span aria-hidden="true">＋</span>}
      </button>

      <p class="mt-2 min-h-4 text-xs font-medium text-success" data-add-status role="status" aria-live="polite"></p>
    </div>
  </div>
</article>
