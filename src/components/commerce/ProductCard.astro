---
import type {
  ProductCategory,
  ProductSummary,
} from "../../lib/cms";
import { formatMoneyMinor } from "../../lib/commerce/money";
import {
  defaultLocale,
  t,
  type Locale,
} from "../../lib/i18n";

interface Props {
  product: ProductSummary;
  locale?: Locale;
}

const { product, locale = defaultLocale } = Astro.props;

const categoryLabels: Record<ProductCategory, string> = {
  lenses: t(locale, "product.categories.lenses"),
  frames: t(locale, "product.categories.frames"),
  sunglasses: t(locale, "product.categories.sunglasses"),
  care: t(locale, "product.categories.care"),
};

const isPending =
  product.verificationStatus === "pending-clinic-confirmation";
const formattedPrice = formatMoneyMinor(
  product.priceMinor,
  product.currency,
  locale,
);
const addToCartLabel = t(locale, "a11y.addProduct").replace(
  "{product}",
  product.title,
);
const imageKindLabel = t(
  locale,
  product.imageKind === "product"
    ? "product.imageProduct"
    : "product.imageEditorial",
);
const imageAlt =
  product.imageKind === "product"
    ? product.title
    : `${imageKindLabel} — ${categoryLabels[product.category]}`;
const productActionLabel = product.inStock
  ? t(locale, "actions.addToCart")
  : t(locale, "product.unavailable");
const productActionAriaLabel = product.inStock
  ? addToCartLabel
  : `${product.title} — ${productActionLabel}`;
---

<article
  class="group flex h-full min-w-0 flex-col border border-border bg-card"
  data-pointer-depth={product.imageKind === "product" ? "" : undefined}
>
  <div
    class="relative aspect-[4/3] overflow-hidden border-b border-border bg-muted/60"
    data-soft-sharp={product.imageKind === "product" ? "" : undefined}
  >
    <img
      class:list={[
        "h-full w-full transition-transform duration-500 motion-safe:group-hover:scale-[1.025]",
        product.imageKind === "product"
          ? "object-contain p-5 sm:p-7"
          : "object-cover",
      ]}
      src={product.image}
      alt={imageAlt}
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
      fetchpriority="low"
    />
    <span
      class="absolute bottom-3 left-3 max-w-[calc(100%_-_1.5rem)] bg-background/95 px-2.5 py-1.5 text-[0.625rem] font-semibold uppercase tracking-[0.12em] text-muted-foreground"
    >
      {imageKindLabel}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <p class="text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-primary">
      {categoryLabels[product.category]}
    </p>
    <h2 class="mt-4 break-words text-2xl font-medium leading-tight tracking-tight text-card-foreground">
      {product.title}
    </h2>
    <p class="mt-4 text-sm leading-6 text-muted-foreground">
      {product.description}
    </p>

    <div class="mt-auto pt-8">
      {
        isPending ? (
          <div class="border-l-2 border-accent pl-3">
            <p class="text-sm font-semibold text-foreground">
              {t(locale, "product.pricePending")}
            </p>
            <p class="mt-1 text-xs leading-5 text-muted-foreground">
              {t(locale, "product.pendingDescription")}
            </p>
          </div>
        ) : (
          <p class="font-serif text-2xl font-medium text-foreground">
            {formattedPrice}
          </p>
        )
      }

      <button
        class="focus-ring-primary mt-6 inline-flex min-h-12 w-full items-center justify-between border border-primary bg-primary px-5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:border-border disabled:bg-muted disabled:text-muted-foreground"
        type="button"
        aria-label={productActionAriaLabel}
        data-add-to-cart={product.inStock ? "" : undefined}
        data-product-id={product.id}
        data-product-title={product.title}
        data-product-price-minor={String(product.priceMinor)}
        data-product-currency={product.currency}
        data-product-verification-status={product.verificationStatus}
        data-added-message={t(locale, "product.addedToCart")}
        disabled={!product.inStock}
      >
        <span>{productActionLabel}</span>
        {product.inStock && <span aria-hidden="true">＋</span>}
      </button>
      <p
        class="mt-3 min-h-5 text-xs font-medium text-success"
        data-add-status
        role="status"
        aria-live="polite"
      ></p>
    </div>
  </div>
</article>

<script>
  import {
    addToCart,
    type AddToCartInput,
    type CartVerificationStatus,
  } from "../../store/cart";

  function isVerificationStatus(
    value: string | undefined,
  ): value is CartVerificationStatus {
    return value === "verified" || value === "pending-clinic-confirmation";
  }

  function readProduct(button: HTMLButtonElement): AddToCartInput | null {
    const id = button.dataset.productId;
    const title = button.dataset.productTitle;
    const priceMinorValue = button.dataset.productPriceMinor;
    const currency = button.dataset.productCurrency;
    const verificationStatus = button.dataset.productVerificationStatus;

    if (
      id === undefined ||
      title === undefined ||
      priceMinorValue === undefined ||
      currency === undefined ||
      !isVerificationStatus(verificationStatus)
    ) {
      return null;
    }

    const priceMinor = Number(priceMinorValue);

    if (
      !Number.isSafeInteger(priceMinor) ||
      priceMinor < 0 ||
      !/^[A-Z]{3}$/.test(currency)
    ) {
      return null;
    }

    return { id, title, priceMinor, currency, verificationStatus };
  }

  document.querySelectorAll("[data-add-to-cart]").forEach((element) => {
    if (
      !(element instanceof HTMLButtonElement) ||
      element.dataset.cartBound === "true"
    ) {
      return;
    }

    element.dataset.cartBound = "true";
    element.addEventListener("click", () => {
      const product = readProduct(element);
      const addedMessage = element.dataset.addedMessage;

      if (product === null || addedMessage === undefined) {
        return;
      }

      addToCart(product);

      const card = element.closest("article");
      const status = card?.querySelector("[data-add-status]");

      if (status instanceof HTMLElement) {
        status.textContent = "";
        queueMicrotask(() => {
          status.textContent = addedMessage.replace(
            "{product}",
            product.title,
          );
        });
      }
    });
  });
</script>
