---
import "../styles/global.css";
import CartDrawer from "../components/commerce/CartDrawer.astro";
import MobileActionBar from "../components/clinic/MobileActionBar.astro";
import SiteFooter from "../components/clinic/SiteFooter.astro";
import SiteHeader from "../components/clinic/SiteHeader.astro";
import InteractionController from "../components/ui/InteractionController.astro";
import AnalyticsConsent from "../components/analytics/AnalyticsConsent.astro";
import {
  localeFromPath,
  locales,
  localizePath,
  stripLocalePrefix,
  t,
  type Locale,
} from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  canonical?: string | URL;
  locale?: Locale;
  robots?: string;
}

const {
  title,
  description,
  canonical,
  locale: localeProp,
  robots = "index, follow",
} = Astro.props;
const locale = localeProp ?? localeFromPath(Astro.url.pathname);
const canonicalUrl = new URL(
  canonical ?? Astro.url.pathname,
  Astro.site ?? Astro.url,
).toString();
const canonicalRoutePath = stripLocalePrefix(Astro.url.pathname);
const alternateLocaleUrls = locales.map((alternateLocale) => ({
  locale: alternateLocale,
  url: new URL(
    localizePath(canonicalRoutePath, alternateLocale),
    Astro.site ?? Astro.url,
  ).toString(),
}));
const defaultLocaleUrl = new URL(
  localizePath(canonicalRoutePath, "uk"),
  Astro.site ?? Astro.url,
).toString();
---

<!doctype html>
<html lang={locale}>
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <title>{title}</title>

    <slot name="canonical">
      <link rel="canonical" href={canonicalUrl} />
    </slot>
    {
      alternateLocaleUrls.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.locale}
          href={alternate.url}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <a
      class="fixed left-5 top-4 z-50 -translate-y-24 rounded-md bg-card px-4 py-3 text-sm font-semibold text-primary shadow-concierge transition-transform focus:translate-y-0"
      href="#main-content"
    >
      {t(locale, "a11y.skipToContent")}
    </a>
    <SiteHeader locale={locale} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <MobileActionBar locale={locale} />
    <CartDrawer locale={locale} />
    <AnalyticsConsent locale={locale} />
    <InteractionController />
  </body>
</html>
