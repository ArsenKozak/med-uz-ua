---
import "../styles/global.css";
import CartDrawer from "../components/commerce/CartDrawer.astro";
import SiteFooter from "../components/clinic/SiteFooter.astro";
import SiteHeader from "../components/clinic/SiteHeader.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string | URL;
  lang?: string;
}

const { title, description, canonical, lang = "en" } = Astro.props;
const canonicalUrl = new URL(
  canonical ?? Astro.url.pathname,
  Astro.site ?? Astro.url,
).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>

    <slot name="canonical">
      <link rel="canonical" href={canonicalUrl} />
    </slot>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <a
      class="fixed left-5 top-4 z-50 -translate-y-24 rounded-md bg-card px-4 py-3 text-sm font-semibold text-primary shadow-concierge transition-transform focus:translate-y-0"
      href="#main-content"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <CartDrawer />
  </body>
</html>
